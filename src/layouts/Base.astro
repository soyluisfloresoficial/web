---
import { getImage } from "astro:assets";
import { SITIO, AREA_SERVIDA, servicios } from "../data/servicios";
import retratoImg from "../assets/luis-flores-retrato.jpg";
import JsonLd from "../components/JsonLd.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Chat from "../components/Chat.astro";
import BarraMovil from "../components/BarraMovil.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Ruta absoluta de la imagen OG de esta página. Si falta, la de por defecto. */
  ogImage?: string;
  ogImageAlt?: string;
  /** "website" o "article". */
  ogType?: "website" | "article";
  /** Solo en artículos. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Nodos de schema propios de la página, que se suman al grafo base. */
  schema?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-default.png",
  ogImageAlt = "Luis Flores · IA aplicada a negocios reales",
  ogType = "website",
  publishedTime,
  modifiedTime,
  schema = [],
  noindex = false,
} = Astro.props;

// trailingSlash: "never". La raíz es la excepción y conserva su barra.
const ruta = Astro.url.pathname.replace(/\/+$/, "");
const canonical = `${SITIO.url}${ruta === "" ? "/" : ruta}`;
const ogImageAbs = new URL(ogImage, SITIO.url).href;

// Retrato para Person.image. Sale del mismo original que /sobre-mi.
const retrato = await getImage({ src: retratoImg, width: 640, format: "jpg" });
const retratoAbs = new URL(retrato.src, SITIO.url).href;

const grafoBase = [
  {
    "@type": "Person",
    "@id": `${SITIO.url}/#person`,
    name: SITIO.nombreCompleto,
    alternateName: SITIO.nombre,
    description: SITIO.descripcion,
    image: retratoAbs,
    url: `${SITIO.url}/`,
    email: `mailto:${SITIO.email}`,
    jobTitle: "Implementador de IA y automatización para negocios",
    address: {
      "@type": "PostalAddress",
      addressLocality: SITIO.localidad,
      addressRegion: SITIO.region,
      addressCountry: SITIO.pais,
    },
    knowsAbout: ["Inteligencia artificial aplicada a negocios", ...servicios.map((s) => s.nombre)],
    sameAs: SITIO.perfiles,
    worksFor: { "@id": `${SITIO.url}/#organization` },
  },
  {
    "@type": "Organization",
    "@id": `${SITIO.url}/#organization`,
    name: SITIO.nombre,
    url: `${SITIO.url}/`,
    description:
      "Implementación de agentes de IA, automatizaciones y embudos de venta para pymes y emprendedores de Latinoamérica y España.",
    // Google pide un logo de al menos 112 × 112 px. El logotipo con el nombre
    // es apaisado y no llega en altura; el monograma de 180 × 180 sí.
    logo: {
      "@type": "ImageObject",
      url: `${SITIO.url}/apple-touch-icon.png`,
      width: 180,
      height: 180,
    },
    email: `mailto:${SITIO.email}`,
    founder: { "@id": `${SITIO.url}/#person` },
    address: {
      "@type": "PostalAddress",
      addressLocality: SITIO.localidad,
      addressRegion: SITIO.region,
      addressCountry: SITIO.pais,
    },
    knowsAbout: servicios.map((s) => s.nombre),
    areaServed: AREA_SERVIDA,
    sameAs: SITIO.perfiles,
  },
  {
    "@type": "WebSite",
    "@id": `${SITIO.url}/#website`,
    url: `${SITIO.url}/`,
    name: SITIO.nombre,
    inLanguage: "es",
    publisher: { "@id": `${SITIO.url}/#person` },
  },
];

const grafo = {
  "@context": "https://schema.org",
  "@graph": [...grafoBase, ...schema],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090d" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/manrope-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />

    {/* Español neutro para Latinoamérica, con España como variante. */}
    <meta property="og:locale" content="es_LA" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    {ogType === "article" && <meta property="article:author" content={SITIO.nombreCompleto} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <JsonLd data={grafo} />

    {/*
      Sin ClientRouter. Navegaba sin recargar la página, y eso rompía dos
      cosas: GTM solo contaba la primera página vista (las demás no generan
      una carga nueva), y los scripts que enganchan eventos al cargar, como el
      menú móvil, dejaban de funcionar tras la primera navegación porque la
      cabecera se reemplazaba sin volver a ejecutarlos.
      El efecto de transición entre páginas lo hace ahora el CSS
      (@view-transition en global.css) con recargas normales.
    */}

    {/* Marca que hay JavaScript ANTES de pintar: sin esta clase, las reglas
        de aparición no se aplican y el contenido se ve igual. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    {/* Degradado de los iconos de trazo (Icono.astro con degradado). Una sola
        definición por página. */}
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <linearGradient id="lf-grad-stroke" gradientUnits="userSpaceOnUse" x1="2" y1="2" x2="22" y2="22">
          <stop offset="0" stop-color="#0a84ff" />
          <stop offset="1" stop-color="#8b5cf6" />
        </linearGradient>
      </defs>
    </svg>
    <Header />
    <div id="contenido">
      <slot />
    </div>
    <Footer />
    <BarraMovil />
    <Chat />
    <CookieBanner />
  </body>

  <script>
    // Aparición al entrar en vista. Una sola vez por elemento, y el observador
    // se desconecta al terminar. Si IntersectionObserver no existe, se marcan
    // todos como visibles: nunca se queda nada oculto.
    function activarReveals() {
      const elementos = document.querySelectorAll<HTMLElement>(".reveal, .subrayado");
      if (!elementos.length) return;

      if (!("IntersectionObserver" in window)) {
        elementos.forEach((el) => el.classList.add("is-visible"));
        return;
      }

      // Escalonado: el índice dentro del grupo de hermanos, máximo 5.
      const grupos = new Map<Element, number>();
      elementos.forEach((el) => {
        if (!el.classList.contains("reveal")) return;
        const padre = el.parentElement;
        if (!padre) return;
        const n = grupos.get(padre) ?? 0;
        if (n > 0 && n <= 5) el.dataset.i = String(n);
        grupos.set(padre, n + 1);
      });

      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            entrada.target.classList.add("is-visible");
            observador.unobserve(entrada.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );

      elementos.forEach((el) => observador.observe(el));
    }

    activarReveals();

    // Las cifras (73 %, 12 h, 40 %) cuentan desde cero al entrar en vista.
    // El texto final ya está en el HTML: sin JavaScript o con movimiento
    // reducido se ve tal cual. El número se anima en un span aparte con
    // aria-hidden, y el valor final queda para los lectores de pantalla.
    function activarContadores() {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (!("IntersectionObserver" in window)) return;
      const cifras = document.querySelectorAll<HTMLElement>(".cifra");
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            obs.unobserve(e.target);
            contar(e.target as HTMLElement);
          }
        },
        { threshold: 0.6 },
      );
      cifras.forEach((c) => obs.observe(c));
    }

    function contar(el: HTMLElement) {
      const paseo = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      let nodo: Text | null = null;
      while (paseo.nextNode()) {
        const n = paseo.currentNode as Text;
        if (/\d/.test(n.data)) {
          nodo = n;
          break;
        }
      }
      if (!nodo) return;
      const m = nodo.data.match(/^(\D*)(\d+)(.*)$/s);
      if (!m) return;
      const [, antes, num, despues] = m;
      const final = Number(num);
      const visible = document.createElement("span");
      visible.setAttribute("aria-hidden", "true");
      const lector = document.createElement("span");
      lector.className = "sr-only";
      lector.textContent = nodo.data;
      nodo.replaceWith(visible, lector);
      const inicio = performance.now();
      const duracion = 1100;
      const paso = (t: number) => {
        const p = Math.min((t - inicio) / duracion, 1);
        const suave = 1 - Math.pow(1 - p, 3);
        visible.textContent = antes + Math.round(final * suave) + despues;
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }

    activarContadores();
  </script>
</html>
