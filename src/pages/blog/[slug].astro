---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { servicios, SITIO } from "../../data/servicios";
import retratoImg from "../../assets/luis-flores-sobre-mi.png";
import TarjetaArticulo from "../../components/TarjetaArticulo.astro";
import IlustracionServicio from "../../components/IlustracionServicio.astro";
import { ilustraciones } from "../../data/ilustraciones";
import Cierre from "../../components/Cierre.astro";
import CapturaGuia from "../../components/CapturaGuia.astro";
import { guiaDeServicio } from "../../data/guias";
import Icono from "../../components/Icono.astro";
import { minutosLectura, palabras } from "../../data/lectura";
import { imagenOg } from "../../data/og";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Índice del artículo (09/11/2026): los apartados H2, solo si hay al menos tres.
const indice = headings.filter((h) => h.depth === 2);
const conIndice = indice.length >= 3;

const publicado = post.data.datePublished;
const modificado = post.data.dateModified ?? publicado;
const url = `${SITIO.url}/blog/${post.id}`;

const servicio = servicios.find((s) => s.slug === post.data.servicio);

// Dos posts relacionados: primero los del mismo servicio.
const todos = await getCollection("blog");
const relacionados = todos
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const mismoA = a.data.servicio === post.data.servicio ? 0 : 1;
    const mismoB = b.data.servicio === post.data.servicio ? 0 : 1;
    if (mismoA !== mismoB) return mismoA - mismoB;
    return b.data.datePublished.getTime() - a.data.datePublished.getTime();
  })
  .slice(0, 3);

const minutos = minutosLectura(post.body);

const fechaLarga = (d: Date) =>
  d.toLocaleDateString("es", { day: "numeric", month: "long", year: "numeric" });

const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    headline: post.data.title,
    description: post.data.description,
    ...(post.data.resumen && { abstract: post.data.resumen.join(" ") }),
    // Con medidas: Google pide al menos 1200 px de ancho para mostrar la
    // imagen del artículo en los resultados enriquecidos.
    image: {
      "@type": "ImageObject",
      url: `${SITIO.url}${imagenOg(`/blog/${post.id}`)}`,
      width: 1200,
      height: 630,
    },
    datePublished: publicado.toISOString(),
    dateModified: modificado.toISOString(),
    author: { "@id": `${SITIO.url}/#person` },
    publisher: { "@id": `${SITIO.url}/#organization` },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    isPartOf: { "@id": `${SITIO.url}/blog#blog` },
    wordCount: palabras(post.body),
    timeRequired: `PT${minutos}M`,
    ...(servicio && {
      articleSection: servicio.nombre,
      about: { "@id": `${SITIO.url}/servicios/${servicio.slug}#service` },
    }),
    inLanguage: "es",
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITIO.url}/blog` },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Base
  title={post.data.metaTitle}
  description={post.data.description}
  ogType="article"
  publishedTime={publicado}
  modifiedTime={modificado}
  schema={schema}
>
  {/* Indicador de progreso. Decorativo: no aporta información que no esté
      ya en la barra de desplazamiento del navegador. */}
  <div class="progreso-lectura" aria-hidden="true"></div>

  <main>
    <nav class="migas container-lf" aria-label="Migas de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/blog">Blog</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <article class="container-lf articulo" style={servicio ? `--svc: var(${servicio.color})` : undefined}>
      <header class="articulo-cabecera">
        {
          servicio && (
            <a class="etiqueta-servicio" href={`/servicios/${servicio.slug}`}>
              {servicio.nombre}
            </a>
          )
        }
        <h1 class="mt-5">{post.data.title}</h1>
        <p class="entradilla-articulo mt-5">{post.data.description}</p>
        <div class="firma mt-8">
          <Image
            src={retratoImg}
            alt=""
            aria-hidden="true"
            widths={[56, 112]}
            sizes="56px"
            loading="eager"
            class="firma-foto"
          />
          <p class="meta">
            <span class="firma-nombre">{SITIO.nombreCompleto}</span>
            <span>
              <time datetime={publicado.toISOString()}>{fechaLarga(publicado)}</time>
              {" · "}
              {minutos} min de lectura
          {
            modificado.getTime() !== publicado.getTime() && (
              <>
                {" · "}
                <span>
                  Actualizado:{" "}
                  <time datetime={modificado.toISOString()}>{fechaLarga(modificado)}</time>
                </span>
              </>
            )
          }
            </span>
          </p>
        </div>
      </header>

      {/* Portada: la ilustración del servicio del artículo, en su color.
          Es decorativa (el título ya dice de qué va), así que no se anuncia. */}
      {
        servicio && ilustraciones[servicio.slug] && (
          <figure class="articulo-portada">
            <IlustracionServicio slug={servicio.slug} color={servicio.color} alt="" variante="portada" decorativa />
          </figure>
        )
      }

      {
        post.data.resumen && (
          <aside class="resumen-rapido" aria-labelledby="resumen-titulo">
            <p id="resumen-titulo" class="resumen-titulo">En 30 segundos</p>
            <ul>
              {post.data.resumen.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </aside>
        )
      }

      {/* Índice (09/11/2026): plegable en celular y tableta; en pantallas
          anchas va al lado del texto y sigue al bajar, marcando el apartado
          que se está leyendo. */}
      {
        conIndice && (
          <details class="indice-movil">
            <summary>En este artículo</summary>
            <nav aria-label="Índice del artículo">
              <ol>
                {indice.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-indice-enlace={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }

      <div class="cuerpo-articulo">
        {
          conIndice && (
            <aside class="indice-lateral" aria-label="Índice del artículo">
              <nav>
                <p class="indice-titulo">En este artículo</p>
                <ol>
                  {indice.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} data-indice-enlace={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
        <div class="prosa">
          <Content />
        </div>
      </div>

      {
        servicio && (
          <aside class="servicio-rel card" style={`--svc: var(${servicio.color})`}>
            <span class="servicio-rel-icono" aria-hidden="true">
              <Icono nombre={servicio.icono} tamano={22} grosor={1.7} />
            </span>
            <p class="eyebrow">Servicio relacionado</p>
            <h2 class="mt-2">{servicio.nombre}</h2>
            <p class="card-text mt-2">{servicio.definicion}</p>
            <div class="servicio-rel-acciones mt-4">
              {/* Al funnel del servicio, con la campaña marcada (FUNNELS.md). */}
              <a
                class="cta"
                href={`/diagnostico/${servicio.slug}?utm_source=blog&utm_medium=articulo&utm_campaign=${post.id}`}
              >
                Hablemos de tu caso <span aria-hidden="true">→</span>
              </a>
              <a class="card-link" href={`/servicios/${servicio.slug}`}>
                Ver el servicio <span aria-hidden="true">→</span>
              </a>
            </div>
          </aside>
        )
      }

      <aside class="autor card">
        <Image
          src={retratoImg}
          alt="Retrato de Luis Carlos Flores"
          widths={[96, 192]}
          sizes="96px"
          loading="lazy"
          class="autor-foto"
        />
        <div>
          <p class="autor-nombre">{SITIO.nombreCompleto}</p>
          <p class="card-text">
            Dirijo una agencia con base en Manresa, España, y diseño e implemento
            sistemas de IA, automatización y captación de clientes para negocios de
            Latinoamérica y España.
          </p>
          <a class="card-link mt-2 inline-block" href="/sobre-mi">
            Sobre mí <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </article>

    {/* Guía gratis: quien termina de leer ya mostró interés (EMAIL-MARKETING.md). */}
    <CapturaGuia ubicacion="blog-articulo" guia={guiaDeServicio(post.data.servicio).slug} />

    {
      relacionados.length > 0 && (
        <section class="section banda" aria-labelledby="rel-titulo">
          <div class="container-lf">
            <div class="cabecera-seccion">
              <div>
                <p class="eyebrow">Sigue leyendo</p>
                <h2 id="rel-titulo" class="subrayado mt-4">Más guías como esta</h2>
              </div>
              <a class="card-link cabecera-enlace" href="/blog">
                Ver todas <span aria-hidden="true">→</span>
              </a>
            </div>
            <ul class="rejilla-relacionados mt-10">
              {relacionados.map((p) => (
                <li class="reveal">
                  <TarjetaArticulo post={p} nivel="h3" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <Cierre
      titulo="¿Lo aplicamos a tu negocio?"
      entradilla="En 30 minutos revisamos tu caso y te digo qué haría primero. Es gratis."
    />
  </main>
</Base>

<script>
  // Índice lateral: marca el apartado que se está leyendo (aria-current).
  // Sin JavaScript el índice funciona igual, solo sin la marca.
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>(".indice-lateral [data-indice-enlace]")];
  const titulos = enlaces
    .map((a) => document.getElementById(a.dataset.indiceEnlace ?? ""))
    .filter((t): t is HTMLElement => Boolean(t));
  if (titulos.length && "IntersectionObserver" in window) {
    const marcar = (id: string) => {
      for (const a of enlaces) {
        if (a.dataset.indiceEnlace === id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };
    const visibles = new Set<string>();
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) visibles.add(e.target.id);
          else visibles.delete(e.target.id);
        }
        // El primero visible; si no hay ninguno, el último que quedó arriba.
        const actual =
          titulos.find((t) => visibles.has(t.id)) ??
          [...titulos].reverse().find((t) => t.getBoundingClientRect().top < 0);
        if (actual) marcar(actual.id);
      },
      { rootMargin: "-80px 0px -55% 0px" },
    );
    titulos.forEach((t) => observador.observe(t));
  }
</script>

<style>
  .migas {
    padding-block: 1rem;
    font-size: var(--step--1);
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
  }
  .migas li + li::before {
    content: "/";
    margin-inline-end: 0.5rem;
    color: var(--color-line);
  }
  .migas a {
    text-decoration: none;
    color: var(--color-soft);
  }

  .articulo {
    max-width: 72ch;
    padding-block: var(--space-2) var(--space-section);
  }
  .articulo-cabecera {
    padding-bottom: 2.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .articulo-portada {
    margin: 0 0 2.5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    box-shadow: var(--shadow-2);
  }
  .articulo-cabecera h1 {
    font-size: clamp(2.125rem, 1.6rem + 2.2vw, 3.25rem);
    line-height: 1.08;
  }
  .entradilla-articulo {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--color-soft);
  }
  .firma {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .firma-foto {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid var(--color-line);
  }
  .firma .meta {
    display: grid;
    margin-top: 0;
  }
  .firma-nombre {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  .servicio-rel h2 {
    font-size: var(--step-2);
  }
  .servicio-rel {
    position: relative;
    padding-left: 5rem !important;
  }
  .servicio-rel-icono {
    position: absolute;
    left: 1.5rem;
    top: 1.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--svc) 45%, var(--color-line));
    border-radius: 12px;
    background: color-mix(in srgb, var(--svc) 10%, transparent);
    color: var(--svc);
  }
  .servicio-rel-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .rejilla-relacionados {
    display: grid;
    gap: 1.5rem;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .rejilla-relacionados {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 1100px) {
    .rejilla-relacionados {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--step--1);
    margin-top: 0.75rem;
  }

  /* «En 30 segundos» (09/11/2026): resumen arriba del artículo, en el
     color del servicio, con la misma tarjeta de la web. */
  .resumen-rapido {
    margin-top: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-card);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent 60%),
      var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--svc, var(--color-electric));
    box-shadow: var(--shadow-1);
  }
  .resumen-titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--svc, var(--color-electric));
  }
  .resumen-rapido ul {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .resumen-rapido li::marker {
    color: var(--svc, var(--color-electric));
  }

  .prosa {
    margin-top: var(--space-4);
    color: var(--color-soft);
    font-size: var(--step-1);
  }

  /* ------------------------------------------------ Índice (09/11/2026) */
  .cuerpo-articulo {
    position: relative;
  }
  .indice-movil {
    margin-top: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .indice-movil summary {
    cursor: pointer;
    padding: 1rem 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--svc, var(--color-electric));
  }
  .indice-movil nav {
    padding: 0 1.25rem 1.1rem;
  }
  .indice-movil ol,
  .indice-lateral ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }
  .indice-movil a,
  .indice-lateral a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.85rem;
    border-left: 2px solid var(--color-line);
    color: var(--color-soft);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .indice-movil a:hover,
  .indice-lateral a:hover,
  .indice-lateral a:focus-visible {
    color: var(--color-ink);
  }
  .indice-lateral a[aria-current="true"] {
    color: var(--color-ink);
    border-left-color: var(--svc, var(--color-electric));
  }
  .indice-lateral {
    display: none;
  }
  .indice-titulo {
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--svc, var(--color-electric));
  }
  @media (prefers-reduced-motion: no-preference) {
    .indice-lateral a {
      transition:
        color 0.2s ease,
        border-color 0.2s ease;
    }
  }
  /* Pantallas anchas: el índice va a la derecha del texto y sigue al bajar. */
  @media (width >= 1240px) {
    .indice-movil {
      display: none;
    }
    .indice-lateral {
      display: block;
      position: absolute;
      top: var(--space-4);
      bottom: 0;
      left: calc(100% + 3rem);
      width: 15rem;
    }
    .indice-lateral nav {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      max-height: calc(100vh - var(--header-h) - 4rem);
      overflow-y: auto;
    }
    .indice-lateral a {
      font-size: 0.875rem;
    }
  }

  .prosa :global(h2) {
    color: var(--color-ink);
    font-size: var(--step-3);
    margin-top: var(--space-4);
    margin-bottom: 0.75rem;
  }
  .prosa :global(h3) {
    color: var(--color-ink);
    font-size: var(--step-2);
    margin-top: var(--space-3);
    margin-bottom: 0.5rem;
  }
  .prosa :global(p) {
    margin-bottom: 1rem;
  }
  .prosa :global(ul),
  .prosa :global(ol) {
    margin: 0 0 1rem 1.25rem;
    display: grid;
    gap: 0.5rem;
  }
  .prosa :global(strong) {
    color: var(--color-ink);
  }
  .prosa :global(a) {
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prosa :global(blockquote) {
    border-inline-start: 3px solid var(--color-electric);
    padding-inline-start: 1rem;
    margin: 0 0 1rem;
    color: var(--color-ink);
    font-style: italic;
  }

  .servicio-rel,
  .autor {
    margin-top: var(--space-4);
    padding: 1.5rem;
  }

  .autor {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .autor-foto {
    width: 72px;
    height: 72px;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .autor-nombre {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }

  .h-pequeno {
    font-size: var(--step-2);
  }
  .card-title {
    font-size: var(--step-2);
  }
  .card-text {
    color: var(--color-soft);
  }
  .card-link {
    color: var(--svc, var(--color-electric-soft));
    font-weight: 700;
  }
  .lead {
    color: var(--color-soft);
    font-size: var(--step-1);
  }

  .grid-2 {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    /* Sin margen arriba: lo pone la clase mt-* del marcado. Con
       margin: 0 aquí, la clase no se aplicaba y el título quedaba pegado. */
    margin-inline: 0;
    margin-bottom: 0;
  }

  .cta {
    background: var(--grad-cta);
    color: #fff;
    border-radius: 999px;
    padding: 0.875rem 1.5rem;
    font-weight: 700;
    box-shadow: var(--shadow-cta);
  }

  .cta-final {
    padding: var(--space-6) var(--space-4);
    text-align: center;
    display: grid;
    justify-items: center;
  }

  @media (width >= 768px) {
    .grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
