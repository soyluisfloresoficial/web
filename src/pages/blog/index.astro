---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import TarjetaArticulo from "../../components/TarjetaArticulo.astro";
import Cierre from "../../components/Cierre.astro";
import { servicios, SITIO } from "../../data/servicios";
import { minutosLectura } from "../../data/lectura";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
const [destacado, ...resto] = posts;

// Temas: los servicios con los que enlazan los artículos, con su recuento.
const temas = servicios
  .map((s) => ({ ...s, total: posts.filter((p) => p.data.servicio === s.slug).length }))
  .filter((s) => s.total > 0);

const minutosTotales = posts.reduce((n, p) => n + minutosLectura(p.body), 0);

const url = `${SITIO.url}/blog`;

const title = "Blog sobre IA aplicada y automatización | Luis Flores";
const description =
  "Guías prácticas sobre IA aplicada: agentes de IA, automatización, funnels de conversión y medición, escritas desde la implementación real en negocios.";

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: "Blog",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#person` },
    inLanguage: "es-ES",
  },
  {
    "@type": "Blog",
    "@id": `${url}#blog`,
    url,
    name: "Blog de Luis Flores",
    description,
    inLanguage: "es-ES",
    publisher: { "@id": `${SITIO.url}/#person` },
    blogPost: posts.map((p) => ({ "@id": `${SITIO.url}/blog/${p.id}#post` })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: url },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${url}#lista`,
    itemListElement: posts.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.data.title,
      url: `${SITIO.url}/blog/${p.id}`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Blog" }]}
      antetitulo="Blog"
      titulo="IA aplicada a negocios,"
      destacado="explicada sin humo"
      entradilla="Lo que aprendo implementando: qué automatizar antes, qué medir y dónde se pierden las oportunidades. Guías cortas, con criterio y sin tecnicismos."
    >
      <ul class="cifras-blog mt-8" aria-label="El blog en cifras">
        <li><strong>{posts.length}</strong> guías prácticas</li>
        <li><strong>{temas.length}</strong> temas</li>
        <li><strong>{minutosTotales}</strong> min de lectura en total</li>
      </ul>
    </CabeceraPagina>

    {/* ------------------------------------------------------ Destacado */}
    {
      destacado && (
        <section class="section" aria-labelledby="destacado-titulo">
          <div class="container-lf">
            <p class="eyebrow" id="destacado-titulo">Lo último</p>
            <div class="mt-6 reveal">
              <TarjetaArticulo post={destacado} destacado nivel="h2" />
            </div>
          </div>
        </section>
      )
    }

    {/* --------------------------------------------------------- Todos */}
    <section class="section banda" aria-labelledby="todos-titulo">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Más guías</p>
            <h2 id="todos-titulo" class="subrayado mt-4">Elige por tema</h2>
          </div>
        </div>

        {/* Filtro por tema. Sin JavaScript no hace falta: se ven todas. */}
        <div class="filtros" role="group" aria-label="Filtrar por tema" data-filtros hidden>
          <button type="button" class="filtro" aria-pressed="true" data-tema="">
            Todos <span class="filtro-n">{resto.length}</span>
          </button>
          {
            temas.map((t) => {
              const n = resto.filter((p) => p.data.servicio === t.slug).length;
              return n > 0 ? (
                <button
                  type="button"
                  class="filtro"
                  aria-pressed="false"
                  data-tema={t.slug}
                  style={`--svc: var(${t.color})`}
                >
                  {t.nombre} <span class="filtro-n">{n}</span>
                </button>
              ) : null;
            })
          }
        </div>

        <ul class="rejilla-blog mt-8" data-lista>
          {
            resto.map((p) => (
              <li class="reveal" data-tema={p.data.servicio ?? ""}>
                <TarjetaArticulo post={p} nivel="h3" />
              </li>
            ))
          }
        </ul>
        <p class="sin-resultados mt-8" data-vacio hidden>No hay más guías de este tema por ahora.</p>
      </div>
    </section>

    <Cierre
      titulo="¿Lo aplicamos a tu negocio?"
      entradilla="Leer ayuda a decidir; aplicarlo bien es otra cosa. En 30 minutos reviso tu caso y te digo qué haría primero. Sin compromiso."
    />
  </main>
</Base>

<script>
  const filtros = document.querySelector<HTMLElement>("[data-filtros]");
  const lista = document.querySelector<HTMLElement>("[data-lista]");
  const vacio = document.querySelector<HTMLElement>("[data-vacio]");
  if (filtros && lista) {
    filtros.hidden = false;
    const botones = filtros.querySelectorAll<HTMLButtonElement>("[data-tema]");
    botones.forEach((b) =>
      b.addEventListener("click", () => {
        const tema = b.dataset.tema ?? "";
        botones.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        let visibles = 0;
        lista.querySelectorAll<HTMLElement>("li[data-tema]").forEach((li) => {
          const ver = !tema || li.dataset.tema === tema;
          li.hidden = !ver;
          if (ver) visibles++;
        });
        if (vacio) vacio.hidden = visibles > 0;
      }),
    );
  }
</script>

<style>
  .cifras-blog {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-inline: 0;
    padding: 0;
    list-style: none;
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .cifras-blog li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cifras-blog li + li {
    padding-left: 2rem;
    border-left: 1px solid var(--color-divider);
  }
  .cifras-blog strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--color-ink);
  }

  .filtros {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filtro {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-soft);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-micro) var(--ease),
      color var(--dur-micro) var(--ease),
      background-color var(--dur-micro) var(--ease);
  }
  .filtro:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--svc, var(--color-electric)) 55%, var(--color-line));
  }
  .filtro[aria-pressed="true"] {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--svc, var(--color-electric)) 70%, transparent);
    background: color-mix(in srgb, var(--svc, var(--color-electric)) 14%, var(--color-surface));
  }
  .filtro-n {
    display: inline-grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
  }

  .rejilla-blog {
    display: grid;
    gap: 1.5rem;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .rejilla-blog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 1100px) {
    .rejilla-blog {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sin-resultados {
    color: var(--color-muted);
  }
</style>
