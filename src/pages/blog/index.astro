---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { servicios, SITIO } from "../../data/servicios";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);

const url = `${SITIO.url}/blog`;

const title = "Blog sobre IA aplicada y automatización | Luis Flores";
const description =
  "Guías prácticas sobre IA aplicada: agentes de IA, automatización, funnels de conversión y medición, escritas desde la implementación real en negocios.";

const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: "Blog",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es-ES",
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: url },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${url}#lista`,
    itemListElement: posts.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.data.title,
      url: `${SITIO.url}/blog/${p.id}`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    <nav class="migas container-lf" aria-label="Migas de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-current="page">Blog</li>
      </ol>
    </nav>

    <section class="section pt-0">
      <div class="container-lf">
        <p class="eyebrow">Blog</p>
        <h1 class="mt-3 max-w-[22ch]">IA aplicada a negocios, explicada sin humo</h1>
        <p class="lead mt-5 max-w-[62ch]">
          Lo que aprendo implementando: qué automatizar antes, qué medir y dónde
          se pierden las oportunidades.
        </p>

        <ul class="lista-posts mt-10">
          {
            posts.map((p) => {
              const servicio = servicios.find((s) => s.slug === p.data.servicio);
              return (
                <li class="card p-6" style={servicio ? `--svc: var(${servicio.color})` : ""}>
                  <p class="meta">
                    <time datetime={p.data.datePublished.toISOString()}>
                      {fechaCorta(p.data.datePublished)}
                    </time>
                    {servicio && <> · {servicio.nombre}</>}
                  </p>
                  <h2 class="card-title mt-2">
                    <a href={`/blog/${p.id}`}>{p.data.title}</a>
                  </h2>
                  <p class="card-text mt-2">{p.data.description}</p>
                  <a class="card-link mt-4 inline-block" href={`/blog/${p.id}`}>
                    Leer el artículo <span aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .migas {
    padding-block: 1rem;
    font-size: var(--step--1);
  }
  .migas ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
  }
  .migas li + li::before {
    content: "/";
    margin-inline-end: 0.5rem;
    color: var(--color-line);
  }
  .migas a {
    color: var(--color-soft);
  }

  .lead {
    color: var(--color-soft);
    font-size: var(--step-1);
  }

  .lista-posts {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .card-title {
    font-size: var(--step-2);
  }
  .card-text {
    color: var(--color-soft);
  }
  .card-link {
    color: var(--svc, var(--color-electric-soft));
    font-weight: 700;
  }

  @media (width >= 768px) {
    .lista-posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
