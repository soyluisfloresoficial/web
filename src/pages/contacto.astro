---
import Base from "../layouts/Base.astro";
import CabeceraPagina from "../components/CabeceraPagina.astro";
import Icono from "../components/Icono.astro";
import { SITIO } from "../data/servicios";

const url = `${SITIO.url}/contacto`;

const title = "Contacto: agenda una llamada gratis | Luis Flores";
const description =
  "Agenda una llamada gratis de 30 minutos o escríbeme a hola@soyluisflores.es. Te ayudo a decidir qué automatizar primero en tu negocio con IA.";

const pasos = [
  {
    n: "1",
    titulo: "Me cuentas tu caso",
    texto: "Cómo funciona tu negocio y dónde pierdes tiempo o clientes.",
  },
  {
    n: "2",
    titulo: "Vemos qué automatizar",
    texto: "Buscamos juntos lo que más te ayuda y por dónde conviene empezar.",
  },
  {
    n: "3",
    titulo: "Te llevas un plan",
    texto: "Te digo qué haría primero y qué puedes esperar, trabajes conmigo o no.",
  },
];

const encaja = [
  "Tienes un negocio o pyme en marcha y ya recibes clientes o consultas.",
  "Pierdes tiempo en tareas repetitivas o se te van clientes por no responder a tiempo.",
  "Quieres tomar decisiones con datos.",
];

const todaviaNo = [
  "Buscas resultados garantizados de la noche a la mañana.",
  "Todavía no tienes una oferta clara ni una forma de conseguir contactos.",
  "Quieres probar la herramienta de moda sin tener claro para qué.",
];

const canales = [
  { nombre: "Correo", valor: SITIO.email, href: `mailto:${SITIO.email}`, icono: "email" },
  { nombre: "Instagram", valor: "@soyluisflores_", href: "https://www.instagram.com/soyluisflores_/", icono: "instagram" },
  { nombre: "LinkedIn", valor: "Luis Carlos Flores", href: "https://www.linkedin.com/in/soyluisflores/", icono: "linkedin" },
  { nombre: "TikTok", valor: "@soyluisfloresoficial", href: "https://www.tiktok.com/@soyluisfloresoficial", icono: "tiktok" },
] as const;

const schema = [
  {
    "@type": "ContactPage",
    "@id": `${url}#page`,
    url,
    name: "Contacto",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es",
    mainEntity: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Contacto", item: url },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    {/* ----------------------------------------------------------- Cabecera */}
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Contacto" }]}
      antetitulo="Contacto"
      titulo="Hablemos de"
      destacado="tu negocio"
      entradilla="Lo más rápido es una llamada de 30 minutos. Me cuentas cómo funciona tu negocio y te digo qué conviene automatizar primero. Es gratis y no te compromete a nada."
    >
      <div class="botones mt-8">
        <a class="cta" href={SITIO.calendly} data-ubicacion="contacto-cabecera">
          <Icono nombre="calendario" tamano={18} />
          Agenda tu llamada gratis <span aria-hidden="true">→</span>
        </a>
        <a class="boton-secundario" href={`mailto:${SITIO.email}`}>
          <Icono nombre="email" tamano={18} />
          Escríbeme un correo
        </a>
      </div>
      <p class="nota-respuesta mt-5">Respondo los correos en 24 a 48 horas hábiles.</p>

      <aside slot="lateral" class="card reserva" aria-labelledby="reserva-titulo">
        <div class="reserva-cabecera">
          <span class="anillo-degradado anillo-medio" aria-hidden="true">
            <Icono nombre="calendario" tamano={20} grosor={1.8} degradado />
          </span>
          <div>
            <p id="reserva-titulo" class="reserva-titulo">Llamada de diagnóstico</p>
            <p class="reserva-sub">Con Luis Carlos Flores</p>
          </div>
        </div>
        <ul class="reserva-datos">
          <li><Icono nombre="reloj" tamano={18} /> 30 minutos</li>
          <li><Icono nombre="video" tamano={18} /> Por videollamada</li>
          <li><Icono nombre="escudo" tamano={18} /> Gratis y sin compromiso de contratar</li>
          <li><Icono nombre="globo" tamano={18} /> Latinoamérica y España, en tu horario</li>
        </ul>
        <a class="cta reserva-boton" href={SITIO.calendly} data-ubicacion="contacto-tarjeta">
          Elegir día y hora <span aria-hidden="true">→</span>
        </a>
      </aside>
    </CabeceraPagina>

    {/* -------------------------------------------------------------- Pasos */}
    <section class="section banda" aria-labelledby="pasos-titulo" data-acento="violeta">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">La llamada</p>
            <h2 id="pasos-titulo" class="subrayado mt-4">Qué pasa en esos 30 minutos</h2>
          </div>
          <p class="lead">No te voy a hacer una presentación de ventas. Hablamos de tu negocio y te llevas un plan.</p>
        </div>
        <ol class="pasos mt-10">
          {
            pasos.map((p) => (
              <li class="card tarjeta paso reveal">
                <span class="numero-circulo" aria-hidden="true">{p.n}</span>
                <h3 class="card-title mt-5">{p.titulo}</h3>
                <p class="card-text mt-2">{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ------------------------------------------------------------- Encaje */}
    <section class="section" aria-labelledby="encaje-titulo" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Antes de agendar</p>
            <h2 id="encaje-titulo" class="subrayado mt-4">Para quién es esta llamada</h2>
          </div>
          <p class="lead">Prefiero decírtelo desde ahora, así no pierdes 30 minutos.</p>
        </div>
        <div class="encaje mt-10">
          <div class="card tarjeta encaje-si reveal">
            <h3 class="card-title">Tiene sentido si…</h3>
            <ul class="lista-check mt-5">
              {encaja.map((e) => <li>{e}</li>)}
            </ul>
          </div>
          <div class="card tarjeta encaje-no reveal">
            <h3 class="card-title">Tal vez todavía no, si…</h3>
            <ul class="lista-cruz mt-5">
              {todaviaNo.map((e) => <li>{e}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------- Calculadora */}
    <section class="section banda" aria-labelledby="roi-titulo" data-acento="ambar">
      <div class="container-lf">
        <div class="card calculadora reveal">
          <div class="fondo-reticula" aria-hidden="true"></div>
          <div class="calculadora-texto">
            <p class="eyebrow">Calculadora gratuita</p>
            <h2 id="roi-titulo" class="mt-4">¿Cuánto te cuesta no automatizar?</h2>
            <p class="lead mt-4">
              Pon tus números y verás cuántas horas ahorrarías, cuánto podrías vender
              de más y en cuánto tiempo recuperarías la inversión. Es una estimación
              con supuestos a la vista.
            </p>
            <a class="cta mt-8" href="/roi">
              <Icono nombre="tendencia" tamano={18} />
              Calcular mi caso <span aria-hidden="true">→</span>
            </a>
          </div>
          {/* Vista previa de lo que calcula. Sin cifras: las pone cada persona. */}
          <dl class="vista-previa" aria-hidden="true">
            <div><dt>Horas liberadas al mes</dt><dd>—</dd></div>
            <div><dt>Ventas extra al mes</dt><dd>—</dd></div>
            <div><dt>Recuperación de la inversión</dt><dd>—</dd></div>
            <div><dt>ROI a 12 meses</dt><dd>—</dd></div>
          </dl>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Canales */}
    <section class="section" aria-labelledby="canales-titulo" data-acento="azul">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Otras vías</p>
            <h2 id="canales-titulo" class="subrayado mt-4">Si prefieres escribirme</h2>
          </div>
          <p class="lead">
            Escríbeme por donde te quede más cómodo y te respondo lo antes posible.
          </p>
        </div>
        <ul class="canales mt-10">
          {
            canales.map((c) => (
              <li class="card tarjeta canal reveal">
                <span class="icono-caja" aria-hidden="true">
                  <Icono nombre={c.icono} tamano={22} grosor={1.7} />
                </span>
                <div class="canal-cuerpo">
                  <p class="canal-nombre">{c.nombre}</p>
                  <a class="canal-enlace" href={c.href} rel={c.href.startsWith("http") ? "noopener" : undefined}>
                    {c.valor}
                  </a>
                </div>
                <span class="canal-flecha" aria-hidden="true">
                  <Icono nombre={c.href.startsWith("mailto") ? "flecha" : "externo"} tamano={18} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .nota-respuesta {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  /* ---------------------------------------------------- Tarjeta reserva */
  .reserva {
    position: relative;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border-color: rgb(0 123 255 / 0.35);
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(0 123 255 / 0.14), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent 40%),
      var(--color-surface);
    box-shadow: var(--shadow-2);
  }
  .reserva-cabecera {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .reserva-titulo {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-ink);
  }
  .reserva-sub {
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .reserva-datos {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .reserva-datos li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .reserva-datos :global(svg) {
    color: var(--color-electric-soft);
    flex-shrink: 0;
  }
  .reserva-boton {
    width: 100%;
    margin-top: 1.5rem;
  }

  /* -------------------------------------------------------------- Pasos */
  .pasos {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .pasos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Línea que une los tres pasos, por detrás de las tarjetas. */
    .pasos::before {
      content: "";
      position: absolute;
      top: 3.25rem;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--acento), transparent);
      opacity: 0.6;
    }
  }
  .paso {
    position: relative;
  }
  .card-title {
    font-size: var(--step-1);
  }
  .card-text {
    color: var(--color-soft);
  }

  /* ------------------------------------------------------------- Encaje */
  .encaje {
    display: grid;
    gap: 1.25rem;
  }
  @media (width >= 768px) {
    .encaje {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .encaje-si {
    border-color: rgb(45 212 191 / 0.3);
  }

  /* -------------------------------------------------------- Calculadora */
  .calculadora {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    background:
      radial-gradient(45% 80% at 90% 20%, rgb(251 191 36 / 0.1), transparent 70%),
      var(--color-surface);
  }
  .calculadora > :not(.fondo-reticula) {
    position: relative;
    z-index: 1;
  }
  @media (width >= 1024px) {
    .calculadora {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
  }
  .vista-previa {
    display: grid;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-float);
    background: rgb(7 9 13 / 0.55);
  }
  .vista-previa div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .vista-previa div:last-child {
    border-bottom: 0;
  }
  .vista-previa dt {
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .vista-previa dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--acento-texto);
  }

  /* ------------------------------------------------------------ Canales */
  .canales {
    display: grid;
    gap: 1.25rem;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 640px) {
    .canales {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .canal {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .canal-cuerpo {
    flex: 1;
    min-width: 0;
  }
  .canal-nombre {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  /* Tarjeta entera pulsable a través del enlace. */
  .canal-enlace {
    color: var(--color-electric-soft);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .canal-enlace::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .canal:has(.canal-enlace:focus-visible) {
    outline: 3px solid var(--color-electric);
    outline-offset: 3px;
  }
  .canal-enlace:focus-visible {
    outline: none;
  }
  .canal-flecha {
    color: var(--color-muted);
    transition:
      color var(--dur-micro) var(--ease),
      translate var(--dur-micro) var(--ease);
  }
  .canal:hover .canal-flecha {
    color: var(--color-ink);
    translate: 3px 0;
  }
</style>
