---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CabeceraPagina from "../components/CabeceraPagina.astro";
import Cierre from "../components/Cierre.astro";
import Icono from "../components/Icono.astro";
import { SITIO, proyectos } from "../data/servicios";
import { queMido } from "../data/home";
import retratoImg from "../assets/luis-flores-sobre-mi-azul.jpg";

const url = `${SITIO.url}/sobre-mi`;

const title = "Luis Carlos Flores, consultor de IA y automatización";
const description =
  "Luis Carlos Flores dirige una agencia de IA y automatización para negocios de Latinoamérica y España. Todo lo que implementa lo prueba antes en su negocio.";

const compromisos = [
  {
    titulo: "Te hablo en simple",
    icono: "chat",
    texto:
      "Sin palabras técnicas. Te explico cada cosa con ejemplos de tu propio negocio, para que entiendas qué hace y por qué.",
  },
  {
    titulo: "Primero lo pruebo yo",
    icono: "escudo",
    texto: "Lo que te propongo ya lo usé en mi negocio. Si no me convence a mí, no te lo ofrezco.",
  },
  {
    titulo: "Te muestro los números",
    icono: "tendencia",
    texto: "No te prometo milagros. Medimos antes y después, y corregimos lo que no funciona.",
  },
  {
    titulo: "Tu tiempo es el objetivo",
    icono: "reloj",
    texto:
      "Automatizo para que dejes de trabajar jornadas eternas, y no para complicarte más el día.",
  },
] as const;

// La especialización en IA va primero: es lo que hace hoy.
const formacion = [
  { titulo: "IA generativa aplicada", detalle: "150 horas", icono: "chipIa" },
  { titulo: "Creación de agentes de IA", detalle: "Formación especializada", icono: "robot" },
  // Sustituye a «Desarrollo web · HTML5 y CSS3 · 210 horas» (21/10/2026), que
  // se leía como formación básica. Son las herramientas con las que trabaja.
  { titulo: "Automatización y CRM", detalle: "Make, n8n, Zapier y GoHighLevel en proyectos reales", icono: "flujo" },
] as const;

const iconosMetricas = ["tendencia", "reloj", "calendarioOk"] as const;

// Maquetas de «Mi historia» (28/10/2026). Son ilustrativas: muestran el tipo
// de trabajo de cada momento, sin cifras ni clientes.
const pendientesAntes = [
  { texto: "¿Me pasas los precios?", estado: "Sin responder", icono: "whatsapp" },
  { texto: "Seguimiento del presupuesto", estado: "Pendiente", icono: "reloj" },
  { texto: "Pasar los datos al Excel", estado: "A mano", icono: "persona" },
] as const;
const flujoCambio = [
  { nombre: "Mensaje", icono: "whatsapp" },
  { nombre: "Agente", icono: "robot" },
  { nombre: "Agenda", icono: "calendarioOk" },
] as const;
const entregasHoy = [
  "Agentes de IA",
  "Automatizaciones",
  "Embudos de venta",
  "Páginas web",
  "Documentación para tu equipo",
];


const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${url}#page`,
    url,
    name: title,
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es",
    mainEntity: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Sobre mí", item: url },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    {/* ----------------------------------------------------------- Cabecera */}
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Sobre mí" }]}
      antetitulo="Sobre mí"
      titulo="Soy Luis Carlos Flores y pongo la IA"
      destacado="a trabajar para tu negocio"
      entradilla="Dirijo una agencia con base en Manresa, España, y diseño e implemento sistemas de IA y automatización para negocios de Latinoamérica y España. Te hablo en simple, porque sé lo que es llevar un negocio y que el día no alcance."
    >
      <div class="botones mt-8">
        <a class="cta" href="/contacto">
          <Icono nombre="calendario" tamano={18} />
          Agenda tu llamada gratis <span aria-hidden="true">→</span>
        </a>
        <a class="boton-secundario" href="/servicios">Ver servicios</a>
      </div>

      <figure slot="lateral" class="retrato">
        <Image
          src={retratoImg}
          alt="Retrato de Luis Carlos Flores"
          widths={[360, 640, 960]}
          sizes="(min-width: 1024px) 36vw, 90vw"
          loading="eager"
          fetchpriority="high"
          class="retrato-foto"
        />
        <div class="info-flotante info-abajo info-derecha">
          <span class="info-etiqueta">Base</span>
          <span class="info-valor">Manresa · Barcelona</span>
          <span class="info-sub">Trabajo en remoto con Latinoamérica y España</span>
        </div>
        <div class="info-flotante info-arriba info-izquierda">
          <span class="info-etiqueta">Lo que propongo</span>
          <span class="info-valor">Primero probado en mi negocio</span>
        </div>
      </figure>
    </CabeceraPagina>

    {/* ------------------------------------------------------------ Historia */}
    <section class="section banda" aria-labelledby="historia-titulo" data-acento="coral">
      <div class="container-lf historia">
        <div class="historia-lateral">
          <p class="eyebrow">Mi historia</p>
          <h2 id="historia-titulo" class="subrayado mt-4">De apagar incendios a construir sistemas</h2>
          <blockquote class="cita mt-8">
            Todo lo que te propongo lo probé antes en mi propio negocio.
          </blockquote>
        </div>

        <ol class="linea-tiempo">
          <li class="momento reveal" style="--tono: var(--acento-coral)">
            <span class="momento-marca" aria-hidden="true">
              <Icono nombre="reloj" tamano={18} grosor={1.8} />
            </span>
            <div class="momento-caja">
              <div class="escena" aria-hidden="true">
                <div class="mini-ventana">
                  <p class="mini-titulo">Pendientes de hoy</p>
                  <ul class="mini-pendientes">
                    {
                      pendientesAntes.map((p) => (
                        <li>
                          <Icono nombre={p.icono} tamano={13} grosor={1.8} />
                          <span class="mini-texto">{p.texto}</span>
                          <span class="mini-estado">{p.estado}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
              <div class="momento-texto">
                <span class="hito">Antes</span>
                <h3 class="momento-titulo">El día se me iba en lo urgente</h3>
                <p>
              Llevando mi negocio solo, me pasaba lo mismo que a casi cualquier
              emprendedor. El día se me iba en contestar mensajes, dar seguimiento y
              repetir las mismas tareas. Había que hacerlas, pero no hacían crecer el
              negocio.
                </p>
              </div>
            </div>
          </li>
          <li class="momento reveal" style="--tono: var(--acento-violeta)">
            <span class="momento-marca" aria-hidden="true">
              <Icono nombre="flujo" tamano={18} grosor={1.8} />
            </span>
            <div class="momento-caja">
              <div class="escena" aria-hidden="true">
                <div class="mini-flujo">
                  {
                    flujoCambio.map((n, k) => (
                      <>
                        {k > 0 && <span class="mini-linea" />}
                        <span class="mini-nodo">
                          <Icono nombre={n.icono} tamano={18} grosor={1.8} />
                          <span>{n.nombre}</span>
                        </span>
                      </>
                    ))
                  }
                </div>
                <span class="mini-sello">
                  <Icono nombre="check" tamano={12} grosor={2.4} /> Probado en mi negocio
                </span>
              </div>
              <div class="momento-texto">
                <span class="hito">El cambio</span>
                <h3 class="momento-titulo">Lo probé primero en mi negocio</h3>
                <p>
              Un día decidí cambiar eso. Apliqué IA y automatización en mi propio
              negocio antes de ofrecérselo a nadie, recuperé horas cada semana y tuve
              tiempo para lo importante. Así pasé de trabajar solo a dirigir mi
              propia agencia.
                </p>
              </div>
            </div>
          </li>
          <li class="momento reveal" style="--tono: var(--acento-turquesa)">
            <span class="momento-marca" aria-hidden="true">
              <Icono nombre="check" tamano={18} grosor={2.2} />
            </span>
            <div class="momento-caja">
              <div class="escena" aria-hidden="true">
                <div class="mini-ventana">
                  <p class="mini-titulo">Lo que dejo funcionando</p>
                  <ul class="mini-entregas">
                    {
                      entregasHoy.map((e) => (
                        <li>
                          <span class="mini-check"><Icono nombre="check" tamano={11} grosor={2.6} /></span>
                          {e}
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
              <div class="momento-texto">
                <span class="hito">Hoy</span>
                <h3 class="momento-titulo">Ahora lo hago por otros negocios</h3>
                <p>
              Hago lo mismo por otros negocios. Implemento agentes de IA,
              automatizaciones, embudos de venta y páginas web, y dejo todo
              documentado para que tu equipo sepa cómo funciona y cómo mantenerlo.
                </p>
              </div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    {/* --------------------------------------------------------- Compromisos */}
    <section class="section" aria-labelledby="compromisos-titulo" data-acento="cian">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Cómo trabajo contigo</p>
            <h2 id="compromisos-titulo" class="subrayado mt-4">A qué me comprometo</h2>
          </div>
          <p class="lead">
            Esto es lo que puedes esperar de mí desde la primera llamada.
          </p>
        </div>
        <ul class="rejilla-4 mt-10">
          {
            compromisos.map((c) => (
              <li class="card tarjeta reveal">
                <span class="icono-caja" aria-hidden="true">
                  <Icono nombre={c.icono} tamano={22} grosor={1.6} />
                </span>
                <h3 class="card-title mt-5">{c.titulo}</h3>
                <p class="card-text mt-3">{c.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ------------------------------------------------------------ Medición */}
    {/*
      Sin cifras (21/10/2026): no hay un caso publicable que las respalde.
      Se enseña el método. Si algún día hay un caso real con permiso del
      cliente, va en esta sección.
    */}
    <section class="section banda" aria-labelledby="metricas-titulo" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Resultados medibles</p>
            <h2 id="metricas-titulo" class="subrayado mt-4">Cómo mido lo que implemento</h2>
          </div>
          <p class="lead">
            En cada proyecto acordamos qué medir y lo comparamos antes y después, con
            las herramientas de tu propio negocio.
          </p>
        </div>
        <ul class="rejilla-3 mt-10">
          {
            queMido.map((m, i) => (
              <li class="card tarjeta medida reveal">
                <span class="anillo-degradado anillo-medio" aria-hidden="true">
                  <Icono nombre={iconosMetricas[i]} tamano={20} grosor={1.8} degradado />
                </span>
                <h3 class="card-title mt-5">{m.titulo}</h3>
                <p class="card-text mt-2">{m.texto}</p>
                <p class="medida-como">
                  <span>Cómo lo mido</span>
                  {m.como}
                </p>
              </li>
            ))
          }
        </ul>

        <div class="card tarjeta como-mido mt-6" id="como-mido">
          <span class="icono-caja" aria-hidden="true">
            <Icono nombre="escudo" tamano={22} grosor={1.6} />
          </span>
          <div>
            <h3 class="card-title">Por qué no publico porcentajes</h3>
            <p class="card-text mt-3">
              Cada negocio parte de un punto distinto, y un porcentaje sacado de otro
              caso no te dice nada del tuyo. Por eso no te prometo cifras antes de
              conocerte.
            </p>
            <p class="card-text mt-3">
              Lo que sí hago es dejar definido en la propuesta qué vamos a medir y
              mostrarte el antes y el después con tus propios datos.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Formación */}
    <section class="section" aria-labelledby="formacion-titulo" data-acento="violeta">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Mi formación</p>
            <h2 id="formacion-titulo" class="subrayado mt-4">Formación y especialización</h2>
          </div>
        </div>
        <ul class="rejilla-3 mt-10">
          {
            formacion.map((f) => (
              <li class="card tarjeta formacion reveal">
                <span class="anillo-degradado anillo-medio" aria-hidden="true">
                  <Icono nombre={f.icono} tamano={20} grosor={1.7} degradado />
                </span>
                <h3 class="card-title mt-5">{f.titulo}</h3>
                <p class="card-text mt-2">{f.detalle}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------- Proyectos */}
    <section class="section banda" aria-labelledby="proyectos-titulo" data-acento="ambar">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Producto propio</p>
            <h2 id="proyectos-titulo" class="subrayado mt-4">Lo que aplico en mi propio producto</h2>
          </div>
          <p class="lead">
            Uso en mi producto lo mismo que implemento para mis clientes, así lo pruebo
            todos los días.
          </p>
        </div>
        <ul class="proyectos mt-10">
          {
            proyectos.map((p) => (
              <li class="card tarjeta proyecto reveal">
                <span class="proyecto-inicial" aria-hidden="true">{p.nombre[0]}</span>
                <div class="proyecto-cuerpo">
                  <h3 class="card-title">{p.nombre}</h3>
                  <p class="card-text mt-2">{p.descripcion || new URL(p.url).hostname}</p>
                  <a class="card-link mt-4 inline-block" href={p.url} rel="noopener">
                    Visitar {new URL(p.url).hostname} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Cierre
      titulo="¿Hablamos de tu negocio?"
      entradilla="Cuéntame cómo trabajas hoy y te digo qué automatizaría primero. Es gratis y sin presión para contratar."
    />
  </main>
</Base>

<style>
  /* ---------------------------------------------------------- Retrato */
  .retrato {
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin: 0 auto;
    padding-bottom: 2.5rem;
  }
  .retrato::before {
    content: "";
    position: absolute;
    inset: 10% -6% 6% 10%;
    z-index: 0;
    border-radius: 2rem;
    background: var(--grad-cta);
    opacity: 0.22;
    filter: blur(56px);
  }
  .retrato-foto {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Encuadre desde arriba: la cabeza queda entera y el letrero del logo
       se ve completo. */
    object-position: center 0%;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1.5rem;
    box-shadow: var(--shadow-2);
  }
  /* La tarjeta de arriba asoma por encima de la foto para no tapar la cara. */
  .retrato :global(.info-arriba) {
    top: -1.5rem;
  }

  /* --------------------------------------------------------- Historia */
  .historia {
    display: grid;
    gap: 3rem;
  }
  @media (width >= 1024px) {
    .historia {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5rem;
      align-items: start;
    }
    .historia-lateral {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .cita {
    margin-inline: 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--acento);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  /* Línea de tiempo visual (28/10/2026). Cada momento tiene su tono
     (coral, violeta, turquesa) y su tramo de línea, que se dibuja al
     entrar en vista. Solo transform; con movimiento reducido ya se ve
     completa. */
  .linea-tiempo {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0 0 0 3.5rem;
    list-style: none;
  }
  /* Riel de fondo, apagado. */
  .linea-tiempo::before {
    content: "";
    position: absolute;
    left: 1.25rem;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.08);
  }
  .momento {
    position: relative;
  }
  /* Tramo de color de cada momento, hasta el siguiente. */
  .momento:not(:last-child)::after {
    content: "";
    position: absolute;
    left: -2.25rem;
    top: 2.5rem;
    bottom: -2rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--tono), color-mix(in srgb, var(--tono) 25%, transparent));
    transform-origin: top;
  }
  .momento-marca {
    position: absolute;
    left: -3.5rem;
    top: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--tono);
    border-radius: 999px;
    background: var(--color-navy-2);
    color: var(--tono);
    box-shadow: 0 0 0 6px var(--color-navy), 0 0 24px -4px color-mix(in srgb, var(--tono) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .momento:not(:last-child)::after {
      transform: scaleY(0);
      transition: transform 0.9s var(--ease) 0.25s;
    }
    :global(.js) .momento.is-visible::after {
      transform: scaleY(1);
    }
  }
  .momento-caja {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-surface);
  }
  .momento:hover .momento-caja {
    border-color: color-mix(in srgb, var(--tono) 45%, var(--color-line));
  }
  .escena {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.875rem;
    min-height: 11rem;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(80% 90% at 75% 0%, color-mix(in srgb, var(--tono) 20%, transparent), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--color-navy-2);
  }
  .momento-texto {
    padding: 1.25rem 1.375rem 1.5rem;
  }
  .hito {
    display: block;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tono);
  }
  .momento-titulo {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .momento-texto p {
    margin-top: 0.625rem;
    max-width: 62ch;
    line-height: 1.65;
    color: var(--color-soft);
  }

  /* Maquetas: mismas piezas que «Cómo trabajo» en la portada. */
  .mini-ventana {
    width: min(100%, 21rem);
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: rgb(16 21 34 / 0.92);
    box-shadow: 0 18px 40px -22px #000;
  }
  .mini-titulo {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .mini-pendientes,
  .mini-entregas {
    display: grid;
    gap: 0.5rem;
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mini-pendientes li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.03);
    color: var(--color-muted);
  }
  .mini-texto {
    overflow: hidden;
    font-size: 0.6875rem;
    color: var(--color-soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mini-estado {
    padding: 0.125rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--acento-coral) 16%, transparent);
    color: var(--acento-coral);
    font-size: 0.625rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .mini-flujo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 21rem);
  }
  .mini-nodo {
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    color: var(--color-ink);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .mini-nodo :global(svg) {
    box-sizing: content-box;
    padding: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--tono) 50%, var(--color-line));
    border-radius: 0.875rem;
    background: rgb(16 21 34 / 0.92);
    color: var(--tono);
  }
  .mini-linea {
    flex: 1;
    min-width: 1.25rem;
    height: 2px;
    margin: 0 0.375rem 1.25rem;
    border-radius: 2px;
