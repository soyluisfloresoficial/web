---
/**
 * /diagnostico: landing de la llamada de diagnóstico, con identidad propia
 * (lima sobre negro). Pedida por el titular el 22/10/2026 para campañas.
 *
 * Indexación (26/10/2026): la página repite la agenda y las preguntas de
 * /contacto, así que va con «noindex, follow», canónica hacia /contacto y
 * fuera del sitemap. Así no compite con /contacto en los buscadores y sigue
 * sirviendo para campañas, donde las visitas llegan por anuncio o enlace
 * directo. Los enlaces internos que ya existen (pie, llms.txt) se quedan.
 *
 * El diseño y sus reglas están en components/LandingDiagnostico.astro.
 *
 * Los textos salen de lo que ya dice la web (contacto, preguntas
 * frecuentes): no hay cifras, casos ni promesas nuevas.
 */
import LandingDiagnostico from "../components/LandingDiagnostico.astro";
import { SITIO, AREA_SERVIDA } from "../data/servicios";
import { faqPlana } from "../data/home";

const url = `${SITIO.url}/diagnostico`;
const title = "Llamada de diagnóstico gratis de 30 minutos | Luis Flores";
const description =
  "Agenda una videollamada gratis de 30 minutos: me cuentas cómo trabajas y te digo qué automatizar primero en tu negocio, con qué herramienta y qué esperar.";


const llevas = [
  {
    titulo: "Una prioridad clara",
    texto: "Qué conviene automatizar primero en tu negocio y por qué, en lugar de una lista interminable.",
  },
  {
    titulo: "La herramienta adecuada",
    texto: "Con qué se haría, aprovechando lo que ya usas siempre que se pueda conectar.",
  },
  {
    titulo: "Qué puedes esperar",
    texto: "Cómo sería el trabajo y cómo mediríamos el cambio, antes y después, con tus propios datos.",
  },
];


// Etapas de la ventana del hero: lo que se ve en la llamada, en orden.
const etapas = ["Me cuentas tu caso", "Vemos qué automatizar", "Te llevas un plan"];

const encaja = [
  "Tienes un negocio o pyme en marcha y ya recibes clientes o consultas.",
  "Pierdes tiempo en tareas repetitivas o se te van clientes por no responder a tiempo.",
  "Quieres tomar decisiones con datos.",
];
const todaviaNo = [
  "Buscas resultados garantizados de la noche a la mañana.",
  "Todavía no tienes una oferta clara ni una forma de conseguir contactos.",
  "Quieres probar la herramienta de moda sin tener claro para qué.",
];

const preguntas = [
  "¿Cómo es la primera llamada?",
  "¿Necesito saber de tecnología?",
  "¿Cuánto cuesta?",
  "¿Trabajas con negocios de mi país?",
  "¿Qué pasa después del diagnóstico?",
]
  .map((p) => faqPlana.find((f) => f.pregunta === p))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const schema = [
  {
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: title,
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es",
    about: { "@id": `${url}#service` },
  },
  {
    "@type": "Service",
    "@id": `${url}#service`,
    name: "Llamada de diagnóstico",
    description:
      "Videollamada gratis de 30 minutos para revisar cómo funciona un negocio y decidir qué automatizar primero, con qué herramienta y qué esperar.",
    provider: { "@id": `${SITIO.url}/#organization` },
    areaServed: AREA_SERVIDA,
    availableLanguage: "es",
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR", url },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Llamada de diagnóstico", item: url },
    ],
  },
];
---

<LandingDiagnostico
  title={title}
  description={description}
  schema={schema}
  canonicalDe="/contacto"
  formId="calendly-diagnostico-landing"
  etiqueta="Llamada de diagnóstico · 30 min · Gratis"
  titulo="Descubre en 30 minutos qué automatizar primero en tu negocio."
  entrada="Me cuentas cómo trabajas hoy y dónde se te van el tiempo y los clientes. Te digo qué haría primero, con qué herramienta y qué puedes esperar, trabajes conmigo o no."
  ventana="diagnostico"
  etapas={etapas}
  llevas={llevas}
  encaja={encaja}
  todaviaNo={todaviaNo}
  preguntas={preguntas}
/>
