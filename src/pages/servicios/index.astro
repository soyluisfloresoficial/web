---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import Cierre from "../../components/Cierre.astro";
import Icono from "../../components/Icono.astro";
import IlustracionServicio from "../../components/IlustracionServicio.astro";
import { servicios, SITIO } from "../../data/servicios";
import { ilustraciones } from "../../data/ilustraciones";

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/*.{jpg,webp}",
  { eager: true },
);
function imagenDe(nombre: string) {
  // Sin nombre no hay foto. Ojo: "../assets/" contiene "/." y, con el nombre
  // vacío, la búsqueda de abajo devolvía la primera imagen que encontrara.
  if (!nombre) return undefined;
  const clave = Object.keys(imagenes).find((k) => k.includes(`/${nombre}.`));
  return clave ? imagenes[clave].default : undefined;
}

const url = `${SITIO.url}/servicios`;

const title = "Servicios de IA y automatización para pymes | Luis Flores";
const description =
  "Agentes de IA, embudos de venta, automatización, CRM, email marketing, páginas web y publicidad. Servicios de IA para pymes de Latinoamérica y España.";

/** Guía rápida: el problema que nota el dueño del negocio y por dónde empezar. */
const guia = [
  { problema: "Contesto tarde los mensajes", slug: "agentes-ia" },
  { problema: "Se me pierden los contactos", slug: "crm-seguimiento-leads" },
  { problema: "Repito tareas todo el día", slug: "automatizacion" },
  { problema: "No sé qué me trae clientes", slug: "paneles-de-metricas" },
];
const nombreDe = (slug: string) => servicios.find((s) => s.slug === slug)?.nombre ?? "";

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: "Servicios",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#organization` },
    inLanguage: "es",
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Servicios", item: url },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${url}#lista`,
    itemListElement: servicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nombre,
      url: `${SITIO.url}/servicios/${s.slug}`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Servicios" }]}
      antetitulo="Servicios"
      titulo="Servicios de IA y automatización"
      destacado="para tu negocio"
      entradilla="Desde un agente de IA hasta un sistema completo para conseguir y atender clientes. Yo lo implemento, lo conecto con lo que ya usas y te lo dejo documentado."
    >
      <div class="botones mt-8">
        <a class="cta" href="/contacto">
          <Icono nombre="calendario" tamano={18} />
          Agenda tu llamada gratis <span aria-hidden="true">→</span>
        </a>
        <a class="boton-secundario" href="#todos">Ver los {servicios.length} servicios</a>
      </div>

      <aside slot="lateral" class="card guia" aria-labelledby="guia-titulo">
        <p id="guia-titulo" class="guia-titulo">¿Por dónde empiezo?</p>
        <p class="guia-sub">Elige lo que más te pasa hoy.</p>
        <ul class="guia-lista">
          {
            guia.map((g) => (
              <li>
                <a href={`/servicios/${g.slug}`}>
                  <span class="guia-problema">{g.problema}</span>
                  <span class="guia-servicio">
                    {nombreDe(g.slug)} <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="guia-nota">¿No lo tienes claro? Lo vemos juntos en la llamada.</p>
      </aside>
    </CabeceraPagina>

    <section class="section banda" id="todos" aria-labelledby="todos-titulo">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Todos los servicios</p>
            <h2 id="todos-titulo" class="subrayado mt-4">Piezas que se combinan</h2>
          </div>
          <p class="lead">
            Puedes empezar por una sola. La mayoría de los proyectos termina juntando
            dos o tres en un mismo sistema.
          </p>
        </div>

        <ul class="rejilla-servicios mt-10">
          {
            servicios.map((s) => {
              // Igual que en la home: si el servicio tiene ilustración, va antes que la foto.
              const img = ilustraciones[s.slug] ? undefined : imagenDe(s.imagen);
              return (
                <li class="card tarjeta-servicio reveal" style={`--svc: var(${s.color})`}>
                  <div class={`media${img ? " duotono" : " media-ilus"}`}>
                    {img ? (
                      <Image
                        src={img}
                        alt={s.imagenAlt}
                        widths={[360, 640]}
                        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                        loading="lazy"
                        class="foto"
                      />
                    ) : (
                      <IlustracionServicio slug={s.slug} color={s.color} alt={s.imagenAlt} variante="tarjeta" />
                    )}
                    <span class="distintivo" aria-hidden="true">
                      <Icono nombre={s.icono} tamano={18} grosor={1.8} />
                    </span>
                  </div>
                  <div class="tarjeta-cuerpo">
                    <h3 class="tarjeta-titulo">
                      <a href={`/servicios/${s.slug}`} class="enlace-tarjeta">{s.nombre}</a>
                    </h3>
                    <p class="tarjeta-texto">{s.definicion}</p>
                    <span class="card-link" aria-hidden="true">
                      Ver el servicio <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <Cierre
      titulo="¿No sabes por cuál empezar?"
      entradilla="En 30 minutos revisamos tu caso y te digo qué conviene automatizar primero. Es gratis y no te compromete a nada."
    />
  </main>
</Base>

<style>
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ------------------------------------------------------- Guía lateral */
  .guia {
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(139 92 246 / 0.12), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent 40%),
      var(--color-surface);
    box-shadow: var(--shadow-2);
  }
  .guia-titulo {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--color-ink);
  }
  .guia-sub {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .guia-lista {
    display: grid;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .guia-lista a {
    display: grid;
    gap: 0.125rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--color-line);
    text-decoration: none;
  }
  .guia-problema {
    color: var(--color-ink);
    font-weight: 600;
  }
  .guia-servicio {
    color: var(--color-electric-soft);
    font-size: var(--step--1);
    font-weight: 600;
    transition: color var(--dur-micro) var(--ease);
  }
  .guia-lista a:hover .guia-servicio,
  .guia-lista a:focus-visible .guia-servicio {
    color: var(--color-ink);
  }
  .guia-nota {
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  /* ---------------------------------------------------- Tarjetas */
  .rejilla-servicios {
    display: grid;
    gap: 1.25rem;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 640px) {
    .rejilla-servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 1024px) {
    .rejilla-servicios {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tarjeta-servicio {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease),
      box-shadow var(--dur-micro) var(--ease);
  }
  .tarjeta-servicio:hover {
    border-color: color-mix(in srgb, var(--svc) 50%, transparent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-line);
  }
  .media :global(.foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-ilus {
    background:
      radial-gradient(70% 90% at 60% 30%, color-mix(in srgb, var(--svc) 22%, transparent), transparent 70%),
      var(--color-surface);
  }
  .media-ilus :global(.ilustracion) {
    height: 100%;
  }
  .distintivo {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--svc) 50%, transparent);
    border-radius: 10px;
    background: rgb(16 21 34 / 0.85);
    color: var(--svc);
  }
  .tarjeta-cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
  }
  .tarjeta-titulo {
    font-size: var(--step-1);
  }
  .tarjeta-texto {
    margin-top: 0.625rem;
    color: var(--color-soft);
  }
  .card-link {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--svc);
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta-servicio:hover {
      transform: none;
    }
  }
</style>
