---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { servicios, SITIO } from "../../data/servicios";

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/*.{jpg,webp}",
  { eager: true },
);
function imagenDe(nombre: string) {
  const clave = Object.keys(imagenes).find((k) => k.includes(`/${nombre}.`));
  return clave ? imagenes[clave].default : undefined;
}

const url = `${SITIO.url}/servicios`;

const title = "Servicios de IA y automatización para pymes | Luis Flores";
const description =
  "Agentes de IA, funnels de conversión, automatización, webs con IA, tráfico de pago y consultoría. Servicios de IA aplicada para pymes de España y LATAM.";

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: "Servicios",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#organization` },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Servicios", item: url },
    ],
  },
  {
    "@type": "ItemList",
    "@id": `${url}#lista`,
    itemListElement: servicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nombre,
      url: `${SITIO.url}/servicios/${s.slug}`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    <nav class="migas container-lf" aria-label="Migas de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li aria-current="page">Servicios</li>
      </ol>
    </nav>

    <section class="section pt-0">
      <div class="container-lf">
        <p class="eyebrow">Servicios</p>
        <h1 class="mt-3 max-w-[22ch]">
          Servicios de IA y automatización para negocios reales
        </h1>
        <p class="lead mt-5 max-w-[62ch]">
          Desde un agente de IA hasta un sistema completo de captación y
          automatización. Lo implemento y lo dejo documentado.
        </p>

        <ul class="services-grid mt-10">
          {
            servicios.map((s) => {
              const img = imagenDe(s.imagen);
              return (
                <li class="card overflow-hidden" style={`--svc: var(${s.color})`}>
                  {img && (
                    <Image
                      src={img}
                      alt={s.imagenAlt}
                      widths={[320, 640]}
                      sizes="(min-width: 1024px) 30vw, 100vw"
                      loading="lazy"
                      class="aspect-[16/9] w-full object-cover"
                    />
                  )}
                  <div class="p-5">
                    <h2 class="card-title">{s.nombre}</h2>
                    <p class="definicion mt-2">{s.definicion}</p>
                    <a class="card-link mt-4 inline-block" href={`/servicios/${s.slug}`}>
                      Ver servicio <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="cta-titulo">
      <div class="container-lf card cta-final">
        <h2 id="cta-titulo">¿No sabes por cuál empezar?</h2>
        <p class="lead mt-3 max-w-[52ch]">
          En 30 minutos reviso tu caso y te digo qué automatizar primero.
        </p>
        <a class="cta mt-6 inline-flex items-center gap-2" href="/contacto">
          Reservar diagnóstico <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .migas {
    padding-block: 1rem;
    font-size: var(--step--1);
  }
  .migas ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
  }
  .migas li + li::before {
    content: "/";
    margin-inline-end: 0.5rem;
    color: var(--color-line);
  }
  .migas a {
    color: var(--color-soft);
  }

  .lead {
    color: var(--color-soft);
    font-size: var(--step-1);
  }

  .card-title {
    font-size: var(--step-2);
  }

  .definicion {
    color: var(--color-soft);
    font-size: var(--step-0);
  }

  .card-link {
    color: var(--svc, var(--color-electric-soft));
    font-weight: 700;
  }

  .services-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cta {
    background: var(--grad-cta);
    color: #fff;
    border-radius: 999px;
    padding: 0.875rem 1.5rem;
    font-weight: 700;
    box-shadow: var(--shadow-cta);
  }

  .cta-final {
    padding: var(--space-6) var(--space-4);
    text-align: center;
    display: grid;
    justify-items: center;
  }

  @media (width >= 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width >= 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
