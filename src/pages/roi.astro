---
import Base from "../layouts/Base.astro";
import CabeceraPagina from "../components/CabeceraPagina.astro";
import Cierre from "../components/Cierre.astro";
import Icono from "../components/Icono.astro";
import { SITIO } from "../data/servicios";

const url = `${SITIO.url}/roi`;

const title = "Calculadora de ROI de IA y automatización | Luis Flores";
const description =
  "Calcula cuántas horas ahorrarías, cuánto podrías vender de más y en cuánto tiempo recuperarías la inversión al automatizar tu negocio con IA.";

const campos = [
  { name: "leads", label: "Contactos al mes", pista: "Personas interesadas que te escriben o te llaman al mes", ph: "80", step: "1", max: "" },
  { name: "ticket", label: "Ticket promedio", pista: "Lo que te deja en promedio cada cliente, en tu moneda", ph: "600", step: "10", max: "" },
  { name: "conversion", label: "Conversión actual (%)", pista: "Cuántos contactos se vuelven clientes hoy", ph: "20", step: "1", max: "100" },
  { name: "hours", label: "Horas por semana en tareas manuales", pista: "Seguimiento, copiar datos, contestar mensajes…", ph: "10", step: "1", max: "" },
  { name: "cost", label: "Costo por hora", pista: "Lo que vale esa hora, tuya o de tu equipo, en tu moneda", ph: "25", step: "1", max: "" },
  { name: "lost", label: "Contactos perdidos por no responder a tiempo (%)", pista: "Un cálculo aproximado", ph: "25", step: "1", max: "100" },
  { name: "investment", label: "Inversión estimada", pista: "Lo que estarías dispuesto a invertir, en tu moneda", ph: "3000", step: "100", max: "" },
];

const escenarios = [
  { valor: "conservador", etiqueta: "Conservador" },
  { valor: "realista", etiqueta: "Realista" },
  { valor: "optimista", etiqueta: "Optimista" },
];

const schema = [
  {
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: "Calculadora de ROI",
    description,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es",
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Calculadora de ROI", item: url },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Calculadora de ROI" }]}
      antetitulo="Calculadora de ROI"
      acento="ambar"
      titulo="¿Cuánto podrías ganar y ahorrar"
      destacado="automatizando?"
      entradilla="Pon tus números y verás cuántas horas ahorrarías, cuánto podrías vender de más y en cuánto tiempo recuperarías la inversión. Es una estimación, los supuestos están más abajo y la inversión la pones tú. Funciona con cualquier moneda."
    >
      <ul class="garantias-roi mt-8" aria-label="Cómo funciona">
        <li><Icono nombre="reloj" tamano={18} /> Toma un minuto</li>
        <li><Icono nombre="escudo" tamano={18} /> No se envía ni se guarda nada</li>
        <li><Icono nombre="check" tamano={18} grosor={2.2} /> Fórmula a la vista</li>
      </ul>
    </CabeceraPagina>

    <section class="section" aria-labelledby="numeros-titulo" data-acento="ambar">
      <div class="container-lf calculadora">
        <form class="card formulario" data-roi-form novalidate>
          <div class="bloque-cabecera">
            <span class="numero-circulo" aria-hidden="true">1</span>
            <h2 id="numeros-titulo" class="card-title">Tus números</h2>
          </div>

          <div class="campos mt-5">
            {
              campos.map((c) => (
                <div class="campo">
                  <label for={`roi-${c.name}`}>{c.label}</label>
                  <input
                    id={`roi-${c.name}`}
                    type="number"
                    name={c.name}
                    inputmode="decimal"
                    min="0"
                    max={c.max || undefined}
                    step={c.step}
                    placeholder={c.ph}
                    aria-describedby={`pista-${c.name}`}
                  />
                  <p class="pista" id={`pista-${c.name}`}>
                    {c.pista}
                  </p>
                </div>
              ))
            }
          </div>

          <fieldset class="escenarios mt-5">
            <legend>Escenario</legend>
            <p class="pista">
              Qué parte de ese trabajo manual se logra automatizar. Son supuestos, no
              datos del mercado.
            </p>
            <div class="opciones mt-3">
              {
                escenarios.map((e, i) => (
                  <label class="opcion">
                    <input
                      type="radio"
                      name="scenario"
                      value={e.valor}
                      checked={i === 0}
                    />
                    <span>{e.etiqueta}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <button class="cta boton-calcular mt-8" type="submit">
            <Icono nombre="tendencia" tamano={18} />
            Ver mi estimación
          </button>
        </form>

        <div class="resultado card" id="roi-resultado" tabindex="-1">
          <div class="bloque-cabecera">
            <span class="numero-circulo" aria-hidden="true">2</span>
            <h2 class="card-title">Tu estimación</h2>
          </div>

          <p class="pista mt-3" data-roi-vacio>
            Escribe tus números: el resultado se actualiza mientras escribes.
          </p>

          <div class="destacado mt-5" data-roi-salida hidden>
            <p class="destacado-etiqueta">Beneficio estimado al mes</p>
            <p class="destacado-cifra" data-roi="total-grande">0</p>

            <div class="reparto mt-4" aria-hidden="true">
              <span class="reparto-ahorro" data-roi-barra="ahorro"></span>
              <span class="reparto-ventas" data-roi-barra="ventas"></span>
            </div>
            <ul class="leyenda mt-3" aria-hidden="true">
              <li><span class="punto punto-ahorro"></span> Ahorro en costos</li>
              <li><span class="punto punto-ventas"></span> Ventas extra</li>
            </ul>

            <div class="anual mt-6" data-roi-anual hidden aria-hidden="true">
              <p class="destacado-etiqueta">En 12 meses</p>
              <div class="anual-fila mt-3">
                <span>Inversión</span>
                <span class="anual-pista"><span class="anual-barra anual-inversion" data-roi-barra="inversion"></span></span>
                <span class="anual-valor" data-roi="inversion">0</span>
              </div>
              <div class="anual-fila mt-2">
                <span>Beneficio</span>
                <span class="anual-pista"><span class="anual-barra anual-beneficio" data-roi-barra="anual"></span></span>
                <span class="anual-valor" data-roi="anual">0</span>
              </div>
            </div>
          </div>

          <dl class="salidas mt-5" data-roi-salida hidden>
            <div>
              <dt>Horas liberadas al mes</dt>
              <dd data-roi="horas">—</dd>
            </div>
            <div>
              <dt>Ahorro en costos al mes</dt>
              <dd data-roi="ahorro">—</dd>
            </div>
            <div>
              <dt>Ventas extra al mes</dt>
              <dd data-roi="ingresos">—</dd>
            </div>
            <div>
              <dt>Beneficio estimado al mes</dt>
              <dd data-roi="total">—</dd>
            </div>
            <div>
              <dt>Recuperación de la inversión</dt>
              <dd data-roi="recuperacion">—</dd>
            </div>
            <div>
              <dt>ROI a 12 meses</dt>
              <dd data-roi="roi">—</dd>
            </div>
          </dl>

          <p class="pista mt-5">
            Es una estimación hecha solo con los datos que ingresaste y los supuestos
            de abajo. No es una promesa de resultados.
          </p>

          <a class="cta mt-6 boton-plan" href="/contacto">
            <Icono nombre="calendario" tamano={18} />
            Quiero un plan para mi negocio <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section banda" aria-labelledby="hipotesis-titulo" data-acento="ambar">
      <div class="container-lf hipotesis">
        <div class="hipotesis-lateral">
          <p class="eyebrow">Cómo se calcula</p>
          <h2 id="hipotesis-titulo" class="subrayado mt-4">La fórmula completa</h2>
        </div>
        <div class="card tarjeta">
        <p class="card-text mt-3">
          Estas son las cuentas exactas que hace la calculadora:
        </p>
        <ul class="lista mt-4">
          <li>
            <strong>Horas liberadas:</strong> tus horas semanales de tareas manuales
            × 4,33 semanas × el porcentaje del escenario (conservador 30%, realista
            50%, optimista 70%).
          </li>
          <li>
            <strong>Ahorro en costos:</strong> esas horas liberadas × tu costo por hora.
          </li>
          <li>
            <strong>Ventas extra:</strong> se supone que recuperas la mitad de los
            contactos que hoy pierdes por no responder a tiempo, y que compran en la
            misma proporción que el resto. Esos clientes × tu ticket promedio.
          </li>
          <li>
            <strong>Recuperación:</strong> tu inversión ÷ el beneficio mensual estimado.
          </li>
          <li>
            <strong>ROI a 12 meses:</strong> (beneficio mensual × 12 − inversión) ÷
            inversión.
          </li>
        </ul>
        <p class="card-text mt-4">
          Los porcentajes de cada escenario son supuestos de trabajo, no promedios
          del sector. Tu resultado real depende de cómo funciona tu negocio.
        </p>
        </div>
      </div>
    </section>

    <Cierre
      titulo="¿Pasamos de la estimación a un plan?"
      entradilla="En 30 minutos revisamos tus números reales y te digo qué automatizaría primero para conseguirlos. Sin compromiso."
    />
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-roi-form]");
  const salidas = [...document.querySelectorAll<HTMLElement>("[data-roi-salida]")];
  const vacio = document.querySelector<HTMLElement>("[data-roi-vacio]");
  const anual = document.querySelector<HTMLElement>("[data-roi-anual]");
  const resultado = document.querySelector<HTMLElement>("#roi-resultado");

  // Porcentaje de la carga manual que se asume automatizada en cada escenario.
  const FACTOR: Record<string, number> = {
    conservador: 0.3,
    realista: 0.5,
    optimista: 0.7,
  };

  const SEMANAS_MES = 4.33;

  // Sin símbolo de moneda: la web es para Latinoamérica y España, y cada
  // persona escribe las cifras en la suya.
  // useGrouping "always": en español el punto de miles se omite en cifras
  // de cuatro dígitos (1299 frente a 12.990) y la columna se leía desigual.
  const eur = new Intl.NumberFormat("es", { maximumFractionDigits: 0, useGrouping: "always" });
  const num = new Intl.NumberFormat("es", { maximumFractionDigits: 1 });

  function leer(nombre: string): number {
    const el = form?.elements.namedItem(nombre) as HTMLInputElement | null;
    const v = Number.parseFloat(el?.value ?? "");
    return Number.isFinite(v) && v >= 0 ? v : 0;
  }

  function escribir(clave: string, texto: string) {
    const el = document.querySelector(`[data-roi="${clave}"]`);
    if (el) el.textContent = texto;
  }

  // Las barras se dibujan con scaleX (de 0 a 1): solo transform, sin
  // recalcular el diseño de la página.
  function barra(clave: string, proporcion: number) {
    const el = document.querySelector<HTMLElement>(`[data-roi-barra="${clave}"]`);
    if (el) el.style.transform = `scaleX(${Math.max(0, Math.min(1, proporcion))})`;
  }

  function hayDatos(): boolean {
    return [...(form?.querySelectorAll<HTMLInputElement>("input[type=number]") ?? [])].some(
      (i) => i.value.trim() !== "",
    );
  }

  // Medición: alguien usó la calculadora (una vez por visita, sin cifras).
  let medido = false;
  function medir() {
    if (medido) return;
    medido = true;
    (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({
      event: "roi_calculator_use",
      page_path: location.pathname,
    });
  }

  function calcular() {
    if (!form) return;
    if (!hayDatos()) {
      salidas.forEach((s) => (s.hidden = true));
      if (vacio) vacio.hidden = false;
      return;
    }

    const leads = leer("leads");
    const ticket = leer("ticket");
    const conversion = Math.min(leer("conversion"), 100) / 100;
    const horasSemana = leer("hours");
    const costeHora = leer("cost");
    const perdidos = Math.min(leer("lost"), 100) / 100;
    const inversion = leer("investment");

    const escenario =
      (form.elements.namedItem("scenario") as RadioNodeList | null)?.value ??
      "conservador";
    const factor = FACTOR[escenario] ?? 0.3;

    const horasMes = horasSemana * SEMANAS_MES * factor;
    const ahorro = horasMes * costeHora;

    // Se asume recuperar la mitad de los leads que hoy se pierden.
    const leadsRecuperados = leads * perdidos * 0.5;
    const ingresos = leadsRecuperados * conversion * ticket;

    const total = ahorro + ingresos;

    escribir("horas", `${num.format(horasMes)} h`);
    escribir("ahorro", eur.format(ahorro));
    escribir("ingresos", eur.format(ingresos));
    escribir("total", eur.format(total));
    escribir("total-grande", eur.format(total));

    barra("ahorro", total > 0 ? ahorro / total : 0);
    barra("ventas", total > 0 ? ingresos / total : 0);

    // Con el beneficio redondeado, como se ve en pantalla: así 12 × la cifra
    // de arriba da exactamente el total anual.
    const anualTotal = Math.round(total) * 12;
    const tope = Math.max(inversion, anualTotal);
    if (anual) anual.hidden = !(inversion > 0 && tope > 0);
    if (tope > 0) {
      barra("inversion", inversion / tope);
      barra("anual", anualTotal / tope);
      escribir("inversion", eur.format(inversion));
      escribir("anual", eur.format(anualTotal));
    }

    if (inversion > 0 && total > 0) {
      const meses = inversion / total;
      escribir(
        "recuperacion",
        meses < 1 ? "menos de 1 mes" : `${num.format(meses)} meses`,
      );
      const roi = ((total * 12 - inversion) / inversion) * 100;
      escribir("roi", `${num.format(roi)} %`);
    } else {
      escribir("recuperacion", "—");
      escribir("roi", "—");
    }

    if (vacio) vacio.hidden = true;
    salidas.forEach((s) => (s.hidden = false));
  }

  form?.addEventListener("input", () => {
    calcular();
    if (hayDatos()) medir();
  });
  form?.addEventListener("change", calcular);

  // El botón sigue para quien lo busque: calcula y lleva al resultado
  // (útil en celular, donde queda debajo del formulario).
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    calcular();
    medir();
    resultado?.scrollIntoView({ block: "start" });
    resultado?.focus({ preventScroll: true });
  });
</script>

<style>
  .garantias-roi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-inline: 0;
    padding: 0;
    list-style: none;
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .garantias-roi li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .garantias-roi :global(svg) {
    color: var(--acento-texto);
  }

  /* ------------------------------------------------------ Calculadora */
  .calculadora {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (width >= 1024px) {
    .calculadora {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 2rem;
    }
    /* El resultado acompaña al bajar por el formulario. */
    .resultado {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .formulario,
  .resultado {
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
  }
  .resultado {
    border-color: rgb(251 191 36 / 0.3);
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(251 191 36 / 0.1), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent 40%),
      var(--color-surface);
  }
  .bloque-cabecera {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .card-title {
    font-size: var(--step-2);
  }
  .card-text {
    color: var(--color-soft);
  }
  .pista {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  /* Campos en dos columnas: el formulario se lee de un vistazo. */
  .campos {
    display: grid;
    gap: 1.25rem 1.5rem;
  }
  @media (width >= 640px) {
    .campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .campo {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  /* Las etiquetas reservan dos líneas: así las casillas quedan alineadas
     aunque una etiqueta sea más larga que su vecina. */
  @media (width >= 640px) {
    .campo label {
      min-height: 2.7em;
      display: flex;
      align-items: flex-end;
    }
  }
  .campo label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-ink);
  }
  .campo input {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: rgb(7 9 13 / 0.6);
    color: var(--color-ink);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    transition:
      border-color var(--dur-micro) var(--ease),
      box-shadow var(--dur-micro) var(--ease);
  }
  .campo input::placeholder {
    color: var(--color-muted);
  }
  .campo input:hover {
    border-color: rgb(255 255 255 / 0.25);
  }
  .campo input:focus {
    outline: none;
    border-color: var(--acento);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--acento) 25%, transparent);
  }

  .escenarios {
    margin: 0;
    padding: 1.25rem 0 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .escenarios legend {
    float: left;
    width: 100%;
    margin-bottom: 0.25rem;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--color-ink);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .opcion {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-soft);
    cursor: pointer;
    transition:
      border-color var(--dur-micro) var(--ease),
      background-color var(--dur-micro) var(--ease),
      color var(--dur-micro) var(--ease);
  }
  .opcion input {
    accent-color: var(--acento);
  }
  .opcion:hover {
    border-color: rgb(255 255 255 / 0.3);
  }
  .opcion:has(input:checked) {
    border-color: var(--acento);
    background: color-mix(in srgb, var(--acento) 12%, transparent);
    color: var(--color-ink);
  }
  .opcion:has(input:focus-visible) {
    outline: 3px solid var(--color-electric);
    outline-offset: 2px;
  }
  .boton-calcular,
  .boton-plan {
    width: 100%;
  }
  @media (width >= 640px) {
    .boton-calcular {
      width: auto;
    }
  }

  /* --------------------------------------------------------- Resultado */
  .salidas {
    display: grid;
    margin: 0;
  }
  .salidas > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-line);
  }
  .salidas dt {
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .salidas dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    text-align: right;
  }
  /* Beneficio y ROI, las dos cifras que más importan, destacadas. */
  .salidas > div:nth-child(4) dd,
  .salidas > div:nth-child(6) dd {
    color: var(--acento-texto);
    font-size: var(--step-2);
  }

  .resultado:focus {
    outline: none;
  }
  .destacado[hidden] {
    display: none;
  }
  .destacado-etiqueta {
    color: var(--color-soft);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .destacado-cifra {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--acento-texto);
    overflow-wrap: anywhere;
  }
  /* Reparto del beneficio: ahorro (turquesa) desde la izquierda y ventas
     extra (ámbar) desde la derecha. Las dos piezas suman el 100%. */
  .reparto,
  .anual-pista {
    position: relative;
    height: 0.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
  }
  .reparto span,
  .anual-barra {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .reparto-ahorro,
  .punto-ahorro {
    background: var(--color-teal);
  }
  .reparto-ventas,
  .punto-ventas {
    background: var(--acento-ambar);
  }
  .reparto .reparto-ventas {
    transform-origin: right;
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-soft);
    font-size: var(--step--1);
  }
