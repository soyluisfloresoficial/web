---
/**
 * Las guías gratis (30/10/2026), una por servicio: /guia/<slug>. Llegan por
 * correo al confirmar la suscripción (EMAIL-MARKETING.md). El contenido está
 * en src/data/guias.ts; aquí solo el diseño, igual para todas.
 *
 * Partes: el criterio (tres condiciones con su pregunta), una hoja para
 * rellenar, ideas por área, el plan de cinco pasos con sus señales de alto y
 * la invitación a la llamada desde el funnel del servicio.
 *
 * noindex y fuera del sitemap: son para quien las pidió y se apoyan en los
 * artículos del blog. Se pueden guardar en PDF (estilos de impresión).
 */
import Base from "../../layouts/Base.astro";
import Icono from "../../components/Icono.astro";
import { GUIAS, type Guia } from "../../data/guias";

export function getStaticPaths() {
  return Object.values(GUIAS).map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

const { g } = Astro.props as { g: Guia };
const llamada = `/diagnostico/${g.servicio}?utm_source=guia&utm_medium=web&utm_campaign=${g.slug}`;
---

<Base title={`Guía: ${g.titulo} ${g.destacado} | Luis Flores`} description={g.resumen} noindex>
  <main class="guia">
    <header class="section guia-portada">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">Guía práctica · Luis Flores</p>
        <h1 class="guia-h1 mt-4">{g.titulo} <span class="gradient-text">{g.destacado}</span></h1>
        <p class="lead mt-5">{g.entrada}</p>
        <div class="botones mt-8 no-imprimir">
          <button type="button" class="cta" data-imprimir>
            Guardar en PDF o imprimir
          </button>
          {g.articulo && <a class="boton-secundario" href={g.articulo.href}>{g.articulo.texto}</a>}
        </div>
      </div>
    </header>

    <section class="section banda" aria-labelledby="g-criterio" data-acento="violeta">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">1 · El criterio</p>
        <h2 id="g-criterio" class="subrayado mt-4">{g.criterio.titulo}</h2>
        <ol class="guia-condiciones mt-10">
          {
            g.criterio.puntos.map((c, n) => (
              <li class="card tarjeta">
                <span class="guia-num" aria-hidden="true">0{n + 1}</span>
                <h3 class="card-title mt-4">{c.titulo}</h3>
                <p class="card-text mt-3">{c.texto}</p>
                <p class="guia-pregunta mt-4">{c.pregunta}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="g-hoja" data-acento="turquesa">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">2 · Tu hoja</p>
        <h2 id="g-hoja" class="subrayado mt-4">{g.hoja.titulo}</h2>
        <p class="lead mt-5">{g.hoja.texto}</p>
        <div class="guia-tabla mt-8">
          <table>
            <thead>
              <tr>{g.hoja.columnas.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {Array.from({ length: g.hoja.filas }, () => (
                <tr>{g.hoja.columnas.map(() => <td />)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section banda" aria-labelledby="g-ideas" data-acento="cian">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">3 · Ideas para empezar</p>
        <h2 id="g-ideas" class="subrayado mt-4">{g.ideas.titulo}</h2>
        <div class="guia-areas mt-10">
          {
            g.ideas.grupos.map((a) => (
              <div class="card tarjeta">
                <span class="icono-caja" aria-hidden="true">
                  <Icono nombre={a.icono as never} tamano={22} grosor={1.6} />
                </span>
                <h3 class="card-title mt-4">{a.nombre}</h3>
                <ul class="lista-check mt-4">{a.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="g-plan" data-acento="ambar">
      <div class="container-lf guia-estrecha guia-dos">
        <div>
          <p class="eyebrow">4 · El plan</p>
          <h2 id="g-plan" class="subrayado mt-4">{g.plan.titulo}</h2>
          <ol class="guia-pasos mt-8">{g.plan.pasos.map((p) => <li>{p}</li>)}</ol>
          {g.plan.cierre && <p class="card-text mt-6">{g.plan.cierre}</p>}
        </div>
        <div class="card tarjeta">
          <p class="eyebrow">Señales de alto</p>
          <h3 class="card-title mt-4">{g.alto.titulo}</h3>
          <ul class="lista-cruz mt-5">{g.alto.items.map((a) => <li>{a}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section banda no-imprimir" aria-labelledby="g-llamada" data-acento="violeta">
      <div class="container-lf guia-estrecha guia-cierre">
        <h2 id="g-llamada" class="guia-cierre-titulo">¿Prefieres verlo con tu caso?</h2>
        <p class="lead mt-4">
          En una llamada gratis de 30 minutos me cuentas cómo trabajas y te digo qué
          haría primero, con qué herramienta y qué puedes esperar.
        </p>
        <div class="botones botones-centro mt-8">
          <a class="cta" href={llamada}>
            <Icono nombre="calendario" tamano={18} />
            Elegir día y hora <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelector("[data-imprimir]")?.addEventListener("click", () => window.print());
</script>

<style>
  .guia-estrecha {
    max-width: 62rem;
  }
  .guia-portada {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .guia-h1 {
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    line-height: var(--leading-titular);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .guia-condiciones,
  .guia-areas {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .guia-condiciones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .guia-areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .guia-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .guia-pregunta {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--acento);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--acento) 10%, transparent);
    color: var(--color-ink);
    font-weight: 600;
  }
  .guia-tabla {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
  }
  .guia-tabla table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
  }
  .guia-tabla th,
  .guia-tabla td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
  }
  .guia-tabla th {
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--step--1);
  }
  .guia-tabla td {
    height: 3rem;
  }
  .guia-tabla td + td,
  .guia-tabla th + th {
    border-left: 1px solid var(--color-line);
  }
  .guia-dos {
    display: grid;
    gap: 2.5rem;
  }
  @media (width >= 900px) {
    .guia-dos {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }
  .guia-pasos {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }
  .guia-pasos li {
    position: relative;
    padding-left: 3rem;
    color: var(--color-soft);
    counter-increment: paso;
  }
  .guia-pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: -0.1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--grad-cta);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .guia-cierre {
    text-align: center;
  }
  .guia-cierre .lead {
    margin-inline: auto;
  }
  .guia-cierre-titulo {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--color-ink);
  }

  /* Al imprimir o guardar en PDF: fondo blanco, texto oscuro y sin botones. */
  @media print {
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    :global(header.cabecera),
    :global(footer),
    :global(.barra-movil),
    :global(.chat),
    :global(.cintas),
    .no-imprimir {
      display: none !important;
    }
    .guia :global(*) {
      color: #111 !important;
      background: transparent !important;
      box-shadow: none !important;
      -webkit-text-fill-color: #111 !important;
    }
    .guia :global(.card),
    .guia-tabla,
    .guia-tabla th,
    .guia-tabla td {
      border-color: #bbb !important;
    }
    .guia :global(.section) {
      padding-block: 1.25rem !important;
    }
    .guia :global(.card) {
      break-inside: avoid;
    }
  }
</style>
