---
/**
 * Las guías gratis (30/10/2026), una por servicio: /guia/<slug>. Llegan por
 * correo al confirmar la suscripción (EMAIL-MARKETING.md). El contenido está
 * en src/data/guias.ts; aquí solo el diseño, igual para todas.
 *
 * Rediseño para que se entienda a la primera (2/11/2026):
 * - Ficha de arriba: para quién es, qué te llevas y cuánto tiempo te pide,
 *   con el autor (foto de Luis) y los cuatro pasos como índice.
 * - «Palabras que vas a leer»: los términos técnicos, explicados en simple.
 * - Cuatro pasos con nombres claros (Mira si te conviene, Anótalo, Elige
 *   ideas, Sigue el plan) en vez de «criterio» u «hoja».
 * - La hoja trae una fila de ejemplo. En el celular se ve el ejemplo en una
 *   tarjeta (una tabla vacía no se puede rellenar ahí) y la tabla completa
 *   sale al guardar en PDF o imprimir.
 * - Cierre con la foto y la voz de Luis.
 *
 * noindex y fuera del sitemap: son para quien las pidió y se apoyan en los
 * artículos del blog. Se pueden guardar en PDF (estilos de impresión).
 */
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icono from "../../components/Icono.astro";
import retrato from "../../assets/luis-flores-sobre-mi-azul.jpg";
import { GUIAS, type Guia } from "../../data/guias";
import { SITIO } from "../../data/servicios";

export function getStaticPaths() {
  return Object.values(GUIAS).map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

const { g } = Astro.props as { g: Guia };
const llamada = `/diagnostico/${g.servicio}?utm_source=guia&utm_medium=web&utm_campaign=${g.slug}`;
const pasos = [
  { id: "g-criterio", nombre: "Mira si te conviene" },
  { id: "g-hoja", nombre: "Anótalo" },
  { id: "g-ideas", nombre: "Elige ideas" },
  { id: "g-plan", nombre: "Sigue el plan" },
];
---

<Base title={`Guía: ${g.titulo} ${g.destacado} | Luis Flores`} description={g.resumen} noindex>
  <main class="guia">
    <header class="section guia-portada">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">Guía gratis · Luis Flores</p>
        <h1 class="guia-h1 mt-4">{g.titulo} <span class="gradient-text">{g.destacado}</span></h1>
        <p class="lead mt-5">{g.entrada}</p>

        <dl class="guia-ficha card mt-8">
          <div>
            <dt><Icono nombre="persona" tamano={18} /> Para quién es</dt>
            <dd>{g.paraQuien}</dd>
          </div>
          <div>
            <dt><Icono nombre="check" tamano={18} /> Qué te llevas</dt>
            <dd>{g.teLlevas}</dd>
          </div>
          <div>
            <dt><Icono nombre="reloj" tamano={18} /> Cuánto te lleva</dt>
            <dd>{g.tiempo}</dd>
          </div>
        </dl>

        <nav class="guia-indice mt-8 no-imprimir" aria-label="Pasos de la guía">
          <p class="guia-indice-titulo">Cómo usarla: cuatro pasos, en orden</p>
          <ol>
            {
              pasos.map((p, n) => (
                <li>
                  <a href={`#${p.id}`}>
                    <span aria-hidden="true">{n + 1}</span>
                    {p.nombre}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="guia-autor mt-8">
          <Image src={retrato} alt="" widths={[96, 144]} sizes="48px" class="guia-autor-foto" loading="eager" />
          <p>
            <strong>Escrita por {SITIO.nombre}.</strong> Implemento IA y automatizaciones para negocios de España y
            Latinoamérica. Lo que lees aquí es lo que reviso con cada cliente antes de empezar.
          </p>
        </div>

        <div class="botones mt-8 no-imprimir">
          <button type="button" class="cta" data-imprimir>
            Guardar en PDF o imprimir
          </button>
          {g.articulo && <a class="boton-secundario" href={g.articulo.href}>{g.articulo.texto}</a>}
        </div>
      </div>
    </header>

    <section class="section guia-glosario-seccion" aria-labelledby="g-glosario">
      <div class="container-lf guia-estrecha">
        <h2 id="g-glosario" class="guia-glosario-titulo">Palabras que vas a leer</h2>
        <dl class="guia-glosario mt-5">
          {
            g.glosario.map((t) => (
              <div>
                <dt>{t.termino}</dt>
                <dd>{t.significado}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="g-criterio" class="section banda" aria-labelledby="g-criterio-t" data-acento="violeta">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">Paso 1 · Mira si te conviene</p>
        <h2 id="g-criterio-t" class="subrayado mt-4">{g.criterio.titulo}</h2>
        <p class="lead mt-5">Lee cada punto y responde la pregunta pensando en tu negocio. Si los tres te encajan, vas bien.</p>
        <ol class="guia-condiciones mt-10">
          {
            g.criterio.puntos.map((c, n) => (
              <li class="card tarjeta">
                <span class="guia-num" aria-hidden="true">0{n + 1}</span>
                <h3 class="card-title mt-4">{c.titulo}</h3>
                <p class="card-text mt-3">{c.texto}</p>
                <p class="guia-pregunta mt-4">
                  <span class="guia-pregunta-etiqueta">Pregúntate</span>
                  {c.pregunta}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="g-hoja" class="section" aria-labelledby="g-hoja-t" data-acento="turquesa">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">Paso 2 · Anótalo</p>
        <h2 id="g-hoja-t" class="subrayado mt-4">{g.hoja.titulo}</h2>
        <p class="lead mt-5">{g.hoja.texto}</p>

        <div class="guia-ejemplo mt-8">
          <p class="guia-ejemplo-etiqueta">Así se rellena una fila (ejemplo)</p>
          <dl>
            {
              g.hoja.columnas.map((c, i) => (
                <div>
                  <dt>{c}</dt>
                  <dd>{g.ejemplo[i] ?? ""}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="guia-movil-nota mt-6 no-imprimir">
          En el celular es más cómodo copiar estas columnas en un cuaderno o en las notas del teléfono. Si la quieres
          como tabla, toca «Guardar en PDF o imprimir».
        </p>

        <div class="guia-tabla mt-8">
          <table>
            <thead>
              <tr>{g.hoja.columnas.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              <tr class="guia-fila-ejemplo">
                {g.hoja.columnas.map((_, i) => <td>{g.ejemplo[i] ?? ""}</td>)}
              </tr>
              {Array.from({ length: g.hoja.filas }, () => (
                <tr>{g.hoja.columnas.map(() => <td />)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="g-ideas" class="section banda" aria-labelledby="g-ideas-t" data-acento="cian">
      <div class="container-lf guia-estrecha">
        <p class="eyebrow">Paso 3 · Elige ideas</p>
        <h2 id="g-ideas-t" class="subrayado mt-4">{g.ideas.titulo}</h2>
        <p class="lead mt-5">No hace falta hacerlo todo. Marca una o dos cosas que veas claras para tu caso.</p>
        <div class="guia-areas mt-10">
          {
            g.ideas.grupos.map((a) => (
              <div class="card tarjeta">
                <span class="icono-caja" aria-hidden="true">
                  <Icono nombre={a.icono as never} tamano={22} grosor={1.6} />
                </span>
                <h3 class="card-title mt-4">{a.nombre}</h3>
                <ul class="lista-check mt-4">{a.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="g-plan" class="section" aria-labelledby="g-plan-t" data-acento="ambar">
      <div class="container-lf guia-estrecha guia-dos">
        <div>
          <p class="eyebrow">Paso 4 · Sigue el plan</p>
          <h2 id="g-plan-t" class="subrayado mt-4">{g.plan.titulo}</h2>
          <ol class="guia-pasos mt-8">{g.plan.pasos.map((p) => <li>{p}</li>)}</ol>
          {g.plan.cierre && <p class="card-text mt-6">{g.plan.cierre}</p>}
        </div>
        <div class="card tarjeta">
          <p class="eyebrow">Antes de empezar, revisa</p>
          <h3 class="card-title mt-4">{g.alto.titulo}</h3>
          <ul class="lista-cruz mt-5">{g.alto.items.map((a) => <li>{a}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section banda no-imprimir" aria-labelledby="g-llamada" data-acento="violeta">
      <div class="container-lf guia-estrecha guia-cierre">
        <Image src={retrato} alt={`${SITIO.nombreCompleto}`} widths={[160, 240]} sizes="96px" class="guia-cierre-foto" loading="lazy" />
        <h2 id="g-llamada" class="guia-cierre-titulo mt-6">¿Prefieres verlo con tu caso?</h2>
        <p class="lead mt-4">
          En una llamada gratis de 30 minutos me cuentas cómo trabajas y te digo qué haría primero, con qué herramienta y
          qué puedes esperar. Sin compromiso: si no tiene sentido trabajar juntos, te lo digo.
        </p>
        <div class="botones botones-centro mt-8">
          <a class="cta" href={llamada}>
            <Icono nombre="calendario" tamano={18} />
            Elegir día y hora <span aria-hidden="true">→</span>
          </a>
          <a class="boton-secundario" href={SITIO.whatsapp} rel="noopener">
            <Icono nombre="whatsapp" tamano={18} />
            Prefiero WhatsApp
          </a>
        </div>
        <p class="guia-firma mt-8">Luis</p>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelector("[data-imprimir]")?.addEventListener("click", () => window.print());
</script>

<style>
  .guia-estrecha {
    max-width: 62rem;
  }
  .guia-portada {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .guia-h1 {
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    line-height: var(--leading-titular);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* Ficha: para quién, qué te llevas, cuánto te lleva. */
  .guia-ficha {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-color: color-mix(in srgb, var(--color-electric) 35%, var(--color-line));
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(139 92 246 / 0.14), transparent 70%),
      var(--color-surface);
  }
  @media (width >= 768px) {
    .guia-ficha {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .guia-ficha dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-electric-soft);
  }
  .guia-ficha dd {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    line-height: 1.5;
  }

  /* Índice de los cuatro pasos. */
  .guia-indice-titulo {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-soft);
  }
  .guia-indice ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .guia-indice ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .guia-indice a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .guia-indice a:hover {
    border-color: var(--color-electric);
  }
  .guia-indice a span {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--grad-cta);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }

  /* Autor. */
  .guia-autor {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--color-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .guia-autor strong {
    color: var(--color-ink);
  }
  .guia-autor :global(.guia-autor-foto) {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--color-navy), 0 0 0 4px rgb(0 123 255 / 0.6);
  }

  /* Glosario. */
  .guia-glosario-seccion {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .guia-glosario-titulo {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--color-ink);
  }
  .guia-glosario {
    display: grid;
    gap: 0.875rem;
    margin: 0;
  }
  @media (width >= 768px) {
    .guia-glosario {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .guia-glosario div {
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .guia-glosario dt {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-ink);
  }
  .guia-glosario dd {
    margin: 0.35rem 0 0;
    color: var(--color-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .guia-condiciones,
  .guia-areas {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (width >= 768px) {
    .guia-condiciones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .guia-areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .guia-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .guia-pregunta {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--acento);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--acento) 10%, transparent);
    color: var(--color-ink);
    font-weight: 600;
  }
  .guia-pregunta-etiqueta {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--acento-texto);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Ejemplo de la hoja: tarjeta en el celular, fila dentro de la tabla en
     pantallas grandes y al imprimir. */
  .guia-ejemplo {
    padding: 1.125rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--acento) 60%, var(--color-line));
    border-radius: 14px;
    background: color-mix(in srgb, var(--acento) 8%, transparent);
  }
  .guia-ejemplo-etiqueta {
    color: var(--acento-texto);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
  }
  .guia-ejemplo dl {
    display: grid;
    gap: 0.625rem;
    margin: 0.875rem 0 0;
  }
  .guia-ejemplo dt {
    color: var(--color-soft);
    font-size: 0.8125rem;
  }
  .guia-ejemplo dd {
    margin: 0.1rem 0 0;
    color: var(--color-ink);
    font-weight: 600;
  }
  .guia-movil-nota {
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .guia-tabla {
    display: none;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
  }
  @media (width >= 768px) {
    .guia-ejemplo,
    .guia-movil-nota {
      display: none;
    }
    .guia-tabla {
      display: block;
    }
  }
  .guia-tabla table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
  }
  .guia-tabla th,
  .guia-tabla td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
  }
  .guia-tabla th {
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--step--1);
  }
  .guia-tabla td {
    height: 3rem;
  }
  .guia-fila-ejemplo td {
    color: var(--color-soft);
    font-size: var(--step--1);
    font-style: italic;
    background: color-mix(in srgb, var(--acento) 7%, transparent);
  }
  .guia-fila-ejemplo td:first-child::before {
    content: "Ejemplo: ";
    color: var(--acento-texto);
    font-style: normal;
    font-weight: 700;
  }
  .guia-tabla td + td,
  .guia-tabla th + th {
    border-left: 1px solid var(--color-line);
  }

  .guia-dos {
    display: grid;
    gap: 2.5rem;
  }
  @media (width >= 900px) {
    .guia-dos {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }
  .guia-pasos {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }
  .guia-pasos li {
    position: relative;
    padding-left: 3rem;
    color: var(--color-soft);
    counter-increment: paso;
  }
  .guia-pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: -0.1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--grad-cta);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .guia-cierre {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .guia-cierre .lead {
    margin-inline: auto;
  }
  .guia-cierre :global(.guia-cierre-foto) {
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--color-navy), 0 0 0 6px rgb(139 92 246 / 0.6);
  }
  .guia-cierre-titulo {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--color-ink);
  }
  .guia-firma {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    font-style: italic;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Al imprimir o guardar en PDF: fondo blanco, texto oscuro, la tabla
     completa y sin botones. */
  @media print {
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    :global(header.cabecera),
    :global(footer),
    :global(.barra-movil),
    :global(.chat),
    :global(.cintas),
    .no-imprimir {
      display: none !important;
    }
    .guia-ejemplo {
      display: none !important;
    }
    .guia-tabla {
      display: block !important;
    }
    .guia :global(*) {
      color: #111 !important;
      background: transparent !important;
      box-shadow: none !important;
      -webkit-text-fill-color: #111 !important;
    }
    .guia :global(.card),
    .guia-tabla,
    .guia-tabla th,
    .guia-tabla td,
    .guia-glosario div {
      border-color: #bbb !important;
    }
    .guia :global(.section) {
      padding-block: 1.25rem !important;
    }
    .guia :global(.card),
    .guia-glosario div {
      break-inside: avoid;
    }
  }
</style>
