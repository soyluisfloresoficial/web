---
import Base from "../layouts/Base.astro";
import { servicios } from "../data/servicios";

const title = "Página no encontrada: error 404 en el sitio | Luis Flores";
const description =
  "La página que buscas no existe o ha cambiado de dirección. Desde aquí puedes ir a los servicios, al blog o reservar una llamada de diagnóstico.";
---

{/* El 404 no necesita noindex: el propio código de estado ya se lo dice a los
    buscadores. Lo que sí necesita es ser útil. */}
<Base title={title} description={description}>
  <main class="container-lf pagina404">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3">Esta página no existe</h1>
    <p class="lead mt-5 max-w-[56ch]">
      O la dirección ha cambiado, o el enlace que has seguido está roto. No te
      quedes aquí: abajo tienes todo lo que hay en la web.
    </p>

    <a class="cta mt-8 inline-flex items-center gap-2" href="/contacto">
      Reservar diagnóstico <span aria-hidden="true">→</span>
    </a>

    <h2 class="h-pequeno mt-12">Servicios</h2>
    <ul class="grid-3 mt-4">
      {
        servicios.map((s) => (
          <li class="card p-5" style={`--svc: var(${s.color})`}>
            <h3 class="card-title">{s.nombre}</h3>
            <p class="card-text mt-2">{s.resumen}</p>
            <a class="card-link mt-3 inline-block" href={`/servicios/${s.slug}`}>
              Ver servicio <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="h-pequeno mt-12">Otras páginas</h2>
    <ul class="enlaces mt-4">
      <li><a href="/">Inicio</a></li>
      <li><a href="/servicios">Todos los servicios</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/sobre-mi">Sobre mí</a></li>
      <li><a href="/roi">Calculadora ROI</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
  </main>
</Base>

<style>
  .pagina404 {
    padding-block: var(--space-6) var(--space-8);
  }
  .lead {
    color: var(--color-soft);
    font-size: var(--step-1);
  }
  .h-pequeno {
    font-size: var(--step-2);
  }
  .card-title {
    font-size: var(--step-2);
  }
  .card-text {
    color: var(--color-soft);
  }
  .card-link {
    color: var(--svc, var(--color-electric-soft));
    font-weight: 700;
  }

  .grid-3 {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    /* Sin margen arriba: lo pone la clase mt-* del marcado. Con
       margin: 0 aquí, la clase no se aplicaba y el título quedaba pegado. */
    margin-inline: 0;
    margin-bottom: 0;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .enlaces a {
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta {
    background: var(--grad-cta);
    color: #fff;
    border-radius: 999px;
    padding: 0.875rem 1.5rem;
    font-weight: 700;
    box-shadow: var(--shadow-cta);
  }

  @media (width >= 640px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width >= 1024px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
