---
/**
 * /recursos/<slug> (17/11/2026): la página de cada recurso gratuito que se
 * entrega en los CTA de los videos y carruseles («Comenta FLUJO…»). Es el
 * enlace que manda ManyChat o WhatsApp. Ver RECURSOS.md.
 *
 * El contenido sale de video/recursos/<slug>.md y el PDF de
 * public/recursos/<slug>.pdf. Descarga sin pedir correo; debajo se ofrece la
 * guía del servicio relacionado (con su formulario y la serie de correos).
 */
import Base from "../../layouts/Base.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import CapturaGuia from "../../components/CapturaGuia.astro";
import Icono from "../../components/Icono.astro";
import { RECURSOS, contenidoRecurso, pdfRecurso, type Recurso } from "../../data/recursos";
import { guiaDeServicio } from "../../data/guias";
import { SITIO } from "../../data/servicios";

export function getStaticPaths() {
  return RECURSOS.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: Recurso };
const c = contenidoRecurso(r.slug);
const url = `${SITIO.url}/recursos/${r.slug}`;
const title = `${r.formato} gratis: ${r.titulo} | Luis Flores`;
const guia = guiaDeServicio(r.servicio);
const schema = [
  {
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: title,
    description: r.descripcion,
    isPartOf: { "@id": `${SITIO.url}/#website` },
    inLanguage: "es",
    datePublished: r.fecha,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITIO.url}/` },
      { "@type": "ListItem", position: 2, name: "Recursos gratis", item: `${SITIO.url}/recursos` },
      { "@type": "ListItem", position: 3, name: r.titulo, item: url },
    ],
  },
];
---

<Base title={title} description={r.descripcion} schema={schema}>
  <main>
    <CabeceraPagina
      migas={[{ texto: "Inicio", href: "/" }, { texto: "Recursos gratis", href: "/recursos" }, { texto: r.titulo }]}
      antetitulo={`${r.formato} gratis`}
      titulo={r.titulo}
      entradilla={r.descripcion}
      acento="violeta"
    />

    <section class="section recurso-descarga" aria-labelledby="recurso-descarga-t" data-ubicacion="recurso-descarga">
      <div class="container-lf recurso-estrecho">
        <div class="card recurso-caja">
          <p class="eyebrow">{r.origen}</p>
          <h2 id="recurso-descarga-t" class="recurso-caja-titulo mt-3">Descárgalo en PDF</h2>
          <p class="card-text mt-3">Una página, lista para imprimir o rellenar. Abajo tienes el mismo contenido para leerlo aquí.</p>
          <div class="botones mt-6">
            <a class="cta" href={pdfRecurso(r.slug)} download data-recurso={r.slug}>
              <Icono nombre="flecha" tamano={18} /> Descargar PDF
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section banda" aria-labelledby="recurso-contenido-t" data-acento="turquesa">
      <div class="container-lf recurso-estrecho">
        <h2 id="recurso-contenido-t" class="subrayado">{c.titular}</h2>
        {
          c.secciones.map((s) => (
            <div class="recurso-seccion mt-10">
              <h3 class="card-title">{s.titulo}</h3>
              {s.puntos.length > 0 && <ul class="lista-check mt-4">{s.puntos.map((p) => <li>{p}</li>)}</ul>}
              {s.texto.map((t) => <p class="card-text mt-3">{t}</p>)}
            </div>
          ))
        }
        {c.cierre.map((t) => <p class="recurso-nota mt-10">{t}</p>)}
      </div>
    </section>

    <CapturaGuia ubicacion={`recurso-${r.slug}`} guia={guia.slug} titulo={`¿Quieres ir más allá? ${guia.titulo} ${guia.destacado}`} />

    <section class="section" aria-labelledby="recurso-llamada-t">
      <div class="container-lf recurso-estrecho recurso-llamada">
        <h2 id="recurso-llamada-t" class="recurso-caja-titulo">¿Lo vemos con tu negocio?</h2>
        <p class="card-text mt-3">Si prefieres que lo diseñemos juntos, agenda una llamada de diagnóstico gratis o escríbeme por WhatsApp.</p>
        <div class="botones mt-6">
          <a class="cta" href={`/diagnostico/${r.servicio}?utm_source=recurso&utm_medium=web&utm_campaign=${r.slug}`}>Agendar la llamada</a>
          <a class="boton-secundario" href={SITIO.whatsapp}>Escribir por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .recurso-estrecho {
    max-width: 52rem;
  }
  .recurso-caja {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .recurso-caja-titulo {
    font-family: var(--font-display, Manrope, sans-serif);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1.15;
  }
  .recurso-seccion .lista-check li {
    margin-top: 0.5rem;
  }
  .recurso-nota {
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .recurso-llamada {
    text-align: center;
  }
  .recurso-llamada .botones {
    justify-content: center;
  }
</style>
