---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { servicios, SITIO, AREA_SERVIDA, PILARES, serviciosDe } from "../data/servicios";
import { fugas, publicos, herramientas, estandares, proceso, faq, faqPlana, queMido } from "../data/home";
import Showcase from "../components/Showcase.astro";
import heroImg from "../assets/luis-flores-monitores.jpg";
import retratoImg from "../assets/luis-flores-sobre-mi-azul.jpg";
import Icono from "../components/Icono.astro";
import Cierre from "../components/Cierre.astro";
import CintasLuz from "../components/CintasLuz.astro";
import PruebaSocial from "../components/PruebaSocial.astro";
import { logos } from "../data/logos";
import { ilustraciones } from "../data/ilustraciones";

// Iconos de cada bloque, en el mismo orden que los datos de home.ts.
const iconosFugas = ["reloj", "flujo", "calendarioOk"] as const;
const iconosPublicos = ["persona", "birrete", "corazon", "edificio"] as const;
const iconosMetricas = ["tendencia", "reloj", "calendarioOk"] as const;
const iconosEstandares = ["brujula", "flujo", "escudo", "robot", "web", "tendencia"] as const;

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{jpg,webp}",
  { eager: true },
);

function imagenDe(nombre: string) {
  // Sin nombre no hay foto. Ojo: "../assets/" contiene "/." y, con el nombre
  // vacío, la búsqueda de abajo devolvía la primera imagen que encontrara.
  if (!nombre) return undefined;
  const clave = Object.keys(imagenes).find((k) => k.includes(`/${nombre}.`));
  return clave ? imagenes[clave].default : undefined;
}

const title = "Consultor de IA y automatización para pymes | Luis Flores";
const description =
  "Implemento agentes de IA, automatizaciones y embudos de venta para pymes de Latinoamérica y España. Agenda una llamada gratis de 30 minutos.";

// Los tres artículos más recientes, para enlazarlos desde la home.
const ultimos = (await getCollection("blog"))
  .sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime())
  .slice(0, 3);
// Barras decorativas de la banda de la calculadora: proporciones de dibujo.
const barrasRoi: [string, number][] = [
  ["Horas/mes", 0.7],
  ["Ingresos/mes", 0.55],
  ["Recuperación", 0.38],
  ["ROI 12 meses", 0.85],
];
const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es", { day: "numeric", month: "short", year: "numeric" });

const schema = [
  {
    // Nodo de la propia página: une el FAQ y la lista de servicios con el
    // sitio y con la persona. Sin dateModified a propósito: no hay una fecha
    // de cambio real que poner, y una inventada es ruido.
    "@type": "WebPage",
    "@id": `${SITIO.url}/#webpage`,
    url: `${SITIO.url}/`,
    name: title,
    description,
    inLanguage: "es",
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "ItemList",
    "@id": `${SITIO.url}/#servicios`,
    name: "Servicios",
    itemListElement: servicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nombre,
      url: `${SITIO.url}/servicios/${s.slug}`,
    })),
  },
  {
    "@type": "ProfessionalService",
    "@id": `${SITIO.url}/#servicio`,
    name: SITIO.nombre,
    url: `${SITIO.url}/`,
    image: `${SITIO.url}/og-default.png`,
    description:
      "Agentes de IA, automatización y embudos de venta para pymes y emprendedores.",
    areaServed: AREA_SERVIDA,
    founder: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "FAQPage",
    "@id": `${SITIO.url}/#faq`,
    isPartOf: { "@id": `${SITIO.url}/#webpage` },
    mainEntity: faqPlana.map((p) => ({
      "@type": "Question",
      name: p.pregunta,
      acceptedAnswer: { "@type": "Answer", text: p.respuesta },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main class="con-cintas">
    <CintasLuz />
    {/* ------------------------------------------------------------------ Hero */}
    {/* Estilo de producción: foto fundida con el fondo a la derecha, tres
        tarjetas de cristal flotando sobre ella y una fila de claves con
        iconos. Con los arreglos del análisis: nota legible, sin animaciones
        continuas de adorno y con el asterisco enlazado a cómo se midió. */}
    <section class="hero" aria-labelledby="hero-titulo">
      <div class="hero-luz" aria-hidden="true"></div>

      <div class="container-lf hero-contenido">
        <div class="hero-texto">
          <p class="insignia">
            <span class="insignia-punto" aria-hidden="true"></span>
            <span>IA aplicada · Latinoamérica y España</span>
          </p>

          {/* Titular (23/10/2026): lo que hago, dicho literal. Sin cifras de
              horas ni promesas: el degradado va a la acción concreta. */}
          {/* Cuatro líneas cortas a propósito: a 52 px la columna del hero
              (500 px) solo admite unos 20 caracteres, y las líneas largas se
              partían solas por donde no tocaba. */}
          {/* Los {" "} separan las líneas en el texto extraído: los <span> son
              bloques, así que no cambian el diseño, pero sin ellos el H1 se lee
              «Automatizolo que hoy hacesa mano: mensajes,citas». */}
          <h1 id="hero-titulo" class="mt-5">
            <span class="hero-line-grad block">
              <span class="gradient-text">Automatizo</span>
            </span>{" "}
            <span class="hero-line-2 block">lo que hoy haces</span>{" "}
            <span class="hero-line-2 block">a mano: mensajes,</span>{" "}
            <span class="hero-line-2 block">citas y seguimiento.</span>
          </h1>

          <p class="lead hero-lead mt-6">
            <span class="hero-pretitulo">IA · automatización · funnels</span>
            Implemento agentes de IA, automatizaciones y embudos de venta para
            pymes y emprendedores de Latinoamérica y España. En una llamada de 30
            minutos te digo qué conviene automatizar primero.
          </p>

          <ul class="claves mt-8" aria-label="Qué implemento">
            <li>
              <Icono nombre="globo" tamano={30} grosor={1.5} degradado />
              <span>Páginas web<br />que piden la cita</span>
            </li>
            <li>
              <Icono nombre="embudo" tamano={30} grosor={1.5} degradado />
              <span>Funnels de<br />conversión</span>
            </li>
            <li>
              <Icono nombre="chipIa" tamano={30} grosor={1.5} degradado />
              <span>Automatización<br />y agentes de IA</span>
            </li>
          </ul>

          <div class="botones mt-8">
            <a class="cta" href="/contacto">
              <Icono nombre="calendario" tamano={18} />
              Agenda tu llamada gratis <span aria-hidden="true">→</span>
            </a>
            <p class="nota-escudo">
              <Icono nombre="escudo" tamano={22} grosor={1.5} />
              <span>Llamada de 30 min<br />gratuita y sin compromiso</span>
            </p>
          </div>

          <p class="hero-prueba mt-6">
            <Icono nombre="check" tamano={15} grosor={2.4} class="hero-prueba-check" />
            <span>
              <b>Probado primero en mi negocio</b> · documentación incluida ·
              creador de <a href="https://smilbot.com" rel="noopener">Smilbot</a>,
              recepcionista de IA para clínicas dentales
            </span>
          </p>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-foto">
          <Image
            src={heroImg}
            alt="Luis Carlos Flores en su puesto de trabajo, frente a dos monitores con paneles de automatización"
            widths={[420, 640, 720, 860, 1086]}
            sizes="(min-width: 1024px) 35vw, (min-width: 768px) 62vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="foto-hero"
          />
          <span class="hero-sombra" aria-hidden="true"></span>
        </div>

        <div class="hero-tarjetas">
          <div class="flotante flotante-metrica">
            <div class="flotante-fila">
              <span class="flotante-icono flotante-icono-turquesa">
                <Icono nombre="chat" tamano={17} grosor={2} />
              </span>
              <p>
                <span class="flotante-titulo">Respuesta en segundos</span>
                <span class="flotante-texto">También a las 22:14</span>
              </p>
            </div>
            {/* Conversación de ejemplo, ilustrativa: no es de un cliente. */}
            <div class="mini-chat" aria-hidden="true">
              <span class="mini-burbuja mini-cliente">¿Tienen hora mañana?</span>
              <span class="mini-burbuja mini-agente">Sí, a las 10:00. ¿Te la agendo?</span>
            </div>
          </div>

          <div class="flotante flotante-2">
            <div class="flotante-fila">
              <span class="flotante-icono flotante-icono-whatsapp">
                <Icono nombre="whatsapp" tamano={19} grosor={1.9} />
              </span>
              <p>
                <span class="flotante-titulo">Atención 24/7</span>
                <span class="flotante-texto">por WhatsApp</span>
              </p>
            </div>
          </div>

          <div class="flotante flotante-3">
            <div class="flotante-fila">
              <span class="flotante-icono anillo-degradado">
                <Icono nombre="chipIa" tamano={19} grosor={1.9} />
              </span>
              <p>
                <span class="flotante-titulo">Agentes de IA</span>
                <span class="flotante-texto">que contestan y agendan</span>
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    {/* -------------------------------------------------------------- Problema */}
    <section class="section banda" aria-labelledby="problema-titulo" data-acento="coral">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">El problema</p>
            <h2 id="problema-titulo" class="subrayado mt-4">Si tienes un negocio, seguro te pasa esto</h2>
          </div>
          <p class="lead">
            El día no alcanza para todo. Estos son los tres problemas que más veo
            antes de automatizar.
          </p>
        </div>

        <ul class="grid-3 mt-12">
          {
            fugas.map((f, i) => (
              <li class="card tarjeta reveal">
                <span class="icono-caja" aria-hidden="true">
                  <Icono nombre={iconosFugas[i]} tamano={22} grosor={1.6} />
                </span>
                <h3 class="card-title mt-5">{f.titulo}</h3>
                <p class="card-text mt-3">{f.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* --------------------------------------------------------------- Público */}
    <section class="section seccion-corta" aria-labelledby="publico-titulo" data-acento="cian">
      <div class="container-lf">
        <h2 id="publico-titulo" class="antetitulo-blanco">Trabajo con negocios que quieren crecer</h2>
        <ul class="perfiles mt-8">
          {
            publicos.map((p, i) => (
              <li class="perfil">
                <span class="anillo-degradado anillo-grande" aria-hidden="true">
                  <Icono nombre={iconosPublicos[i]} tamano={24} grosor={1.6} degradado />
                </span>
                <span>
                  <span class="perfil-titulo">{p.titulo}</span>
                  <span class="perfil-texto">{p.texto}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------- Herramientas */}
    <section class="seccion-herramientas" aria-labelledby="herramientas-titulo">
      <div class="container-lf herramientas-cabecera">
        <h2 id="herramientas-titulo" class="antetitulo-blanco">
          Trabajo con las herramientas que ya usas
        </h2>
        <p class="card-text">
          Si usas otras, primero reviso si se pueden conectar.
        </p>
      </div>

      <div class="marquee mt-6">
        {
          [false, true].map((copia) => (
            <ul class="marquee-track" aria-label={copia ? undefined : "Herramientas con las que trabajo"} aria-hidden={copia ? "true" : undefined}>
              {herramientas.map((h) => (
                <li class="herramienta" style={logos[h]?.color ? `--marca: ${logos[h].color}` : undefined}>
                  {logos[h]?.d ? (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d={logos[h].d} />
                    </svg>
                  ) : (
                    <span class="logo-inicial" aria-hidden="true">{h[0]}</span>
                  )}
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------- Servicios */}
    <section class="section banda" aria-labelledby="servicios-titulo">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 id="servicios-titulo" class="subrayado mt-4">
              Nueve servicios, tres frentes
            </h2>
          </div>
          <div class="cabecera-columna">
            <p class="lead">
              Primero que te lleguen consultas, luego que no se enfríen y por
              último que el proceso aguante sin ti. Empezamos por el frente que
              más te esté apretando; yo lo implemento y te lo dejo documentado.
            </p>
            <a class="boton-secundario mt-6" href="/servicios">
              Ver todos los servicios <Icono nombre="flecha" tamano={18} />
            </a>
          </div>
        </div>

        {/* Los nueve servicios, agrupados en los tres frentes de PILARES.
            Siguen saliendo de un único array: aquí solo se ordenan. */}
        {
          PILARES.map((pilar) => (
            <div class="pilar mt-12">
              <div class="pilar-cabecera reveal">
                <span class="pilar-icono" aria-hidden="true">
                  <Icono nombre={pilar.icono} tamano={20} grosor={1.8} />
                </span>
                <h3 class="pilar-nombre">{pilar.nombre}</h3>
                <p class="pilar-texto">{pilar.descripcion}</p>
              </div>

              <ul class="services-grid mt-6">
                {serviciosDe(pilar).map((s) => {
                  const img = imagenDe(s.imagen);
                  const ilus = ilustraciones[s.slug];
                  return (
                    <li
                      class="card card-interactiva tarjeta-servicio reveal overflow-hidden"
                      style={`--svc: var(${s.color})`}
                    >
                      <div class={`media duotono${ilus ? " media-ilus" : ""}`}>
                        {ilus ? (
                          <Fragment set:html={ilus} />
                        ) : (
                          img && (
                            <Image
                              src={img}
                              alt={s.imagenAlt}
                              widths={[320, 640]}
                              sizes="(min-width: 1024px) 30vw, 100vw"
                              loading="lazy"
                              class="aspect-[16/9] w-full object-cover"
                            />
                          )
                        )}
                        <span class="distintivo" aria-hidden="true">
                          <Icono nombre={s.icono} tamano={18} grosor={1.8} />
                        </span>
                      </div>
                      <div class="tarjeta-cuerpo">
                        <h4 class="card-title">{s.nombre}</h4>
                        <p class="card-text mt-2">{s.resumen}</p>
                        <a class="card-link" href={`/servicios/${s.slug}`}>
                          Ver el servicio <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }

        <div class="caja-cta mt-10 reveal">
          <p>
            <strong>¿No sabes por cuál empezar?</strong> En 30 minutos reviso tu caso
            y te digo qué automatizar primero.
          </p>
          <a class="cta" href="/contacto">
            <Icono nombre="calendario" tamano={18} />
            Agenda tu llamada gratis <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <Showcase />

    {/* -------------------------------------------------------------- Métricas */}
    <section class="section banda" aria-labelledby="metricas-titulo" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Resultados medibles</p>
            <h2 id="metricas-titulo" class="subrayado mt-4">Lo que mido en cada proyecto</h2>
          </div>
          <p class="lead">
            No te doy cifras antes de conocer tu negocio. Lo que sí hago es medir
            antes y después, con tus propias herramientas, para que veas el cambio
            con datos.
          </p>
        </div>
        <ul class="grid-3 mt-12">
          {
            queMido.map((m, i) => (
              <li class="card tarjeta medida reveal">
                <span class="anillo-degradado anillo-medio" aria-hidden="true">
                  <Icono nombre={iconosMetricas[i]} tamano={20} grosor={1.8} degradado />
                </span>
                <h3 class="card-title mt-5">{m.titulo}</h3>
                <p class="card-text mt-2">{m.texto}</p>
                <p class="medida-como">
                  <span>Cómo lo mido</span>
                  {m.como}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------------------------------------------------- Calculadora */}
    <section class="section" aria-labelledby="roi-titulo" data-acento="ambar">
      <div class="container-lf">
        <div class="card roi reveal">
          <div class="fondo-reticula" aria-hidden="true"></div>
          <div>
            <p class="eyebrow">Calculadora de ROI</p>
            <h2 id="roi-titulo" class="mt-4">Pon tus números y mira cuánto podrías ahorrar</h2>
            <p class="lead mt-4">
              Calcula cuántas horas ahorrarías al mes, cuánto podrías vender de
              más y en cuánto tiempo recuperarías la inversión. Es una estimación
              con supuestos a la vista, y la inversión la pones tú.
            </p>
            <a class="cta mt-8" href="/roi">
              <Icono nombre="tendencia" tamano={18} />
              Calcular mi caso <span aria-hidden="true">→</span>
            </a>
          </div>
          {/* Barras decorativas: no representan ningún dato. */}
          <ul class="roi-barras" aria-hidden="true">
            {
              barrasRoi.map(([nombre, ancho], i) => (
                <li>
                  <span>{nombre}</span>
                  <span class="roi-pista">
                    <span class="roi-barra" style={`--ancho:${ancho};--i:${i}`} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Estándares */}
    <section class="section banda" aria-labelledby="estandares-titulo" data-acento="cian">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Estándares de trabajo</p>
            <h2 id="estandares-titulo" class="subrayado mt-4">
              Lo que incluye cada proyecto, grande o pequeño
            </h2>
          </div>
          <p class="lead">
            Trabajo con dueños de negocio que necesitan sistemas que funcionen
            todos los días. Estas son las reglas que sigo en cada proyecto.
          </p>
        </div>

        <ul class="estandares mt-12">
          {
            estandares.map((e, i) => (
              <li class="estandar">
                <span class="anillo-degradado anillo-medio" aria-hidden="true">
                  <Icono nombre={iconosEstandares[i]} tamano={20} grosor={1.7} degradado />
                </span>
                <div>
                  <h3 class="estandar-titulo">{e.titulo}</h3>
                  <p class="card-text mt-2">{e.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------------------------------------------------------- Método */}
    <section class="section" aria-labelledby="metodo-titulo" data-acento="violeta">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Método</p>
            <h2 id="metodo-titulo" class="subrayado mt-4">Cómo trabajo</h2>
          </div>
          <p class="lead">
            Son tres pasos, y en cada uno sabes qué estoy haciendo y por qué.
          </p>
        </div>

        <ol class="grid-3 mt-12 paso-lista">
          {
            proceso.map((p) => {
              const img = imagenDe(p.imagen);
              return (
                <li class="card reveal overflow-hidden paso">
                  <div class="media duotono">
                    {img && (
                      <Image
                        src={img}
                        alt={p.imagenAlt}
                        widths={[320, 640]}
                        sizes="(min-width: 1024px) 30vw, 100vw"
                        loading="lazy"
                        class="aspect-[16/9] w-full object-cover"
                      />
                    )}
                    <span class="paso-circulo" aria-hidden="true">{p.numero}</span>
                  </div>
                  <div class="tarjeta-cuerpo">
                    <h3 class="card-title">{p.titulo}</h3>
                    <p class="card-text mt-3">{p.texto}</p>
                    <dl class="paso-reparto">
                      <div>
                        <dt><Icono nombre="check" tamano={14} grosor={2.4} class="dt-icono-yo" />Qué hago yo</dt>
                        <dd>{p.yo}</dd>
                      </div>
                      <div>
                        <dt><Icono nombre="persona" tamano={14} grosor={1.8} class="dt-icono-tu" />Qué haces tú</dt>
                        <dd>{p.tu}</dd>
                      </div>
                    </dl>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    {/* -------------------------------------------------------------- Sobre mí */}
    <section class="section banda" aria-labelledby="sobremi-titulo" data-acento="coral">
      <div class="container-lf sobremi">
        <figure class="retrato-marco reveal">
          <div class="media retrato-media">
            <Image
              src={retratoImg}
              alt="Retrato de Luis Carlos Flores"
              widths={[320, 640]}
              sizes="(min-width: 1024px) 34vw, 80vw"
              loading="lazy"
              class="foto-retrato"
            />
          </div>
          <div class="info-flotante info-abajo info-derecha">
            <span class="info-etiqueta">Base</span>
            <span class="info-valor">Manresa · Barcelona</span>
            <span class="info-sub">Trabajo en remoto con Latinoamérica y España</span>
          </div>
          <div class="info-flotante info-arriba info-izquierda">
            <span class="info-etiqueta">Lo que propongo</span>
            <span class="info-valor">Primero probado en mi negocio</span>
          </div>
        </figure>
        <div>
          <p class="eyebrow">Sobre mí</p>
          <h2 id="sobremi-titulo" class="subrayado mt-4">Antes de ofrecértelo, lo pruebo en mi negocio</h2>
