---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { servicios, SITIO, AREA_SERVIDA } from "../data/servicios";
import { fugas, publicos, herramientas, estandares, proceso, faq, faqPlana, metricas } from "../data/home";
import Showcase from "../components/Showcase.astro";
import heroImg from "../assets/luis-flores-monitores.jpg";
import retratoImg from "../assets/luis-flores-retrato.jpg";

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{jpg,webp}",
  { eager: true },
);

function imagenDe(nombre: string) {
  const clave = Object.keys(imagenes).find((k) => k.includes(`/${nombre}.`));
  return clave ? imagenes[clave].default : undefined;
}

const title = "Consultor de IA y automatización para pymes | Luis Flores";
const description =
  "IA, automatización y funnels para pymes de España y LATAM. Implemento agentes de IA y sistemas de captación. Reserva un diagnóstico gratuito de 30 min.";

// Los tres artículos más recientes, para enlazarlos desde la home.
const ultimos = (await getCollection("blog"))
  .sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime())
  .slice(0, 3);
// Barras decorativas de la banda de la calculadora: proporciones de dibujo.
const barrasRoi: [string, number][] = [
  ["Horas/mes", 0.7],
  ["Ingresos/mes", 0.55],
  ["Recuperación", 0.38],
  ["ROI 12 meses", 0.85],
];
const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });

const schema = [
  {
    // Nodo de la propia página: une el FAQ y la lista de servicios con el
    // sitio y con la persona. Sin dateModified a propósito: no hay una fecha
    // de cambio real que poner, y una inventada es ruido.
    "@type": "WebPage",
    "@id": `${SITIO.url}/#webpage`,
    url: `${SITIO.url}/`,
    name: title,
    description,
    inLanguage: "es-ES",
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "ItemList",
    "@id": `${SITIO.url}/#servicios`,
    name: "Servicios",
    itemListElement: servicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nombre,
      url: `${SITIO.url}/servicios/${s.slug}`,
    })),
  },
  {
    "@type": "ProfessionalService",
    "@id": `${SITIO.url}/#servicio`,
    name: SITIO.nombre,
    url: `${SITIO.url}/`,
    image: `${SITIO.url}/og-default.png`,
    description:
      "Agentes de IA, automatización y funnels de conversión para pymes y emprendedores.",
    areaServed: AREA_SERVIDA,
    founder: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "FAQPage",
    "@id": `${SITIO.url}/#faq`,
    isPartOf: { "@id": `${SITIO.url}/#webpage` },
    mainEntity: faqPlana.map((p) => ({
      "@type": "Question",
      name: p.pregunta,
      acceptedAnswer: { "@type": "Answer", text: p.respuesta },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    {/* ------------------------------------------------------------------ Hero */}
    <section class="section hero" aria-labelledby="hero-titulo">
      <div class="fondo-reticula" aria-hidden="true"></div>
      <div class="container-lf hero-rejilla">
        <div class="hero-texto">
          <p class="eyebrow">IA aplicada · España y LATAM</p>

          {/* PARCHE P1-A: el degradado va al beneficio, no al problema.
              Antes resaltaba "12 horas al día", que es la carga. */}
          <h1 id="hero-titulo" class="mt-5">
            <span class="hero-line-grad block">
              <span class="gradient-text">Automatiza tu negocio con IA</span>
            </span>
            <span class="hero-line-2 block">y deja de trabajar</span>
            <span class="hero-line-2 block">12 horas al día.</span>
          </h1>

          <p class="lead hero-lead mt-6">
            Implemento agentes de IA, automatizaciones y funnels de conversión para
            pymes y emprendedores de España y Latinoamérica. En una llamada de 30
            minutos te digo qué automatizar primero.
          </p>

          <div class="botones mt-8">
            <a class="cta" href="/contacto">
              Reservar diagnóstico <span aria-hidden="true">→</span>
            </a>
            <a class="boton-secundario" href="/servicios">Ver servicios</a>
          </div>

          {/* Garantías: solo lo que ya promete el resto de la web. */}
          <ul class="garantias mt-8" aria-label="Lo que incluye">
            <li>Llamada de 30 min gratuita</li>
            <li>Documentación incluida</li>
            <li>España y Latinoamérica</li>
          </ul>
        </div>

        <figure class="hero-foto">
          <Image
            src={heroImg}
            alt="Luis Carlos Flores en su puesto de trabajo, frente a dos monitores con paneles de automatización"
            widths={[420, 640, 860, 1086]}
            sizes="(min-width: 1024px) 40vw, (min-width: 768px) 62vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="foto-hero"
          />
          <figcaption class="hero-chip">
            <span class="hero-chip-nombre">Luis Carlos Flores</span>
            <span class="hero-chip-oficio">Implementador de IA · Manresa</span>
          </figcaption>
        </figure>
      </div>
    </section>

    {/* -------------------------------------------------------------- Problema */}
    <section class="section banda" aria-labelledby="problema-titulo" data-acento="coral">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">El problema</p>
            <h2 id="problema-titulo" class="subrayado mt-4">Si llevas tú el negocio, esto te suena</h2>
          </div>
          <p class="lead">
            No es falta de ganas: es que el día no da para todo. Estas son las tres
            fugas que más veo antes de automatizar nada.
          </p>
        </div>

        <ol class="grid-3 mt-12">
          {
            fugas.map((f, i) => (
              <li class="card tarjeta reveal">
                <span class="num-indice" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="card-title mt-5">{f.titulo}</h3>
                <p class="card-text mt-3">{f.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* --------------------------------------------------------------- Público */}
    <section class="section" aria-labelledby="publico-titulo" data-acento="cian">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Para quién</p>
            <h2 id="publico-titulo" class="subrayado mt-4">Trabajo con negocios que quieren crecer</h2>
          </div>
        </div>

        <ul class="perfiles mt-12">
          {
            publicos.map((p, i) => (
              <li class="perfil">
                <span class="num-indice" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="publico-titulo mt-4">{p.titulo}</h3>
                <p class="card-text mt-2">{p.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------- Herramientas */}
    <section class="section seccion-corta" aria-labelledby="herramientas-titulo">
      <div class="container-lf herramientas-cabecera">
        <h2 id="herramientas-titulo" class="h-pequeno">
          Trabajo con las herramientas que ya usas
        </h2>
        <p class="card-text">
          Si tu negocio usa otras, reviso primero si se pueden integrar.
        </p>
      </div>

      <div class="marquee mt-8">
        <ul class="marquee-track">
          {herramientas.map((h) => <li class="herramienta">{h}</li>)}
        </ul>
        {/*
          PARCHE P3: la copia que cierra el bucle es decorativa. Con
          aria-hidden un lector de pantalla no lee la lista dos veces, y con
          tabindex -1 el tabulador no entra en ella.
        */}
        <ul class="marquee-track" aria-hidden="true">
          {
            herramientas.map((h) => (
              <li class="herramienta" tabindex="-1">
                {h}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ------------------------------------------------------------- Servicios */}
    <section class="section banda" aria-labelledby="servicios-titulo">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 id="servicios-titulo" class="subrayado mt-4">
              Todo lo que necesitas para automatizar tu negocio
            </h2>
          </div>
          <p class="lead">
            Desde un agente de IA hasta un sistema completo de captación y
            automatización. Lo implemento y lo dejo documentado.
          </p>
        </div>

        {/* PARCHE P1-C: los SEIS servicios, desde un único array.
            La home anterior enseñaba cuatro. */}
        <ul class="services-grid mt-12">
          {
            servicios.map((s, i) => {
              const img = imagenDe(s.imagen);
              return (
                <li
                  class="card card-interactiva tarjeta-servicio reveal overflow-hidden"
                  style={`--svc: var(${s.color})`}
                >
                  {img && (
                    <div class="media">
                      <Image
                        src={img}
                        alt={s.imagenAlt}
                        widths={[320, 640]}
                        sizes="(min-width: 1024px) 30vw, 100vw"
                        loading="lazy"
                        class="aspect-[16/9] w-full object-cover"
                      />
                    </div>
                  )}
                  <div class="tarjeta-cuerpo">
                    <span class="num-indice num-servicio" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <h3 class="card-title mt-3">{s.nombre}</h3>
                    <p class="card-text mt-2">{s.resumen}</p>
                    <a class="card-link" href={`/servicios/${s.slug}`}>
                      Más información <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>
              );
            })
          }
        </ul>

        <div class="caja-cta mt-10 reveal">
          <p>
            <strong>¿No sabes por cuál empezar?</strong> En 30 minutos reviso tu caso
            y te digo qué automatizar primero.
          </p>
          <a class="cta" href="/contacto">
            Reservar diagnóstico <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <Showcase />

    {/* -------------------------------------------------------------- Métricas */}
    <section class="section banda" aria-labelledby="metricas-titulo" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Métricas propias</p>
            <h2 id="metricas-titulo" class="subrayado mt-4">Resultados medidos, no promesas</h2>
          </div>
          <p class="lead">
            Lo que mido en cada implementación: rapidez de respuesta, horas
            liberadas y asistencia a las citas.
          </p>
        </div>
        <ul class="metricas mt-12">
          {
            metricas.map((m) => (
              <li class="metrica reveal">
                <p class="cifra">
                  <span class="gradient-text">{m.cifra}</span>
                  <a href="/sobre-mi#como-mido" class="asterisco" aria-label="Cómo se midió">*</a>
                </p>
                <p class="metrica-texto">{m.texto}</p>
              </li>
            ))
          }
        </ul>
        <p class="nota mt-8">
          *Medido en implementaciones propias con negocios reales.{" "}
          <a href="/sobre-mi#como-mido">Cómo se midió</a>
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Calculadora */}
    <section class="section" aria-labelledby="roi-titulo" data-acento="ambar">
      <div class="container-lf">
        <div class="card roi reveal">
          <div class="fondo-reticula" aria-hidden="true"></div>
          <div>
            <p class="eyebrow">Calculadora ROI</p>
            <h2 id="roi-titulo" class="mt-4">Pon tus números y ve una estimación</h2>
            <p class="lead mt-4">
              Horas ahorradas al mes, ingresos adicionales y en cuánto tiempo
              recuperarías la inversión. Orientativo y basado en hipótesis: tú
              decides la inversión, sin precios por defecto.
            </p>
            <a class="cta mt-8" href="/roi">
              Abrir la calculadora <span aria-hidden="true">→</span>
            </a>
          </div>
          {/* Barras decorativas: no representan ningún dato. */}
          <ul class="roi-barras" aria-hidden="true">
            {
              barrasRoi.map(([nombre, ancho], i) => (
                <li>
                  <span>{nombre}</span>
                  <span class="roi-pista">
                    <span class="roi-barra" style={`--ancho:${ancho};--i:${i}`} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Estándares */}
    <section class="section banda" aria-labelledby="estandares-titulo" data-acento="cian">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Estándares de trabajo</p>
            <h2 id="estandares-titulo" class="subrayado mt-4">
              Lo que tiene cada proyecto, sea cual sea su tamaño
            </h2>
          </div>
          <p class="lead">
            Trabajo con dueños de negocio que necesitan sistemas fiables, no
            experimentos. Estas son las reglas que aplico siempre.
          </p>
        </div>

        <ul class="estandares mt-12">
          {
            estandares.map((e, i) => (
              <li class="estandar reveal">
                <span class="num-indice" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="card-title">{e.titulo}</h3>
                  <p class="card-text mt-2">{e.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------------------------------------------------------- Método */}
    <section class="section" aria-labelledby="metodo-titulo" data-acento="violeta">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Método</p>
            <h2 id="metodo-titulo" class="subrayado mt-4">Cómo trabajo</h2>
          </div>
          <p class="lead">
            Tres pasos, sin sorpresas. Siempre sabes qué estoy haciendo y por qué.
          </p>
        </div>

        <ol class="grid-3 mt-12 paso-lista">
          {
            proceso.map((p) => {
              const img = imagenDe(p.imagen);
              return (
                <li class="card reveal overflow-hidden">
                  {img && (
                    <div class="media">
                      <Image
                        src={img}
                        alt={p.imagenAlt}
                        widths={[320, 640]}
                        sizes="(min-width: 1024px) 30vw, 100vw"
                        loading="lazy"
                        class="aspect-[16/9] w-full object-cover"
                      />
                    </div>
                  )}
                  <div class="tarjeta-cuerpo">
                    <p class="paso-numero">{p.numero}</p>
                    <h3 class="card-title mt-2">{p.titulo}</h3>
                    <p class="card-text mt-3">{p.texto}</p>
                    <dl class="paso-reparto mt-5">
                      <dt>Qué hago yo</dt>
                      <dd>{p.yo}</dd>
                      <dt>Qué haces tú</dt>
                      <dd>{p.tu}</dd>
                    </dl>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    {/* -------------------------------------------------------------- Sobre mí */}
    <section class="section banda" aria-labelledby="sobremi-titulo" data-acento="coral">
      <div class="container-lf sobremi">
        <figure class="retrato-marco reveal">
          <Image
            src={retratoImg}
            alt="Retrato de Luis Carlos Flores"
            widths={[320, 640]}
            sizes="(min-width: 1024px) 34vw, 80vw"
            loading="lazy"
            class="foto-retrato"
          />
        </figure>
        <div>
          <p class="eyebrow">Sobre mí</p>
          <h2 id="sobremi-titulo" class="subrayado mt-4">Implemento, no vendo humo</h2>
          <p class="lead mt-6">
            Soy Luis Carlos Flores, de Manresa. Llevo alrededor de tres años
            trabajando con IA. Empecé como freelance y pasé a dirigir una agencia
            después de implementar IA y automatización en mi propio negocio. Lo que
            te propongo, primero lo he probado. Sin promesas mágicas: procesos
            claros, datos y mejora continua.
          </p>

          {/* Datos sueltos sacados del párrafo de arriba, para leer de un vistazo. */}
          <ul class="datos mt-8" aria-label="En resumen">
            <li><span>Base</span>Manresa, Cataluña</li>
            <li><span>Con IA</span>Unos tres años</li>
            <li><span>Lo que propongo</span>Primero probado en mi negocio</li>
          </ul>

          <blockquote class="lema mt-8">{SITIO.lema}</blockquote>

          <a class="card-link mt-8 inline-block" href="/sobre-mi">
            Leer mi historia <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------------ Blog */}
    {/* Los tres artículos más recientes. Enlaces internos a contenido actual
        desde la página con más autoridad del sitio. */}
    <section class="section" aria-labelledby="blog-titulo" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Del blog</p>
            <h2 id="blog-titulo" class="subrayado mt-4">Lo último que he escrito</h2>
          </div>
          <a class="card-link cabecera-enlace" href="/blog">
            Ver todos los artículos <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid-3 mt-12">
          {
            ultimos.map((p) => (
              <li class="card tarjeta tarjeta-articulo">
                <p class="meta">
                  <time datetime={p.data.datePublished.toISOString().slice(0, 10)}>
                    {fechaCorta(p.data.datePublished)}
                  </time>
                </p>
                <h3 class="card-title mt-3">
                  <a href={`/blog/${p.id}`} class="enlace-tarjeta">{p.data.title}</a>
                </h3>
                <p class="card-text mt-3">{p.data.description}</p>
                <span class="card-link" aria-hidden="true">
                  Leer el artículo <span aria-hidden="true">→</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ------------------------------------------------------------------- FAQ */}
    <section class="section banda" aria-labelledby="faq-titulo">
      <div class="container-lf faq-rejilla">
        <div class="faq-lateral">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-titulo" class="subrayado mt-4">Preguntas frecuentes</h2>
          <p class="lead mt-5">
            Las dudas que más me plantean los dueños de negocio, por temas.
          </p>
          <div class="caja-cta caja-cta-vertical mt-8">
            <p>
              ¿Tu duda no está aquí? <strong>Reserva un diagnóstico y la resolvemos.</strong>
            </p>
            <a class="cta" href="/contacto">
              Reservar diagnóstico <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div>
          {
            faq.map((g, gi) => (
              <div class="faq-grupo">
                <h3 class={`eyebrow${gi === 0 ? "" : " mt-10"}`}>{g.grupo}</h3>
                {g.preguntas.map((p) => (
                  <details class="card faq-item mt-3">
                    <summary>{p.pregunta}</summary>
                    <div class="faq-cuerpo"><p class="card-text">{p.respuesta}</p></div>
                  </details>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- CTA final */}
    <section class="section" aria-labelledby="cta-titulo" data-acento="violeta">
      <div class="container-lf">
        <div class="cierre reveal">
          <div class="fondo-reticula" aria-hidden="true"></div>
          <p class="eyebrow">Siguiente paso</p>
          <h2 id="cta-titulo" class="mt-5">Hablemos de tu negocio</h2>
          <p class="lead mt-5">
            En 30 minutos reviso tu caso y te digo qué automatizaría primero. Sin
            compromiso y sin tecnicismos.
          </p>
          <div class="botones botones-centro mt-10">
            <a class="cta" href="/contacto">
              Reservar diagnóstico <span aria-hidden="true">→</span>
            </a>
            <a class="boton-secundario" href={`mailto:${SITIO.email}`}>Escribir a {SITIO.email}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero-line-grad {
    font-size: clamp(2.375rem, 1.6rem + 3.3vw, 3.75rem);
    letter-spacing: -0.03em;
    padding-bottom: 0.04em;
  }

  /* Secuencia de entrada del hero, por debajo de 1,2 s en total.

     El H1 NO se desvanece: solo se desplaza. Si animara su opacidad desde 0,
     el navegador no lo contaría como pintado y retrasaría el LCP, que en esta
     página es precisamente el titular o la imagen. Las demás piezas sí pueden
     aparecer, porque no son el elemento más grande. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero .eyebrow,
    :global(.js) .hero .lead,
    :global(.js) .hero .cta,
    :global(.js) .hero .nota {
      animation: entrada-hero 0.6s var(--ease) both;
    }

    :global(.js) .hero h1 {
      animation: desplaza-hero 0.6s var(--ease) both;
      animation-delay: 0.1s;
    }

    :global(.js) .hero .eyebrow { animation-delay: 0s; }
    :global(.js) .hero .lead { animation-delay: 0.26s; }
    :global(.js) .hero .cta { animation-delay: 0.4s; }
    :global(.js) .hero .nota { animation-delay: 0.52s; }
  }

  @keyframes entrada-hero {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Solo transform: la opacidad se queda en 1 para no tocar el LCP. */
  @keyframes desplaza-hero {
    from {
      transform: translateY(14px);
    }
  }

  .hero-line-2 {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
    letter-spacing: -0.03em;
    color: var(--color-soft);
  }

  .nota {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  /* Al bajar, la foto del hero sube un poco más despacio que la página y se
