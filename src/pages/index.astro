---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { servicios, SITIO, AREA_SERVIDA } from "../data/servicios";
import { fugas, publicos, herramientas, estandares, proceso, faq, faqPlana, metricas } from "../data/home";
import Showcase from "../components/Showcase.astro";
import heroImg from "../assets/luis-flores-monitores.jpg";
import retratoImg from "../assets/luis-flores-retrato.jpg";

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{jpg,webp}",
  { eager: true },
);

function imagenDe(nombre: string) {
  const clave = Object.keys(imagenes).find((k) => k.includes(`/${nombre}.`));
  return clave ? imagenes[clave].default : undefined;
}

const title = "Consultor de IA y automatización para pymes | Luis Flores";
const description =
  "IA, automatización y funnels para pymes de España y LATAM. Implemento agentes de IA y sistemas de captación. Reserva un diagnóstico gratuito de 30 min.";

// Los tres artículos más recientes, para enlazarlos desde la home.
const ultimos = (await getCollection("blog"))
  .sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime())
  .slice(0, 3);
// Barras decorativas de la banda de la calculadora: proporciones de dibujo.
const barrasRoi: [string, number][] = [
  ["Horas/mes", 0.7],
  ["Ingresos/mes", 0.55],
  ["Recuperación", 0.38],
  ["ROI 12 meses", 0.85],
];
const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });

const schema = [
  {
    // Nodo de la propia página: une el FAQ y la lista de servicios con el
    // sitio y con la persona. Sin dateModified a propósito: no hay una fecha
    // de cambio real que poner, y una inventada es ruido.
    "@type": "WebPage",
    "@id": `${SITIO.url}/#webpage`,
    url: `${SITIO.url}/`,
    name: title,
    description,
    inLanguage: "es-ES",
    isPartOf: { "@id": `${SITIO.url}/#website` },
    about: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "ItemList",
    "@id": `${SITIO.url}/#servicios`,
    name: "Servicios",
    itemListElement: servicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nombre,
      url: `${SITIO.url}/servicios/${s.slug}`,
    })),
  },
  {
    "@type": "ProfessionalService",
    "@id": `${SITIO.url}/#servicio`,
    name: SITIO.nombre,
    url: `${SITIO.url}/`,
    image: `${SITIO.url}/og-default.png`,
    description:
      "Agentes de IA, automatización y funnels de conversión para pymes y emprendedores.",
    areaServed: AREA_SERVIDA,
    founder: { "@id": `${SITIO.url}/#person` },
  },
  {
    "@type": "FAQPage",
    "@id": `${SITIO.url}/#faq`,
    isPartOf: { "@id": `${SITIO.url}/#webpage` },
    mainEntity: faqPlana.map((p) => ({
      "@type": "Question",
      name: p.pregunta,
      acceptedAnswer: { "@type": "Answer", text: p.respuesta },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <main>
    {/* ------------------------------------------------------------------ Hero */}
    <section class="section hero">
      <div class="container-lf grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow">IA aplicada · España y LATAM</p>

          {/* PARCHE P1-A: el degradado va al beneficio, no al problema.
              Antes resaltaba "12 horas al día", que es la carga. */}
          <h1 class="mt-4">
            <span class="hero-line-grad block">
              <span class="gradient-text">Automatiza tu negocio con IA</span>
            </span>
            <span class="hero-line-2 block">y deja de trabajar</span>
            <span class="hero-line-2 block">12 horas al día.</span>
          </h1>

          <p class="lead mt-6 max-w-[48ch]">
            Implemento agentes de IA, automatizaciones y funnels de conversión para
            pymes y emprendedores de España y Latinoamérica. En una llamada de 30
            minutos te digo qué automatizar primero.
          </p>

          <a class="cta mt-8 inline-flex items-center gap-2" href="/contacto">
            Reservar diagnóstico <span aria-hidden="true">→</span>
          </a>

          <p class="nota mt-4">Llamada de 30 min, gratuita y sin compromiso.</p>
        </div>

        <Image
          src={heroImg}
          alt="Luis Carlos Flores en su puesto de trabajo, frente a dos monitores con paneles de automatización"
          widths={[420, 640, 860, 1086]}
          sizes="(min-width: 1024px) 35vw, (min-width: 768px) 62vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="foto-hero rounded-2xl"
        />
      </div>
    </section>

    {/* -------------------------------------------------------------- Problema */}
    <section class="section" aria-labelledby="problema-titulo">
      <div class="container-lf">
        <p class="eyebrow">El problema</p>
        <h2 id="problema-titulo" class="subrayado mt-3">Si llevas tú el negocio, esto te suena</h2>
        <p class="lead mt-4 max-w-[62ch]">
          No es falta de ganas: es que el día no da para todo. Estas son las tres
          fugas que más veo antes de automatizar nada.
        </p>

        <ul class="grid-3 mt-8">
          {
            fugas.map((f) => (
              <li class="card reveal p-6">
                <h3 class="card-title">{f.titulo}</h3>
                <p class="card-text mt-3">{f.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* --------------------------------------------------------------- Público */}
    <section class="section" aria-labelledby="publico-titulo">
      <div class="container-lf">
        <h2 id="publico-titulo" class="h-pequeno">Trabajo con negocios que quieren crecer</h2>

        <ul class="grid-4 mt-6">
          {
            publicos.map((p) => (
              <li>
                <h3 class="publico-titulo">{p.titulo}</h3>
                <p class="card-text mt-1">{p.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------- Herramientas */}
    <section class="section" aria-labelledby="herramientas-titulo">
      <div class="container-lf">
        <h2 id="herramientas-titulo" class="h-pequeno">
          Trabajo con las herramientas que ya usas
        </h2>
        <p class="card-text mt-3">
          Si tu negocio usa otras, reviso primero si se pueden integrar.
        </p>
      </div>

      <div class="marquee mt-6">
        <ul class="marquee-track">
          {herramientas.map((h) => <li class="herramienta">{h}</li>)}
        </ul>
        {/*
          PARCHE P3: la copia que cierra el bucle es decorativa. Con
          aria-hidden un lector de pantalla no lee la lista dos veces, y con
          tabindex -1 el tabulador no entra en ella.
        */}
        <ul class="marquee-track" aria-hidden="true">
          {
            herramientas.map((h) => (
              <li class="herramienta" tabindex="-1">
                {h}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ------------------------------------------------------------- Servicios */}
    <section class="section" aria-labelledby="servicios-titulo">
      <div class="container-lf">
        <p class="eyebrow">Servicios</p>
        <h2 id="servicios-titulo" class="subrayado mt-3 max-w-[20ch]">
          Todo lo que necesitas para automatizar tu negocio
        </h2>

        {/* PARCHE P1-C: los SEIS servicios, desde un único array.
            La home anterior enseñaba cuatro. */}
        <ul class="services-grid mt-8">
          {
            servicios.map((s) => {
              const img = imagenDe(s.imagen);
              return (
                <li
                  class="card card-interactiva reveal overflow-hidden"
                  style={`--svc: var(${s.color})`}
                >
                  {img && (
                    <Image
                      src={img}
                      alt={s.imagenAlt}
                      widths={[320, 640]}
                      sizes="(min-width: 1024px) 30vw, 100vw"
                      loading="lazy"
                      class="aspect-[16/9] w-full object-cover"
                    />
                  )}
                  <div class="p-5">
                    <h3 class="card-title">{s.nombre}</h3>
                    <p class="card-text mt-2">{s.resumen}</p>
                    <a class="card-link mt-4 inline-block" href={`/servicios/${s.slug}`}>
                      Más información <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>
              );
            })
          }
        </ul>

        <div class="caja-cta mt-8 reveal">
          <p>
            <strong>¿No sabes por cuál empezar?</strong> En 30 minutos reviso tu caso
            y te digo qué automatizar primero.
          </p>
          <a class="cta inline-flex items-center gap-2" href="/contacto">
            Reservar diagnóstico <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <Showcase />

    {/* -------------------------------------------------------------- Métricas */}
    <section class="section" aria-labelledby="metricas-titulo">
      <div class="container-lf">
        <div class="cabecera-doble">
          <div>
            <p class="eyebrow">Métricas propias</p>
            <h2 id="metricas-titulo" class="subrayado mt-3">Resultados medidos, no promesas</h2>
          </div>
          <p class="card-text">
            Lo que mido en cada implementación: rapidez de respuesta, horas
            liberadas y asistencia a las citas.
          </p>
        </div>
        <ul class="grid-3 mt-8">
          {
            metricas.map((m) => (
              <li class="card reveal p-6">
                <p class="cifra">
                  <span class="gradient-text">{m.cifra}</span>
                  <a href="/sobre-mi#como-mido" class="asterisco" aria-label="Cómo se midió">*</a>
                </p>
                <p class="card-text mt-2">{m.texto}</p>
              </li>
            ))
          }
        </ul>
        <p class="nota mt-4">
          *Medido en implementaciones propias con negocios reales.{" "}
          <a href="/sobre-mi#como-mido">Cómo se midió</a>
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Calculadora */}
    <section class="section" aria-labelledby="roi-titulo">
      <div class="container-lf">
        <div class="card roi reveal">
          <div>
            <p class="eyebrow">Calculadora ROI</p>
            <h2 id="roi-titulo" class="mt-3">Pon tus números y ve una estimación</h2>
            <p class="lead mt-4">
              Horas ahorradas al mes, ingresos adicionales y en cuánto tiempo
              recuperarías la inversión. Orientativo y basado en hipótesis: tú
              decides la inversión, sin precios por defecto.
            </p>
            <a class="cta mt-6 inline-flex items-center gap-2" href="/roi">
              Abrir la calculadora <span aria-hidden="true">→</span>
            </a>
          </div>
          {/* Barras decorativas: no representan ningún dato. */}
          <ul class="roi-barras" aria-hidden="true">
            {
              barrasRoi.map(([nombre, ancho], i) => (
                <li>
                  <span>{nombre}</span>
                  <span class="roi-pista">
                    <span class="roi-barra" style={`--ancho:${ancho};--i:${i}`} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Estándares */}
    <section class="section" aria-labelledby="estandares-titulo">
      <div class="container-lf">
        <p class="eyebrow">Estándares de trabajo</p>
        <h2 id="estandares-titulo" class="subrayado mt-3 max-w-[24ch]">
          Lo que tiene cada proyecto, sea cual sea su tamaño
        </h2>
        <p class="lead mt-4 max-w-[62ch]">
          Trabajo con dueños de negocio que necesitan sistemas fiables, no
          experimentos. Estas son las reglas que aplico siempre.
        </p>

        <ul class="grid-3 mt-8">
          {
            estandares.map((e) => (
              <li class="card reveal p-6">
                <h3 class="card-title">{e.titulo}</h3>
                <p class="card-text mt-3">{e.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------------------------------------------------------- Método */}
    <section class="section" aria-labelledby="metodo-titulo">
      <div class="container-lf">
        <p class="eyebrow">Método</p>
        <h2 id="metodo-titulo" class="subrayado mt-3">Cómo trabajo</h2>
        <p class="lead mt-4 max-w-[62ch]">
          Tres pasos, sin sorpresas. Siempre sabes qué estoy haciendo y por qué.
        </p>

        <ol class="grid-3 mt-8 paso-lista">
          {
            proceso.map((p) => {
              const img = imagenDe(p.imagen);
              return (
                <li class="card reveal overflow-hidden">
                  {img && (
                    <Image
                      src={img}
                      alt={p.imagenAlt}
                      widths={[320, 640]}
                      sizes="(min-width: 1024px) 30vw, 100vw"
                      loading="lazy"
                      class="aspect-[16/9] w-full object-cover"
                    />
                  )}
                  <div class="p-6">
                    <p class="paso-numero">{p.numero}</p>
                    <h3 class="card-title mt-1">{p.titulo}</h3>
                    <p class="card-text mt-3">{p.texto}</p>
                    <dl class="paso-reparto mt-4">
                      <dt>Qué hago yo</dt>
                      <dd>{p.yo}</dd>
                      <dt>Qué haces tú</dt>
                      <dd>{p.tu}</dd>
                    </dl>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    {/* -------------------------------------------------------------- Sobre mí */}
    <section class="section" aria-labelledby="sobremi-titulo">
      <div class="container-lf grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <Image
          src={retratoImg}
          alt="Retrato de Luis Carlos Flores"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 30vw, 70vw"
          loading="lazy"
          class="foto-retrato rounded-2xl"
        />
        <div>
          <p class="eyebrow">Sobre mí</p>
          <h2 id="sobremi-titulo" class="subrayado mt-3">Implemento, no vendo humo</h2>
          <p class="lead mt-4">
            Soy Luis Carlos Flores, de Manresa. Llevo alrededor de tres años
            trabajando con IA. Empecé como freelance y pasé a dirigir una agencia
            después de implementar IA y automatización en mi propio negocio. Lo que
            te propongo, primero lo he probado. Sin promesas mágicas: procesos
            claros, datos y mejora continua.
          </p>
          <p class="card-text mt-4">{SITIO.lema}</p>
          <a class="card-link mt-6 inline-block" href="/sobre-mi">
            Leer mi historia <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------------ Blog */}
    {/* Los tres artículos más recientes. Enlaces internos a contenido actual
        desde la página con más autoridad del sitio. */}
    <section class="section" aria-labelledby="blog-titulo">
      <div class="container-lf">
        <p class="eyebrow">Del blog</p>
        <h2 id="blog-titulo" class="subrayado mt-3">Lo último que he escrito</h2>
        <ul class="grid-3 mt-8">
          {
            ultimos.map((p) => (
              <li class="card p-6">
                <p class="meta">
                  <time datetime={p.data.datePublished.toISOString().slice(0, 10)}>
                    {fechaCorta(p.data.datePublished)}
                  </time>
                </p>
                <h3 class="card-title mt-2">
                  <a href={`/blog/${p.id}`}>{p.data.title}</a>
                </h3>
                <p class="card-text mt-2">{p.data.description}</p>
              </li>
            ))
          }
        </ul>
        <a class="card-link mt-6 inline-block" href="/blog">
          Ver todos los artículos <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {/* ------------------------------------------------------------------- FAQ */}
    <section class="section" aria-labelledby="faq-titulo">
      <div class="container-lf">
        <h2 id="faq-titulo">Preguntas frecuentes</h2>

        {
          faq.map((g) => (
            <div class="faq-grupo">
              <h3 class="eyebrow mt-8">{g.grupo}</h3>
              {g.preguntas.map((p) => (
                <details class="card faq-item mt-3">
                  <summary>{p.pregunta}</summary>
                  <div class="faq-cuerpo"><p class="card-text">{p.respuesta}</p></div>
                </details>
              ))}
            </div>
          ))
        }

        <div class="caja-cta mt-8">
          <p>
            ¿Tu duda no está aquí? <strong>Reserva un diagnóstico y la resolvemos.</strong>
          </p>
          <a class="cta inline-flex items-center gap-2" href="/contacto">
            Reservar diagnóstico <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- CTA final */}
    <section class="section" aria-labelledby="cta-titulo">
      <div class="container-lf card cta-final">
        <h2 id="cta-titulo">Hablemos de tu negocio</h2>
        <p class="lead mt-3 max-w-[52ch]">
          En 30 minutos reviso tu caso y te digo qué automatizaría primero. Sin
          compromiso y sin tecnicismos.
        </p>
        <a class="cta mt-6 inline-flex items-center gap-2" href="/contacto">
          Reservar diagnóstico <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero-line-grad {
    font-size: clamp(2.375rem, 1.6rem + 3.3vw, 3.75rem);
    letter-spacing: -0.03em;
    padding-bottom: 0.04em;
  }

  /* Secuencia de entrada del hero, por debajo de 1,2 s en total.

     El H1 NO se desvanece: solo se desplaza. Si animara su opacidad desde 0,
     el navegador no lo contaría como pintado y retrasaría el LCP, que en esta
     página es precisamente el titular o la imagen. Las demás piezas sí pueden
     aparecer, porque no son el elemento más grande. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero .eyebrow,
    :global(.js) .hero .lead,
    :global(.js) .hero .cta,
    :global(.js) .hero .nota {
      animation: entrada-hero 0.6s var(--ease) both;
    }

    :global(.js) .hero h1 {
      animation: desplaza-hero 0.6s var(--ease) both;
      animation-delay: 0.1s;
    }

    :global(.js) .hero .eyebrow { animation-delay: 0s; }
    :global(.js) .hero .lead { animation-delay: 0.26s; }
    :global(.js) .hero .cta { animation-delay: 0.4s; }
    :global(.js) .hero .nota { animation-delay: 0.52s; }
  }

  @keyframes entrada-hero {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Solo transform: la opacidad se queda en 1 para no tocar el LCP. */
  @keyframes desplaza-hero {
    from {
      transform: translateY(14px);
    }
  }

  .hero-line-2 {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
    letter-spacing: -0.03em;
    color: var(--color-soft);
  }

  .nota {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  /* La foto original es vertical (3:4). Sin encuadre dominaba el hero y
     empujaba el texto hacia arriba. Se recorta a 4:5 y se limita la altura
     para que nunca sea más alta que la columna de texto. */
  .foto-hero {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    max-height: 32rem;
  }

  @media (width >= 1024px) {
    .foto-hero {
      max-height: 34rem;
    }
  }

  /* El retrato es 2:3, aún más vertical. Mismo criterio.
     Sin max-height: si se limita la altura, el ancho sigue mandando y la
     proporción real deja de ser la declarada (se quedaba en 1.04 en vez de
     0.8). La proporción sola ya controla el tamaño. */
  .foto-retrato {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
  }

  .cta {
    background: var(--grad-cta);
    color: #fff;
    border-radius: 999px;
    padding: 0.875rem 1.5rem;
    font-weight: 700;
    box-shadow: var(--shadow-cta);
  }

  .h-pequeno {
    font-size: var(--step-3);
  }

  .card-title {
    font-size: var(--step-2);
  }

  .card-text {
    color: var(--color-soft);
  }

  /* Aviso para reservar dentro de una sección. */
  .caja-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-2xl);
    background: linear-gradient(90deg, rgb(0 123 255 / 0.08), rgb(139 92 246 / 0.08));
    color: var(--color-soft);
  }
  .caja-cta strong {
    color: var(--color-ink);
    font-weight: 700;
  }
  @media (width >= 768px) {
    .caja-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
    .caja-cta .cta {
      flex-shrink: 0;
    }
  }

  .cabecera-doble {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 768px) {
    .cabecera-doble {
      grid-template-columns: 1fr minmax(0, 28rem);
      align-items: end;
    }
  }

  .cifra {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 1.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .asterisco {
    margin-inline-start: 0.1em;
    font-size: 0.55em;
    vertical-align: super;
    color: var(--color-electric-soft);
  }
  .nota a {
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .roi {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(45% 80% at 85% 20%, rgb(0 123 255 / 0.18), transparent 70%),
      var(--color-surface);
  }
  @media (width >= 768px) {
    .roi {
      padding: 2.75rem 2.5rem;
    }
  }
  @media (width >= 1024px) {
    .roi {
