---
/**
 * Bloque final de llamada a la acción, igual en todas las páginas (también
 * en la home): imagen de red, retícula, luz, dos botones y el retrato
 * recortado de Luis, apoyado en el borde inferior de la tarjeta.
 */
import { Image } from "astro:assets";
import Icono from "./Icono.astro";
import fondoRed from "../assets/fondo-red.webp";
import recorte from "../assets/luis-flores-recorte.png";
import { SITIO } from "../data/servicios";

interface Props {
  titulo?: string;
  entradilla?: string;
  antetitulo?: string;
  acento?: string;
}

const {
  titulo = "Hablemos de tu negocio",
  entradilla = "En 30 minutos revisamos tu caso y te digo qué automatizaría primero. Es gratis y no te compromete a nada.",
  antetitulo = "Siguiente paso",
  acento = "violeta",
} = Astro.props;
---

<section class="section seccion-cierre" aria-labelledby="cierre-titulo" data-acento={acento}>
  <div class="container-lf">
    <div class="cierre reveal">
      <Image
        src={fondoRed}
        alt=""
        aria-hidden="true"
        widths={[640, 960]}
        sizes="(min-width: 1024px) 80vw, 100vw"
        loading="lazy"
        class="cierre-fondo"
      />
      <div class="fondo-reticula" aria-hidden="true"></div>

      <div class="cierre-texto">
        <p class="eyebrow">{antetitulo}</p>
        <h2 id="cierre-titulo" class="mt-5">{titulo}</h2>
        <p class="lead mt-5">{entradilla}</p>
        <div class="botones mt-8">
          <a class="cta" href="/contacto">
            <Icono nombre="calendario" tamano={18} />
            Agenda tu llamada gratis <span aria-hidden="true">→</span>
          </a>
          <a class="boton-secundario" href={SITIO.whatsapp} rel="noopener">
            <Icono nombre="whatsapp" tamano={18} />
            Escríbeme por WhatsApp
          </a>
        </div>
        <p class="cierre-firma">
          <span>{SITIO.nombreCompleto}</span>
          La llamada la hago yo, en persona.
        </p>
      </div>

      <figure class="cierre-retrato">
        <Image
          src={recorte}
          alt={`${SITIO.nombreCompleto}, sonriendo y con los brazos cruzados`}
          widths={[320, 480, 640]}
          sizes="(min-width: 900px) 30vw, 70vw"
          loading="lazy"
          class="cierre-foto"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  /* Tarjeta más contenida (21/10/2026): menos alto y ancho máximo, para que
     acompañe al final de la página sin dominarla. */
  .cierre {
    --relleno-y: clamp(2.5rem, 1.75rem + 3vw, 4rem);
    max-width: 64rem;
    margin-inline: auto;
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: var(--relleno-y) clamp(1.5rem, 1rem + 3vw, 3.5rem) 0;
    border: 1px solid var(--color-line);
    border-radius: 1.75rem;
    background: var(--color-surface);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), var(--shadow-3);
  }
  .cierre :global(.cierre-fondo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    filter: saturate(0.9);
  }
  /* El velo va en ::after para pintarse encima de la foto de fondo. */
  .cierre::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(rgb(16 21 34 / 0.58), rgb(16 21 34 / 0.8)),
      radial-gradient(50% 70% at 50% 0%, rgb(0 123 255 / 0.28), transparent 70%),
      radial-gradient(40% 60% at 85% 100%, rgb(139 92 246 / 0.22), transparent 70%);
  }
  /* En celular, menos margen lateral para que el botón quepa en una línea. */
  @media (width < 480px) {
    .cierre {
      padding-inline: 1rem;
    }
  }
  .cierre-texto,
  .cierre-retrato {
    position: relative;
    z-index: 1;
  }
  .cierre-texto {
    display: grid;
    justify-items: center;
  }
  .cierre h2 {
    max-width: 18ch;
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .cierre .lead {
    max-width: 52ch;
  }
  .botones {
    justify-content: center;
  }
  .cierre-firma {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .cierre-firma span {
    display: block;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Retrato recortado: de pie sobre el borde inferior, con un halo de la
     marca detrás para que se despegue del fondo. */
  .cierre-retrato {
    width: min(15rem, 66%);
    margin: 2.5rem 0 0;
    align-self: end;
  }
  .cierre-retrato::before {
    content: "";
    position: absolute;
    inset: 18% -12% 0;
    z-index: -1;
    border-radius: 50% 50% 0 0;
    background:
      radial-gradient(closest-side, rgb(0 123 255 / 0.45), rgb(139 92 246 / 0.22) 55%, transparent);
    filter: blur(28px);
  }
  .cierre-retrato :global(.cierre-foto) {
    display: block;
    width: 100%;
    height: auto;
    /* Funde el borde inferior con la tarjeta. */
    -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent);
    mask-image: linear-gradient(180deg, #000 82%, transparent);
  }

  /* Escritorio: texto a la izquierda y retrato a la derecha. */
  @media (width >= 900px) {
    .cierre {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: end;
      justify-items: stretch;
      column-gap: 2rem;
      text-align: left;
    }
    .cierre-texto {
      justify-items: start;
      align-self: center;
      padding-bottom: var(--relleno-y);
    }
    .botones {
      justify-content: flex-start;
    }
    .cierre-retrato {
      width: 100%;
      max-width: 16rem;
      margin: 1.5rem 0 0 auto;
    }
  }
</style>
