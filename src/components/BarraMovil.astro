---
/**
 * Barra fija de reserva en móvil y tableta, como la de producción.
 * No sale en /contacto, que ya es la página de reserva.
 *
 * Desde el 28/10/2026 lleva también el botón del asistente: en celular la
 * burbuja flotante del chat se escondía detrás y tapaba contenido. Nace
 * oculto y lo muestra Chat.astro cuando el asistente está listo.
 */
import Icono from "./Icono.astro";
import { SITIO } from "../data/servicios";

const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const mostrar = ruta !== "/contacto";
---

{
  mostrar && (
    <div class="barra-movil" data-ubicacion="barra-movil">
      <a class="cta boton" href="/contacto">
        Agenda tu llamada gratis <span aria-hidden="true">→</span>
      </a>
      <button
        type="button"
        class="boton-redondo boton-asistente"
        aria-label="Abrir el asistente"
        aria-expanded="false"
        aria-controls="chat-panel"
        data-abrir-chat
        hidden
      >
        <Icono nombre="chat" tamano={21} grosor={1.8} />
      </button>
      <a class="boton-redondo boton-whatsapp" href={SITIO.whatsapp} rel="noopener" aria-label="Escríbeme por WhatsApp">
        <Icono nombre="whatsapp" tamano={22} grosor={1.8} />
      </a>
    </div>
  )
}

<style>
  .barra-movil {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.625rem var(--gutter);
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
    background: var(--color-navy-glass);
    display: flex;
    gap: 0.625rem;
  }
  /* WhatsApp al lado del botón principal: en Latinoamérica es el canal más usado. */
  .boton-redondo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .boton-redondo[hidden] {
    display: none;
  }
  .boton-redondo:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .boton-whatsapp {
    border: 1px solid rgb(37 211 102 / 0.45);
    background: rgb(37 211 102 / 0.12);
    color: var(--color-whatsapp);
  }
  .boton-asistente {
    border: 1px solid rgb(139 92 246 / 0.5);
    background: rgb(139 92 246 / 0.14);
    color: var(--color-ink);
  }
  .boton-asistente[aria-expanded="true"] {
    border-color: var(--color-violet);
    background: rgb(139 92 246 / 0.3);
  }
  @supports (backdrop-filter: blur(12px)) {
    .barra-movil {
      background: var(--color-navy-glass-blur);
      backdrop-filter: blur(12px);
    }
  }
  .boton {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    gap: 0.375rem;
    /* Con tres botones en la fila, el texto cabe en una línea a 360 px. */
    font-size: 0.9375rem;
    white-space: nowrap;
    border-radius: 999px;
    background: var(--grad-cta);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    box-shadow: var(--shadow-cta);
  }
  .boton:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  /* Hueco al final de la página para que la barra no tape el pie. */
  :global(body:has(.barra-movil)) {
    padding-bottom: 4.75rem;
  }
  @media (width >= 1024px) {
    .barra-movil {
      display: none;
    }
    :global(body:has(.barra-movil)) {
      padding-bottom: 0;
    }
  }
</style>
