---
import { servicios, proyectos, SITIO } from "../data/servicios";
import Icono from "./Icono.astro";

// El botón solo tiene sentido si hay banner, y el banner solo existe con GTM.
const hayBannerCookies = /^GTM-[A-Z0-9]+$/.test(SITIO.gtm);

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="container-lf">
    <div class="pie-grid">
      <div class="pie-marca">
        <img src="/logo/nombre-360.webp" alt="Luis Flores" width="180" height="24" />
        <p class="pie-lema">
          IA, automatización y embudos de venta para emprendedores de Latinoamérica
          y España. {SITIO.lema}
        </p>
        <a class="pie-email" href={`mailto:${SITIO.email}`}>{SITIO.email}</a>
        <a class="pie-whatsapp" href={SITIO.whatsapp} rel="noopener">
          <Icono nombre="whatsapp" tamano={16} />
          <span class="sr-only">WhatsApp</span> {SITIO.whatsappVisible}
        </a>
      </div>

      {/* PARCHE P1-C: todos los servicios. El pie anterior listaba cuatro de seis.
          Salen del mismo array que la home y /servicios. */}
      <nav class="pie-col pie-col-servicios" aria-labelledby="pie-servicios">
        <h2 class="pie-titulo" id="pie-servicios">Servicios</h2>
        <ul>
          {
            servicios.map((s) => (
              <li>
                <a href={`/servicios/${s.slug}`}>{s.nombre}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="pie-col" aria-labelledby="pie-recursos">
        <h2 class="pie-titulo" id="pie-recursos">Recursos</h2>
        <ul>
          <li><a href="/roi">Calculadora ROI</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/sobre-mi">Sobre mí</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <nav class="pie-col" aria-labelledby="pie-proyectos">
        <h2 class="pie-titulo" id="pie-proyectos">Mis proyectos</h2>
        <ul>
          {
            proyectos.map((p) => (
              <li>
                <a href={p.url} rel="noopener">
                  {p.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="pie-col" aria-labelledby="pie-legal">
        <h2 class="pie-titulo" id="pie-legal">Legal</h2>
        <ul>
          <li><a href="/aviso-legal">Aviso legal</a></li>
          <li><a href="/politica-de-privacidad">Privacidad</a></li>
          <li><a href="/politica-de-cookies">Cookies</a></li>
          {
            hayBannerCookies && (
              <li>
                <button type="button" class="pie-boton" data-cookie-settings>
                  Configurar cookies
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <div class="pie-base">
      {/*
        El NIF/NIE y la dirección postal viven SOLO en /aviso-legal.
        Antes salían en las 21 páginas del sitio. No los devuelvas aquí.
      */}
      <p>
        {SITIO.nombreCompleto} · {SITIO.localidad}, {SITIO.region}, España ·
        <a href="/aviso-legal">Datos fiscales en el aviso legal</a>
      </p>
      <p class="pie-ia">Si en algún lugar hablas con una IA, está indicado.</p>
      <p class="pie-copy">© {anio} {SITIO.nombreCompleto}. Todos los derechos reservados.</p>
      <a class="pie-arriba" href="#top">Volver arriba</a>
    </div>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--color-line);
    background: var(--color-navy-2);
    padding-block: var(--space-6) var(--space-4);
    margin-top: var(--space-8);
  }

  .pie-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  .pie-marca img {
    height: 1.25rem;
    width: auto;
  }

  .pie-lema {
    color: var(--color-soft);
    font-size: var(--step-0);
    margin-top: 0.75rem;
    max-width: 42ch;
  }

  .pie-whatsapp {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    width: fit-content;
    margin-top: 0.5rem;
    white-space: nowrap;
    color: var(--color-soft);
  }
  .pie-whatsapp:hover {
    color: var(--color-ink);
  }
  .pie-whatsapp :global(svg) {
    color: var(--color-whatsapp);
  }
  .pie-email {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pie-titulo {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .pie-col ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .pie-col a {
    color: var(--color-soft);
    font-size: var(--step-0);
    transition: color var(--dur-base) ease;
  }
  .pie-col a:hover {
    color: var(--color-ink);
  }
  .pie-col a {
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition:
      color var(--dur-base) ease,
      background-size var(--dur-micro) var(--ease);
  }
  .pie-col a:hover,
  .pie-col a:focus-visible {
    background-size: 100% 1px;
  }
  .pie-boton {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-soft);
    font: inherit;
    font-size: var(--step-0);
    cursor: pointer;
    transition: color var(--dur-base) ease;
  }
  .pie-boton:hover {
    color: var(--color-ink);
  }

  .pie-base {
    border-top: 1px solid var(--color-divider);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--step--1);
    display: grid;
    gap: 0.375rem;
  }

  .pie-base a {
    color: var(--color-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pie-ia {
    color: var(--color-soft);
  }

  .pie-arriba {
    justify-self: start;
    margin-top: 0.5rem;
  }

  @media (width >= 640px) {
    .pie-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Nueve servicios: en dos columnas para que no se corten en tres líneas. */
  @media (width >= 640px) {
    .pie-col-servicios ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
  @media (width >= 768px) {
    .pie-col-servicios {
      grid-column: span 2;
    }
  }
  @media (width >= 1024px) {
    .pie-grid {
      grid-template-columns: 2fr 2.4fr 1fr 1fr 0.9fr;
      column-gap: 2.5rem;
    }
    .pie-col-servicios {
      grid-column: auto;
    }
  }
</style>
