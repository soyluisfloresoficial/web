---
import { servicios, proyectos, SITIO } from "../data/servicios";
import Icono from "./Icono.astro";

// El botón solo tiene sentido si hay banner, y el banner solo existe con GTM.
const hayBannerCookies = /^GTM-[A-Z0-9]+$/.test(SITIO.gtm);

const anio = new Date().getFullYear();

// Los nueve servicios, agrupados por lo que resuelven: así el pie se lee de
// un vistazo en vez de ser una lista larga. Salen del mismo array que la home.
const grupos = [
  {
    id: "pie-ia",
    titulo: "IA y automatización",
    slugs: ["agentes-ia", "automatizacion", "paneles-de-metricas", "consultoria-ia"],
  },
  {
    id: "pie-ventas",
    titulo: "Captación y ventas",
    slugs: ["funnels-conversion", "crm-seguimiento-leads", "email-marketing", "webs-ia", "trafico-de-pago"],
  },
].map((g) => ({ ...g, items: g.slugs.map((s) => servicios.find((x) => x.slug === s)!).filter(Boolean) }));

const redes = [
  { nombre: "LinkedIn", href: "https://www.linkedin.com/in/soyluisflores/", icono: "linkedin" },
  { nombre: "Instagram", href: "https://www.instagram.com/soyluisflores_/", icono: "instagram" },
  { nombre: "TikTok", href: "https://www.tiktok.com/@soyluisfloresoficial", icono: "tiktok" },
] as const;
---

<footer class="pie" data-ubicacion="footer">
  <div class="container-lf">
    <div class="pie-grid">
      {/* ------------------------------------------------ Marca y contacto */}
      <div class="pie-marca">
        <img src="/logo/nombre-360.webp" alt="Luis Flores" width="180" height="24" />
        <p class="pie-lema">
          IA, automatización y embudos de venta para negocios de Latinoamérica y
          España.
        </p>

        <ul class="pie-contacto" aria-label="Contacto">
          <li>
            <a href={SITIO.whatsapp} rel="noopener">
              <span class="pie-icono pie-icono-wa" aria-hidden="true">
                <Icono nombre="whatsapp" tamano={16} />
              </span>
              <span><span class="sr-only">WhatsApp </span>{SITIO.whatsappVisible}</span>
            </a>
          </li>
          <li>
            <a href={SITIO.correoEnlace}>
              <span class="pie-icono" aria-hidden="true">
                <Icono nombre="email" tamano={16} />
              </span>
              <span>{SITIO.email}</span>
            </a>
          </li>
        </ul>

        <ul class="pie-redes" aria-label="Redes sociales">
          {
            redes.map((r) => (
              <li>
                <a href={r.href} rel="noopener" aria-label={r.nombre}>
                  <Icono nombre={r.icono} tamano={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* --------------------------------------------------------- Servicios */}
      {
        grupos.map((g) => (
          <nav class="pie-col" aria-labelledby={g.id}>
            <h2 class="pie-titulo" id={g.id}>{g.titulo}</h2>
            <ul>
              {g.items.map((s) => (
                <li>
                  <a href={`/servicios/${s.slug}`}>{s.nombre}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      {/* ---------------------------------------------------------- Recursos */}
      <nav class="pie-col" aria-labelledby="pie-recursos">
        <h2 class="pie-titulo" id="pie-recursos">Recursos</h2>
        <ul>
          <li><a href="/sobre-mi">Sobre mí</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/roi">Calculadora de ROI</a></li>
          <li><a href="/guia">Guía gratis</a></li>
          <li><a href="/diagnostico">Llamada de diagnóstico</a></li>
          <li><a href="/contacto">Contacto</a></li>
          {
            proyectos.map((p) => (
              <li>
                <a href={p.url} rel="noopener">
                  {p.nombre} <span class="pie-etiqueta">Producto propio</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* ---------------------------------------------------------- Franja legal */}
    <div class="pie-base">
      {/*
        El NIF/NIE y la dirección postal viven SOLO en /aviso-legal.
        Antes salían en las 21 páginas del sitio. No los devuelvas aquí.
      */}
      <div class="pie-base-texto">
        <p>
          © {anio} {SITIO.nombreCompleto} · {SITIO.localidad}, {SITIO.region}, España
        </p>
        <p class="pie-ia">Si en algún lugar hablas con una IA, está indicado.</p>
      </div>

      <nav class="pie-legal" aria-label="Legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/politica-de-privacidad">Privacidad</a>
        <a href="/aviso-de-privacidad-latinoamerica">Privacidad Latinoamérica</a>
        <a href="/politica-de-cookies">Cookies</a>
        {
          hayBannerCookies && (
            <button type="button" class="pie-boton" data-cookie-settings>
              Configurar cookies
            </button>
          )
        }
      </nav>

      <a class="pie-arriba" href="#top">
        Volver arriba <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    border-top: 1px solid var(--color-line);
    background:
      radial-gradient(60rem 18rem at 15% 0%, rgb(0 123 255 / 0.07), transparent 70%),
      var(--color-navy-2);
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem) 1.75rem;
    margin-top: var(--space-8);
  }
  /* Filete de luz de marca sobre el borde superior. */
  .pie::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: min(36rem, 80%);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgb(0 123 255 / 0.6), rgb(139 92 246 / 0.6), transparent);
  }

  /* ------------------------------------------------------------- Rejilla */
  .pie-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .pie-marca {
    grid-column: 1 / -1;
  }
  @media (width >= 768px) {
    .pie-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (width >= 1024px) {
    .pie-grid {
      grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
    }
    .pie-marca {
      grid-column: auto;
      padding-right: 1rem;
    }
  }

  /* ------------------------------------------------------- Marca y contacto */
  .pie-marca img {
    height: 1.25rem;
    width: auto;
  }
  .pie-lema {
    max-width: 34ch;
    margin-top: 1rem;
    color: var(--color-soft);
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .pie-contacto {
    display: grid;
    gap: 0.625rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pie-contacto a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-soft);
    font-size: var(--step--1);
    transition: color var(--dur-micro) var(--ease);
  }
  .pie-contacto a:hover,
  .pie-contacto a:focus-visible {
    color: var(--color-ink);
  }
  .pie-icono {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-electric-soft);
  }
  .pie-icono-wa {
    border-color: rgb(37 211 102 / 0.4);
    color: var(--color-whatsapp);
  }
  .pie-redes {
    display: flex;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pie-redes a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    color: var(--color-soft);
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease);
  }
  .pie-redes a:hover,
  .pie-redes a:focus-visible {
    border-color: rgb(0 123 255 / 0.5);
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  /* -------------------------------------------------------------- Columnas */
  .pie-titulo {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .pie-col ul {
    display: grid;
    gap: 0.75rem;
    margin: 1.125rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pie-col a {
    color: var(--color-soft);
    font-size: var(--step--1);
    line-height: 1.4;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition:
      color var(--dur-base) ease,
      background-size var(--dur-micro) var(--ease);
  }
  .pie-col a:hover,
  .pie-col a:focus-visible {
    color: var(--color-ink);
    background-size: 100% 1px;
  }
  .pie-etiqueta {
    display: inline-block;
    margin-left: 0.375rem;
    padding: 0.0625rem 0.5rem;
    border: 1px solid rgb(251 191 36 / 0.4);
    border-radius: 999px;
    color: var(--acento-ambar);
    font-size: 0.6875rem;
    font-weight: 600;
    vertical-align: 0.1em;
  }

  /* --------------------------------------------------------- Franja legal */
  .pie-base {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .pie-base-texto {
    display: grid;
    gap: 0.25rem;
  }
  .pie-ia {
    color: var(--color-muted);
  }
  .pie-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .pie-legal a,
  .pie-boton {
    color: var(--color-soft);
    transition: color var(--dur-micro) var(--ease);
  }
  .pie-legal a:hover,
  .pie-legal a:focus-visible,
  .pie-boton:hover {
    color: var(--color-ink);
  }
  .pie-boton {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .pie-arriba {
    justify-self: start;
    color: var(--color-soft);
  }
  .pie-arriba:hover {
    color: var(--color-ink);
  }
  @media (width >= 1024px) {
    .pie-base {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: 2.5rem;
    }
    .pie-legal {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pie-redes a:hover {
      transform: none;
    }
  }
</style>
