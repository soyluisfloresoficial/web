---
/**
 * Asistente de IA de la web (27/10/2026).
 *
 * Manda la conversación a /api/chat (src/worker/index.ts), que responde con
 * Claude usando las instrucciones de src/worker/instrucciones.ts y la base de
 * conocimiento generada desde los datos de la web. Ver AGENTE.md.
 *
 * - Antes del primer mensaje se ve el aviso «Estás hablando con una IA»
 *   (transparencia exigida para los sistemas de IA que conversan con
 *   personas) y el pie enlaza la política de privacidad, que nombra al
 *   proveedor.
 * - Respaldo: si el Worker no tiene clave, falla o no responde, el chat
 *   vuelve a contestar en el navegador con las preguntas frecuentes y los
 *   servicios, sin IA, y lo dice. La web nunca se queda con un chat roto.
 * - La conversación vive solo en esta pestaña: no se guarda en el navegador
 *   ni en el servidor.
 *
 * Sin JavaScript no sirve para nada, así que se pinta oculto y es el script
 * quien lo muestra.
 */
import { faqPlana } from "../data/home";
import { servicios, SITIO } from "../data/servicios";

const documentos = [
  ...faqPlana.map((p) => ({ titulo: p.pregunta, texto: p.respuesta })),
  ...servicios.map((s) => ({
    titulo: s.nombre,
    texto: `${s.definicion} ${s.resumen}`,
    enlace: `/servicios/${s.slug}`,
  })),
];

const sugerencias = [
  "¿Qué se puede automatizar en mi negocio?",
  "¿Cómo es la primera llamada?",
  "¿Qué herramientas usas?",
];
---

<div class="chat" data-chat hidden>
  <button
    type="button"
    class="chat-boton"
    aria-expanded="false"
    aria-controls="chat-panel"
    data-chat-abrir
  >
    <span class="sr-only" data-chat-etiqueta>Abrir el asistente</span>
    <svg class="icono-abrir" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12Z" />
    </svg>
    <svg class="icono-cerrar" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>

  <section
    id="chat-panel"
    class="chat-panel"
    role="dialog"
    aria-labelledby="chat-titulo"
    hidden
    data-chat-panel
  >
    <header class="chat-cabecera">
      <div>
        <p id="chat-titulo" class="chat-titulo">Asistente de Luis Flores</p>
        <p class="chat-sub" data-chat-sub>Asistente de IA · responde con la información de la web</p>
      </div>
      <button type="button" class="chat-cerrar" data-chat-cerrar>
        <span class="sr-only">Cerrar</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </header>

    <div class="chat-registro" role="log" aria-live="polite" data-chat-registro>
      <p class="chat-aviso-ia">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M4 8h16v11H4zM12 4v4M9 13h.01M15 13h.01M9.5 16h5" />
        </svg>
        <span>
          <b>Estás hablando con una IA.</b> Puede equivocarse: lo que vale es lo que
          Luis te confirme por escrito. No escribas datos sensibles.
        </span>
      </p>
      <div class="mensaje mensaje-bot">
        <p>
          Hola, soy el asistente de la web de Luis. Pregúntame por los servicios, cómo
          trabaja, precios o plazos, o cuéntame a qué se dedica tu negocio y te digo qué
          se podría automatizar primero.
        </p>
      </div>
      <div class="sugerencias" data-chat-sugerencias>
        {
          sugerencias.map((s) => (
            <button type="button" class="sugerencia">
              {s}
            </button>
          ))
        }
      </div>
    </div>

    <form class="chat-form" data-chat-form>
      <label for="chat-pregunta" class="sr-only">Escribe tu pregunta</label>
      <input
        id="chat-pregunta"
        name="pregunta"
        type="text"
        maxlength="300"
        autocomplete="off"
        placeholder="Escribe tu pregunta…"
        data-chat-input
      />
      <button type="submit" class="chat-enviar" disabled data-chat-enviar>
        <span class="sr-only">Enviar</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p class="chat-nota" data-chat-nota>
      Asistente con IA (Claude, de Anthropic). Tus mensajes se usan solo para
      responderte y la web no los guarda. <a href="/politica-de-privacidad">Privacidad</a>
    </p>
  </section>

  <script
    type="application/json"
    data-chat-datos
    set:html={JSON.stringify({ documentos, email: SITIO.email, correo: SITIO.correoEnlace, whatsapp: SITIO.whatsapp })}
  />
</div>

<script>
  type Documento = { titulo: string; texto: string; enlace?: string };

  const raiz = document.querySelector<HTMLElement>("[data-chat]");
  const datosEl = raiz?.querySelector("[data-chat-datos]");

  if (raiz && datosEl) {
    const { documentos, email, correo, whatsapp } = JSON.parse(datosEl.textContent ?? "{}") as {
      documentos: Documento[];
      email: string;
      correo: string;
      whatsapp: string;
    };
    const abrir = raiz.querySelector<HTMLButtonElement>("[data-chat-abrir]")!;
    const etiqueta = raiz.querySelector<HTMLElement>("[data-chat-etiqueta]")!;
    const panel = raiz.querySelector<HTMLElement>("[data-chat-panel]")!;
    const cerrar = raiz.querySelector<HTMLButtonElement>("[data-chat-cerrar]")!;
    const registro = raiz.querySelector<HTMLElement>("[data-chat-registro]")!;
    const form = raiz.querySelector<HTMLFormElement>("[data-chat-form]")!;
    const input = raiz.querySelector<HTMLInputElement>("[data-chat-input]")!;
    const enviar = raiz.querySelector<HTMLButtonElement>("[data-chat-enviar]")!;
    const sub = raiz.querySelector<HTMLElement>("[data-chat-sub]")!;
    const nota = raiz.querySelector<HTMLElement>("[data-chat-nota]")!;

    // ------------------------------------------------------------ Búsqueda
    const VACIAS = new Set(
      "a al algo como con cual cuales de del el en es esta este esto hay la las lo los me mi mis o para pero por puede puedo que se si sin su sus te tu tus un una uno y ya yo".split(
        " ",
      ),
    );
    const palabras = (t: string) =>
      t
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[^a-z0-9ñ\s]/g, " ")
        .split(/\s+/)
        .filter((p) => p.length > 1 && !VACIAS.has(p))
        // Raíz tosca de seis letras: «automatizaciones», «automatizar» y
        // «automatizo» se quedan en «automa»; «precios», en «precio».
        .map((p) => (p.length > 6 ? p.slice(0, 6) : p));

    const indice = documentos.map((d) => ({
      d,
      titulo: new Set(palabras(d.titulo)),
      texto: new Set(palabras(d.texto)),
    }));

    // Formas habituales de preguntar lo mismo con otras palabras. Clave y
    // valores ya en forma de raíz (seis letras como máximo).
    const SINONIMOS: Record<string, string[]> = {
      precio: ["cuesta", "cuanto"],
      coste: ["cuesta", "cuanto"],
      costar: ["cuesta"],
      tarifa: ["cuesta"],
      presup: ["cuesta", "propue"],
      plazo: ["tarda", "proyec"],
      tiempo: ["tarda"],
      duraci: ["tarda"],
      plazos: ["tarda", "proyec"],
      contra: ["permanencia", "cuotas"],
      privac: ["rgpd", "datos"],
    };

    const responder = (pregunta: string): Documento | null => {
      const base = palabras(pregunta);
      const q = [...new Set(base.flatMap((w) => [w, ...(SINONIMOS[w] ?? [])].map((x) => x.slice(0, 6))))];
      if (!q.length) return null;
      let mejor: Documento | null = null;
      let puntos = 0;
      for (const { d, titulo, texto } of indice) {
        let p = 0;
        for (const w of q) {
          if (titulo.has(w)) p += 3;
          else if (texto.has(w)) p += 1;
        }
        if (p > puntos) {
          puntos = p;
          mejor = d;
        }
      }
      // Al menos una palabra del título, o dos del texto.
      return puntos >= 2 ? mejor : null;
    };

    // ------------------------------------------------------------ Pintado
    // Todo con textContent y createElement: nada de innerHTML, así que lo que
    // escribe la persona nunca se interpreta como HTML.
    const pintar = (de: "bot" | "usuario", partes: (string | HTMLElement)[]) => {
      const caja = document.createElement("div");
      caja.className = `mensaje mensaje-${de}`;
      const p = document.createElement("p");
      for (const parte of partes) p.append(parte);
      caja.append(p);
      registro.append(caja);
      registro.scrollTop = registro.scrollHeight;
    };

    const enlace = (texto: string, href: string) => {
      const a = document.createElement("a");
      a.textContent = texto;
      a.href = href;
      return a;
    };

    // Convierte en enlaces solo las direcciones de confianza que puede dar el
    // asistente (la propia web, WhatsApp, Smilbot y el correo). Todo lo demás
    // se queda como texto: la respuesta nunca se interpreta como HTML.
    const ENLACE =
      /(https:\/\/(?:www\.)?soyluisflores\.es[^\s)]*|https:\/\/wa\.me\/[^\s)]*|https:\/\/smilbot\.com[^\s)]*|[a-z0-9._%+-]+@soyluisflores\.es)/gi;
    const conEnlaces = (texto: string): (string | HTMLElement)[] => {
      const partes: (string | HTMLElement)[] = [];
      let desde = 0;
      for (const m of texto.matchAll(ENLACE)) {
        let url = m[0];
        // Un punto o una coma al final son de la frase, no del enlace.
        const sobra = /[.,;:!?]+$/.exec(url)?.[0] ?? "";
        url = url.slice(0, url.length - sobra.length);
        const i = m.index ?? 0;
        if (i > desde) partes.push(texto.slice(desde, i));
        if (url.includes("@") && !url.startsWith("http")) {
          partes.push(enlace(url, url.toLowerCase() === email ? correo : `mailto:${url}`));
        } else {
          const propio = /^https:\/\/(?:www\.)?soyluisflores\.es/i.test(url);
          const a = enlace(url.replace(/^https:\/\/(www\.)?/i, ""), propio ? new URL(url).pathname : url);
          if (!propio) a.rel = "noopener";
          partes.push(a);
        }
        desde = i + url.length;
      }
      if (desde < texto.length) partes.push(texto.slice(desde));
      return partes;
    };

    // ------------------------------------------------------------ IA
    type Turno = { rol: "usuario" | "asistente"; texto: string };
    const historial: Turno[] = [];
    // Si la IA no está disponible, el resto de la visita se responde en local.
    let sinIA = false;
    let esperando = false;

    const pasarASinIA = () => {
      sinIA = true;
      // Sin IA detrás, el aviso de IA ya no es verdad.
      raiz.querySelector<HTMLElement>(".chat-aviso-ia")?.remove();
      sub.textContent = "Respuestas de las preguntas frecuentes de la web";
      nota.textContent = "Ahora respondo con las preguntas frecuentes de la web, sin IA. No se guarda ni se envía lo que escribes.";
    };

    const escribiendo = () => {
      const caja = document.createElement("div");
      caja.className = "mensaje mensaje-bot escribiendo";
      caja.setAttribute("aria-label", "El asistente está escribiendo");
      for (let i = 0; i < 3; i++) caja.append(document.createElement("span"));
      registro.append(caja);
      registro.scrollTop = registro.scrollHeight;
      return caja;
    };

    /** Respuesta de la IA, o null si hay que usar el respaldo local. */
    const preguntarIA = async (): Promise<string | null> => {
      try {
        const r = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mensajes: historial.slice(-12) }),
          signal: AbortSignal.timeout(30_000),
        });
        const datos = (await r.json().catch(() => ({}))) as { respuesta?: string; error?: string };
        if (r.ok && datos.respuesta) return datos.respuesta;
        if (datos.error === "sin-ia" || r.status === 404 || r.status === 405) {
          pasarASinIA();
          return null;
        }
        // Límite, saturación o fallo puntual: el Worker ya trae un mensaje.
        return datos.respuesta ?? null;
      } catch {
        return null;
      }
    };

    const respuestaLocal = (t: string) => {
      const r = responder(t);
      if (r) {
        const partes: (string | HTMLElement)[] = [
          r.enlace ? `${r.titulo}: ${r.texto} ` : `${r.texto} `,
        ];
        if (r.enlace) partes.push(enlace("Ver el servicio", r.enlace));
        pintar("bot", partes);
      } else {
        pintar("bot", [
          "Esa pregunta no está en las frecuentes. Lo mejor es que lo hablemos: ",
          enlace("agenda una llamada", "/contacto"),
          ", escríbeme por ",
          enlace("WhatsApp", whatsapp),
          " o a ",
          enlace(email, correo),
          ".",
        ]);
      }
    };

    const preguntar = async (texto: string) => {
      const t = texto.trim().slice(0, 800);
      if (!t || esperando) return;
      raiz.querySelector("[data-chat-sugerencias]")?.remove();
      pintar("usuario", [t]);

      if (sinIA) return respuestaLocal(t);

      historial.push({ rol: "usuario", texto: t });
      esperando = true;
      input.disabled = true;
      enviar.disabled = true;
      const puntos = escribiendo();
      const respuesta = await preguntarIA();
      puntos.remove();
      esperando = false;
      input.disabled = false;
      input.focus();

      if (respuesta) {
        historial.push({ rol: "asistente", texto: respuesta });
        pintar("bot", conEnlaces(respuesta));
      } else {
        // La pregunta se queda sin turno de respuesta: se quita para que el
        // historial siga alternando si la IA vuelve en el siguiente mensaje.
        historial.pop();
        respuestaLocal(t);
      }
    };

    // ------------------------------------------------------------ Apertura
    // Botones de fuera que también abren el asistente (el de la barra del
    // celular). Al cerrar, el foco vuelve al botón con el que se abrió.
    const externos = [...document.querySelectorAll<HTMLButtonElement>("[data-abrir-chat]")];
    let origen: HTMLElement | null = null;
    externos.forEach((b) => {
      b.hidden = false;
      b.addEventListener("click", () => {
        origen = b;
        estado(panel.hidden);
      });
    });

    const estado = (abierto: boolean) => {
      raiz.toggleAttribute("data-abierto", abierto);
      abrir.setAttribute("aria-expanded", String(abierto));
      externos.forEach((b) => b.setAttribute("aria-expanded", String(abierto)));
      etiqueta.textContent = abierto ? "Cerrar el asistente" : "Abrir el asistente";
      panel.hidden = !abierto;
      if (abierto) requestAnimationFrame(() => input.focus());
      else {
        (origen ?? abrir).focus();
        origen = null;
      }
    };

    abrir.addEventListener("click", () => estado(panel.hidden));
    cerrar.addEventListener("click", () => estado(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) estado(false);
    });

    input.addEventListener("input", () => {
      enviar.disabled = input.value.trim().length === 0;
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const texto = input.value;
      input.value = "";
      enviar.disabled = true;
      void preguntar(texto);
    });
    raiz.querySelectorAll<HTMLButtonElement>(".sugerencia").forEach((b) =>
      b.addEventListener("click", () => void preguntar(b.textContent ?? "")),
    );

    raiz.hidden = false;
  }
</script>

<style>
  .chat {
    position: fixed;
    right: 1rem;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    z-index: 60;
  }
  .chat[hidden] {
    display: none;
  }
  /* En móvil va por encima de la barra de reserva. */
  @media (width < 1024px) {
    .chat {
      bottom: calc(5.25rem + env(safe-area-inset-bottom));
    }
    /* Con la barra del celular, el botón del chat va dentro de ella: aquí
       solo queda el panel, que se abre justo encima de la barra. */
    :global(body:has(.barra-movil)) .chat-boton {
      display: none;
    }
    :global(body:has(.barra-movil)) .chat {
      bottom: calc(7rem + env(safe-area-inset-bottom));
    }
    :global(body:has(.barra-movil)) .chat-panel {
      bottom: 0;
    }
  }
  /* Mientras el banner de cookies está abierto, el chat se aparta: en
     producción el botón quedaba encima de los botones del banner. */
  :global(body:has([data-cookie-banner]:not([hidden]))) .chat {
    display: none;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chat-boton {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: var(--grad-cta);
    color: #fff;
    box-shadow: var(--shadow-2);
    cursor: pointer;
  }
  .chat-boton svg {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease);
  }
  .icono-cerrar {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .chat[data-abierto] .icono-abrir {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .chat[data-abierto] .icono-cerrar {
    opacity: 1;
    transform: none;
  }
  .chat-boton:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 4.25rem;
    width: min(23rem, calc(100dvw - 2rem));
    /* dvh y no vh: en iOS, 100vh es la altura con la barra del navegador
       escondida y el panel se metía por debajo. */
    height: min(32rem, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    background: var(--color-navy-2);
    border: 1px solid var(--color-line);
    border-radius: 18px;
    box-shadow: var(--shadow-3);
    overflow: hidden;
  }
  .chat-panel[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-panel:not([hidden]) {
      animation: chat-entra 0.22s var(--ease);
    }
  }
  @keyframes chat-entra {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  .chat-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .chat-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  .chat-sub {
    font-size: 0.75rem;
    color: var(--color-soft);
  }
  .chat-cerrar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-soft);
    cursor: pointer;
  }
  .chat-cerrar:hover {
    background: rgb(255 255 255 / 0.08);
    color: var(--color-ink);
  }

  .chat-registro {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
  }
  .chat-registro :global(.mensaje) {
    max-width: 88%;
    padding: 0.625rem 0.875rem;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .chat-registro :global(.mensaje-bot) {
    align-self: flex-start;
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
    background: var(--color-surface);
    color: var(--color-soft);
  }
  .chat-registro :global(.mensaje-usuario) {
    align-self: flex-end;
    border: 1px solid rgb(0 123 255 / 0.3);
    border-bottom-right-radius: 4px;
    background: rgb(0 123 255 / 0.16);
    color: var(--color-ink);
  }
  .chat-registro :global(.mensaje a) {
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chat-aviso-ia {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(139 92 246 / 0.35);
    border-radius: 12px;
    background: rgb(139 92 246 / 0.1);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-soft);
  }
  .chat-aviso-ia svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-violet);
  }
  .chat-aviso-ia b {
    color: var(--color-ink);
  }

  /* Tres puntos mientras responde. */
  .chat-registro :global(.escribiendo) {
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.8rem 0.9rem;
  }
  .chat-registro :global(.escribiendo span) {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-soft);
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-registro :global(.escribiendo span) {
      animation: punto 1s var(--ease) infinite;
    }
    .chat-registro :global(.escribiendo span:nth-child(2)) {
      animation-delay: 0.15s;
    }
    .chat-registro :global(.escribiendo span:nth-child(3)) {
      animation-delay: 0.3s;
    }
  }
  @keyframes punto {
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .chat-nota a {
    color: var(--color-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sugerencias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
