---
/**
 * Asistente de IA de la web (27/10/2026).
 *
 * Manda la conversación a /api/chat (src/worker/index.ts), que responde con
 * Claude usando las instrucciones de src/worker/instrucciones.ts y la base de
 * conocimiento generada desde los datos de la web. Ver AGENTE.md.
 *
 * - Antes del primer mensaje se ve el aviso «Estás hablando con una IA»
 *   (transparencia exigida para los sistemas de IA que conversan con
 *   personas) y el pie enlaza la política de privacidad, que nombra al
 *   proveedor.
 * - Respaldo: si el Worker no tiene clave, falla o no responde, el chat
 *   vuelve a contestar en el navegador con las preguntas frecuentes y los
 *   servicios, sin IA, y lo dice. La web nunca se queda con un chat roto.
 * - La conversación vive solo en esta pestaña: no se guarda en el navegador
 *   ni en el servidor.
 *
 * Sin JavaScript no sirve para nada, así que se pinta oculto y es el script
 * quien lo muestra.
 */
import { faqPlana } from "../data/home";
import { servicios, SITIO } from "../data/servicios";

const documentos = [
  ...faqPlana.map((p) => ({ titulo: p.pregunta, texto: p.respuesta })),
  ...servicios.map((s) => ({
    titulo: s.nombre,
    texto: `${s.definicion} ${s.resumen}`,
    enlace: `/servicios/${s.slug}`,
  })),
];

const sugerencias = [
  "¿Qué se puede automatizar en mi negocio?",
  "¿Cuánto cuesta?",
  "¿Cómo es la llamada gratis?",
];
---

<div class="chat" data-chat hidden>
  <button
    type="button"
    class="chat-boton"
    aria-expanded="false"
    aria-controls="chat-panel"
    data-chat-abrir
  >
    <span class="sr-only" data-chat-etiqueta>Abrir el asistente</span>
    <svg class="icono-abrir" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12Z" />
    </svg>
    <svg class="icono-cerrar" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>

  <section
    id="chat-panel"
    class="chat-panel"
    role="dialog"
    aria-labelledby="chat-titulo"
    hidden
    data-chat-panel
  >
    <header class="chat-cabecera">
      <div>
        <p id="chat-titulo" class="chat-titulo">Asistente de Luis</p>
        <p class="chat-sub" data-chat-sub>IA · responde en segundos</p>
      </div>
      <a class="chat-agendar" href="/contacto">Agendar<span class="chat-agendar-largo">&nbsp;llamada</span></a>
      <button type="button" class="chat-cerrar" data-chat-cerrar>
        <span class="sr-only">Cerrar</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </header>

    <div class="chat-registro" role="log" aria-live="polite" data-chat-registro>
      <p class="chat-aviso-ia">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M4 8h16v11H4zM12 4v4M9 13h.01M15 13h.01M9.5 16h5" />
        </svg>
        <span>
          <b>Estás hablando con una IA.</b> Puede equivocarse: lo que vale es lo que
          Luis te confirme por escrito. No escribas datos sensibles.
        </span>
      </p>
      <div class="mensaje mensaje-bot">
        <p>Hola, soy el asistente de la web de Luis.</p>
        <p>
          Cuéntame a qué se dedica tu negocio y te digo qué se podría automatizar
          primero, o elige una pregunta:
        </p>
      </div>
      <div class="sugerencias" data-chat-sugerencias>
        {
          sugerencias.map((s) => (
            <button type="button" class="sugerencia">
              {s}
            </button>
          ))
        }
      </div>
    </div>

    <form class="chat-form" data-chat-form>
      <label for="chat-pregunta" class="sr-only">Escribe tu pregunta</label>
      <input
        id="chat-pregunta"
        name="pregunta"
        type="text"
        maxlength="300"
        autocomplete="off"
        placeholder="Escribe tu pregunta…"
        data-chat-input
      />
      <button type="submit" class="chat-enviar" disabled data-chat-enviar>
        <span class="sr-only">Enviar</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>

    <p class="chat-nota" data-chat-nota>
      Asistente con IA (Claude, de Anthropic). Tus mensajes se usan solo para
      responderte y la web no los guarda. <a href="/politica-de-privacidad">Privacidad</a>
    </p>
  </section>

  <script
    type="application/json"
    data-chat-datos
    set:html={JSON.stringify({ documentos, email: SITIO.email, correo: SITIO.correoEnlace, whatsapp: SITIO.whatsapp })}
  />
</div>

<script>
  type Documento = { titulo: string; texto: string; enlace?: string };

  const raiz = document.querySelector<HTMLElement>("[data-chat]");
  const datosEl = raiz?.querySelector("[data-chat-datos]");

  if (raiz && datosEl) {
    const { documentos, email, correo, whatsapp } = JSON.parse(datosEl.textContent ?? "{}") as {
      documentos: Documento[];
      email: string;
      correo: string;
      whatsapp: string;
    };
    const abrir = raiz.querySelector<HTMLButtonElement>("[data-chat-abrir]")!;
    const etiqueta = raiz.querySelector<HTMLElement>("[data-chat-etiqueta]")!;
    const panel = raiz.querySelector<HTMLElement>("[data-chat-panel]")!;
    const cerrar = raiz.querySelector<HTMLButtonElement>("[data-chat-cerrar]")!;
    const registro = raiz.querySelector<HTMLElement>("[data-chat-registro]")!;
    const form = raiz.querySelector<HTMLFormElement>("[data-chat-form]")!;
    const input = raiz.querySelector<HTMLInputElement>("[data-chat-input]")!;
    const enviar = raiz.querySelector<HTMLButtonElement>("[data-chat-enviar]")!;
    const sub = raiz.querySelector<HTMLElement>("[data-chat-sub]")!;
    const nota = raiz.querySelector<HTMLElement>("[data-chat-nota]")!;

    // Medición (ver Medicion.astro y gtm/LEEME.md). Solo existe dataLayer si
    // hay Tag Manager, y GTM solo carga si la persona aceptó las cookies.
    // Nunca se manda lo que escribe la persona: solo qué hizo.
    const medir = (event: string, extra: Record<string, string> = {}) =>
      (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event, ...extra, page_path: location.pathname });

    // Zona horaria del visitante: el asistente le habla en su hora.
    let zona = "Europe/Madrid";
    try {
      zona = Intl.DateTimeFormat().resolvedOptions().timeZone || zona;
    } catch {
      /* navegador sin zona: se queda Madrid */
    }

    // ------------------------------------------------------------ Búsqueda
    const VACIAS = new Set(
      "a al algo como con cual cuales de del el en es esta este esto hay la las lo los me mi mis o para pero por puede puedo que se si sin su sus te tu tus un una uno y ya yo".split(
        " ",
      ),
    );
    const palabras = (t: string) =>
      t
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[^a-z0-9ñ\s]/g, " ")
        .split(/\s+/)
        .filter((p) => p.length > 1 && !VACIAS.has(p))
        // Raíz tosca de seis letras: «automatizaciones», «automatizar» y
        // «automatizo» se quedan en «automa»; «precios», en «precio».
        .map((p) => (p.length > 6 ? p.slice(0, 6) : p));

    const indice = documentos.map((d) => ({
      d,
      titulo: new Set(palabras(d.titulo)),
      texto: new Set(palabras(d.texto)),
    }));

    // Formas habituales de preguntar lo mismo con otras palabras. Clave y
    // valores ya en forma de raíz (seis letras como máximo).
    const SINONIMOS: Record<string, string[]> = {
      precio: ["cuesta", "cuanto"],
      coste: ["cuesta", "cuanto"],
      costar: ["cuesta"],
      tarifa: ["cuesta"],
      presup: ["cuesta", "propue"],
      plazo: ["tarda", "proyec"],
      tiempo: ["tarda"],
      duraci: ["tarda"],
      plazos: ["tarda", "proyec"],
      contra: ["permanencia", "cuotas"],
      privac: ["rgpd", "datos"],
    };

    const responder = (pregunta: string): Documento | null => {
      const base = palabras(pregunta);
      const q = [...new Set(base.flatMap((w) => [w, ...(SINONIMOS[w] ?? [])].map((x) => x.slice(0, 6))))];
      if (!q.length) return null;
      let mejor: Documento | null = null;
      let puntos = 0;
      for (const { d, titulo, texto } of indice) {
        let p = 0;
        for (const w of q) {
          if (titulo.has(w)) p += 3;
          else if (texto.has(w)) p += 1;
        }
        if (p > puntos) {
          puntos = p;
          mejor = d;
        }
      }
      // Al menos una palabra del título, o dos del texto.
      return puntos >= 2 ? mejor : null;
    };

    // ------------------------------------------------------------ Pintado
    // Todo con textContent y createElement: nada de innerHTML, así que lo que
    // escribe la persona nunca se interpreta como HTML.
    const pintar = (de: "bot" | "usuario", partes: (string | HTMLElement)[]) => {
      const caja = document.createElement("div");
      caja.className = `mensaje mensaje-${de}`;
      const p = document.createElement("p");
      for (const parte of partes) p.append(parte);
      caja.append(p);
      registro.append(caja);
      registro.scrollTop = registro.scrollHeight;
    };

    const enlace = (texto: string, href: string) => {
      const a = document.createElement("a");
      a.textContent = texto;
      a.href = href;
      return a;
    };

    // Convierte en enlaces solo las direcciones de confianza que puede dar el
    // asistente (la propia web, WhatsApp, Smilbot y el correo). Todo lo demás
    // se queda como texto: la respuesta nunca se interpreta como HTML.
    const ENLACE =
      /(https:\/\/(?:www\.)?soyluisflores\.es[^\s)]*|https:\/\/wa\.me\/[^\s)]*|https:\/\/smilbot\.com[^\s)]*|[a-z0-9._%+-]+@soyluisflores\.es)/gi;
    const conEnlaces = (texto: string): (string | HTMLElement)[] => {
      const partes: (string | HTMLElement)[] = [];
      let desde = 0;
      for (const m of texto.matchAll(ENLACE)) {
        let url = m[0];
        // Un punto o una coma al final son de la frase, no del enlace.
        const sobra = /[.,;:!?]+$/.exec(url)?.[0] ?? "";
        url = url.slice(0, url.length - sobra.length);
        const i = m.index ?? 0;
        if (i > desde) partes.push(texto.slice(desde, i));
        if (url.includes("@") && !url.startsWith("http")) {
          partes.push(enlace(url, url.toLowerCase() === email ? correo : `mailto:${url}`));
        } else {
          const propio = /^https:\/\/(?:www\.)?soyluisflores\.es/i.test(url);
          const a = enlace(url.replace(/^https:\/\/(www\.)?/i, ""), propio ? new URL(url).pathname : url);
          if (!propio) a.rel = "noopener";
          partes.push(a);
        }
        desde = i + url.length;
      }
      if (desde < texto.length) partes.push(texto.slice(desde));
      return partes;
    };

    // La respuesta de la IA llega en texto plano: los párrafos van separados
    // por una línea en blanco y las listas son líneas que empiezan por «- ».
    // Se pinta en bloques para que se lea fácil en el celular.
    const pintarRespuesta = (texto: string) => {
      const caja = document.createElement("div");
      caja.className = "mensaje mensaje-bot";
      for (const bloque of texto.split(/\n\s*\n/)) {
        const lineas = bloque.split("\n").map((l) => l.trim()).filter(Boolean);
        let lista: HTMLUListElement | null = null;
        let parrafo: HTMLParagraphElement | null = null;
        for (const linea of lineas) {
          const item = /^[-•*]\s+(.*)$/.exec(linea);
          if (item) {
            parrafo = null;
            if (!lista) caja.append((lista = document.createElement("ul")));
            const li = document.createElement("li");
            li.append(...conEnlaces(item[1]));
            lista.append(li);
          } else {
            lista = null;
            if (parrafo) parrafo.append(" ");
            else caja.append((parrafo = document.createElement("p")));
            parrafo.append(...conEnlaces(linea));
          }
        }
      }
      registro.append(caja);
      // Se ve el principio de la respuesta, no el final: así se lee de arriba abajo.
      registro.scrollTop = caja.offsetTop - registro.offsetTop - 12;
    };

    // Respuestas rápidas: el asistente cierra algunas respuestas con una línea
    // «Opciones: A | B | C» (ver instrucciones.ts). Esa línea no se muestra:
    // se convierte en botones que contestan con un toque.
    const separarOpciones = (respuesta: string) => {
      const m = /\n\s*Opciones:\s*(.+)\s*$/i.exec(respuesta);
      if (!m) return { texto: respuesta, opciones: [] as string[] };
      const opciones = m[1]
        .split("|")
        .map((o) => o.trim().replace(/[.«»"]/g, ""))
        .filter((o) => o && o.length <= 40 && !/https?:|@/.test(o))
        .slice(0, 4);
      return { texto: respuesta.slice(0, m.index).trim(), opciones };
    };

    const pintarOpciones = (opciones: string[]) => {
      if (!opciones.length) return;
      const caja = document.createElement("div");
      caja.className = "sugerencias respuestas-rapidas";
      caja.dataset.chatSugerencias = "";
      for (const texto of opciones) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "sugerencia";
        b.textContent = texto;
        b.addEventListener("click", () => {
          medir("chat_quick_reply", { chat_option: texto.slice(0, 40) });
          if (/formulario/i.test(texto)) {
            location.href = "/contacto";
          } else if (/^otro sector$/i.test(texto)) {
            // «Otro sector»: mejor que lo escriba con sus palabras.
            caja.remove();
            input.placeholder = "Cuéntamelo con tus palabras…";
            input.focus();
          } else {
            void preguntar(texto, "respuesta_rapida");
          }
        });
        caja.append(b);
      }
      registro.append(caja);
      // Que se vean los botones sin perder el principio de la respuesta.
      const mensaje = caja.previousElementSibling as HTMLElement | null;
      const inicio = (mensaje ?? caja).offsetTop - registro.offsetTop - 12;
      const fin = caja.offsetTop - registro.offsetTop + caja.offsetHeight + 12 - registro.clientHeight;
      registro.scrollTop = Math.min(inicio, Math.max(registro.scrollTop, fin));
    };

    // ------------------------------------------------------------ IA
    type Turno = { rol: "usuario" | "asistente"; texto: string };
    const historial: Turno[] = [];
    // Si la IA no está disponible, el resto de la visita se responde en local.
    let sinIA = false;
    let esperando = false;

    const pasarASinIA = () => {
      sinIA = true;
      // Sin IA detrás, el aviso de IA ya no es verdad.
      raiz.querySelector<HTMLElement>(".chat-aviso-ia")?.remove();
      sub.textContent = "Respuestas de las preguntas frecuentes de la web";
      nota.textContent = "Ahora respondo con las preguntas frecuentes de la web, sin IA. No se guarda ni se envía lo que escribes.";
    };

    const escribiendo = () => {
      const caja = document.createElement("div");
      caja.className = "mensaje mensaje-bot escribiendo";
      caja.setAttribute("aria-label", "El asistente está escribiendo");
      for (let i = 0; i < 3; i++) caja.append(document.createElement("span"));
      registro.append(caja);
      registro.scrollTop = registro.scrollHeight;
      return caja;
    };

    // ------------------------------------------------------------ Cita
    // El asistente prepara la cita (src/worker/chat-agenda.ts) y aquí se
    // pinta una tarjeta para revisarla. La reserva la hace la persona al
    // confirmar, con la casilla de privacidad, por POST /api/agenda: la misma
    // validación y los mismos correos que el formulario de /contacto.
    type Cita = {
      inicio: string;
      nombre: string;
      correo: string;
      telefono: string;
      empresa: string;
      sitioWeb: string;
      sector: string;
      equipo: string;
      servicio: string;
      mensaje: string;
    };

    const ZONA_MADRID = "Europe/Madrid";
    const fechaCita = (ms: number, zonaHora: string, conDia = true) =>
      new Intl.DateTimeFormat("es", {
        timeZone: zonaHora,
        ...(conDia ? { weekday: "long", day: "numeric", month: "long" } : {}),
        hour: "2-digit",
        minute: "2-digit",
      }).format(ms);
    const cuandoCita = (ms: number) =>
      zona === ZONA_MADRID ? fechaCita(ms, zona) : `${fechaCita(ms, zona)} (${fechaCita(ms, ZONA_MADRID, false)} en Madrid)`;

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = "", texto = "") => {
      const n = document.createElement(tag);
      if (clase) n.className = clase;
      if (texto) n.textContent = texto;
      return n;
    };

    const pintarCita = (cita: Cita) => {
      // Solo una tarjeta por confirmar: si el asistente corrige un dato, la nueva sustituye a la anterior.
      raiz.querySelectorAll("[data-chat-cita]:not([data-confirmada])").forEach((t) => t.remove());
      const ms = Date.parse(cita.inicio);
      const tarjeta = el("div", "cita-tarjeta");
      tarjeta.dataset.chatCita = "";
      tarjeta.append(el("p", "cita-titulo", "Tu llamada de diagnóstico (30 min, Google Meet)"));

      const lista = el("dl", "cita-datos");
      const filas: [string, string][] = [
        ["Cuándo", cuandoCita(ms)],
        ["Nombre", cita.nombre],
        ["Correo", cita.correo],
        ["WhatsApp", cita.telefono],
        ["Negocio", [cita.empresa, cita.sector].filter(Boolean).join(" · ")],
        ["Web", cita.sitioWeb],
        ["Te interesa", cita.servicio],
      ];
      for (const [k, v] of filas) {
        if (!v) continue;
        const fila = el("div");
        fila.append(el("dt", "", k), el("dd", "", v));
        lista.append(fila);
      }
      tarjeta.append(lista);

      const permiso = el("label", "cita-permiso");
      const casilla = el("input");
      casilla.type = "checkbox";
      const textoPermiso = el("span");
      textoPermiso.append(
        "Acepto que se traten estos datos solo para agendar y preparar la llamada. Puedo pedir que se borren en hola@soyluisflores.es. Más en la ",
        Object.assign(enlace("política de privacidad", "/politica-de-privacidad"), { target: "_blank", rel: "noopener" }),
        " y el ",
        Object.assign(enlace("aviso para Latinoamérica", "/aviso-de-privacidad-latinoamerica"), { target: "_blank", rel: "noopener" }),
        ".",
      );
      permiso.append(casilla, textoPermiso);
      tarjeta.append(permiso);

      const aviso = el("p", "cita-error");
      aviso.setAttribute("role", "alert");
      aviso.hidden = true;
      const boton = el("button", "cita-confirmar", "Confirmar llamada");
      boton.type = "button";
      tarjeta.append(aviso, boton);

      const error = (t: string) => {
        aviso.textContent = t;
        aviso.hidden = !t;
      };

      boton.addEventListener("click", async () => {
        if (!casilla.checked) {
          error("Marca la casilla de privacidad para poder agendar la llamada.");
          casilla.focus();
          return;
        }
        error("");
        boton.disabled = true;
        boton.textContent = "Agendando…";
        let estadoHttp = 0;
        let meet: string | null = null;
        try {
          const r = await fetch("/api/agenda", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...cita, acepto: true, web: "", zona, origen: `chat-asistente · ${location.pathname}` }),
          });
          estadoHttp = r.status;
          meet = ((await r.json().catch(() => ({}))) as { meet?: string | null }).meet ?? null;
        } catch {
          estadoHttp = 0;
        }

        if (estadoHttp === 200) {
          medir("generate_lead", { form_id: "chat-asistente", method: "asistente-ia" });
          tarjeta.dataset.confirmada = "";
          raiz.querySelectorAll("[data-chat-sugerencias]").forEach((s) => s.remove());
          tarjeta.replaceChildren(
            el("p", "cita-titulo", "Listo, tu llamada quedó agendada"),
            el("p", "", cuandoCita(ms)),
            el(
              "p",
              "",
              `Te envié la invitación a ${cita.correo}${meet ? " con el enlace de Google Meet" : ""}. Si no la ves en unos minutos, revisa spam o promociones.`,
            ),
          );
          // Que el asistente sepa que ya está agendada si la conversación sigue.
          const ultimo = historial[historial.length - 1];
          if (ultimo?.rol === "asistente") {
            ultimo.texto = `${ultimo.texto}\n\n(El visitante confirmó la cita: ${fechaCita(ms, zona)}.)`.slice(-1500);
          }
          registro.scrollTop = tarjeta.offsetTop - registro.offsetTop - 12;
          return;
        }

        boton.disabled = false;
        boton.textContent = "Confirmar llamada";
        if (estadoHttp === 409) {
          error("Esa hora se acaba de ocupar. Pídeme otra y te muestro las libres.");
          pintarOpciones(["Muéstrame otras horas"]);
        } else if (estadoHttp === 400) {
          error("Algún dato no es válido (revisa el correo). Dime cuál cambiar y lo corrijo.");
        } else if (estadoHttp === 429) {
          error("Demasiados intentos seguidos. Espera un minuto y vuelve a confirmar.");
        } else {
          error("No pude agendar ahora. Puedes hacerlo en soyluisflores.es/contacto o por WhatsApp.");
        }
      });

      registro.append(tarjeta);
      medir("chat_booking_shown");
      registro.scrollTop = tarjeta.offsetTop - registro.offsetTop - 12;
    };

    /** Respuesta de la IA, o null si hay que usar el respaldo local. */
    const preguntarIA = async (): Promise<{ respuesta: string; cita?: Cita } | null> => {
      try {
        const r = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mensajes: historial.slice(-24), zona }),
          // Más margen: si mira horarios o prepara la cita, tarda más.
          signal: AbortSignal.timeout(60_000),
        });
        const datos = (await r.json().catch(() => ({}))) as { respuesta?: string; error?: string; cita?: Cita };
        if (r.ok && datos.respuesta) return { respuesta: datos.respuesta, cita: datos.cita };
        if (datos.error === "sin-ia" || r.status === 404 || r.status === 405) {
          pasarASinIA();
          return null;
        }
        // Límite, saturación o fallo puntual: el Worker ya trae un mensaje.
        return datos.respuesta ? { respuesta: datos.respuesta } : null;
      } catch {
        return null;
      }
    };

    const respuestaLocal = (t: string) => {
      const r = responder(t);
      if (r) {
        const partes: (string | HTMLElement)[] = [
          r.enlace ? `${r.titulo}: ${r.texto} ` : `${r.texto} `,
        ];
        if (r.enlace) partes.push(enlace("Ver el servicio", r.enlace));
        pintar("bot", partes);
      } else {
        pintar("bot", [
          "Esa pregunta no está en las frecuentes. Lo mejor es que lo hablemos: ",
          enlace("agenda una llamada", "/contacto"),
          ", escríbeme por ",
          enlace("WhatsApp", whatsapp),
          " o a ",
          enlace(email, correo),
          ".",
        ]);
      }
    };

    const preguntar = async (texto: string, via: "escrito" | "sugerencia" | "respuesta_rapida" = "escrito") => {
      const t = texto.trim().slice(0, 800);
      if (!t || esperando) return;
      medir("chat_message", { chat_method: via, chat_turn: String(historial.length / 2 + 1) });
      raiz.querySelectorAll("[data-chat-sugerencias]").forEach((s) => s.remove());
      input.placeholder = "Escribe tu pregunta…";
      pintar("usuario", [t]);

      if (sinIA) return respuestaLocal(t);

      historial.push({ rol: "usuario", texto: t });
      esperando = true;
      input.disabled = true;
      enviar.disabled = true;
      const puntos = escribiendo();
      const ia = await preguntarIA();
      puntos.remove();
      esperando = false;
      input.disabled = false;
      input.focus();

      if (ia) {
        // El historial guarda la línea de opciones: así el asistente sabe qué ofreció.
        historial.push({ rol: "asistente", texto: ia.respuesta });
        const { texto, opciones } = separarOpciones(ia.respuesta);
        pintarRespuesta(texto);
        if (ia.cita) pintarCita(ia.cita);
        else pintarOpciones(opciones);
      } else {
        // La pregunta se queda sin turno de respuesta: se quita para que el
        // historial siga alternando si la IA vuelve en el siguiente mensaje.
        historial.pop();
        respuestaLocal(t);
      }
    };

    // ------------------------------------------------------------ Apertura
    // Botones de fuera que también abren el asistente (el de la barra del
    // celular). Al cerrar, el foco vuelve al botón con el que se abrió.
    const externos = [...document.querySelectorAll<HTMLButtonElement>("[data-abrir-chat]")];
    let origen: HTMLElement | null = null;
    externos.forEach((b) => {
      b.hidden = false;
      b.addEventListener("click", () => {
        origen = b;
        estado(panel.hidden);
      });
    });

    const estado = (abierto: boolean) => {
      raiz.toggleAttribute("data-abierto", abierto);
      abrir.setAttribute("aria-expanded", String(abierto));
      externos.forEach((b) => b.setAttribute("aria-expanded", String(abierto)));
      etiqueta.textContent = abierto ? "Cerrar el asistente" : "Abrir el asistente";
      panel.hidden = !abierto;
      if (abierto) medir("chat_open", { chat_method: origen ? "barra-movil" : "boton" });
      if (abierto) requestAnimationFrame(() => input.focus());
      else {
        (origen ?? abrir).focus();
        origen = null;
      }
    };

    abrir.addEventListener("click", () => estado(panel.hidden));
    cerrar.addEventListener("click", () => estado(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) estado(false);
    });

    input.addEventListener("input", () => {
      enviar.disabled = input.value.trim().length === 0;
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const texto = input.value;
      input.value = "";
      enviar.disabled = true;
      void preguntar(texto);
    });
    raiz.querySelectorAll<HTMLButtonElement>(".sugerencia").forEach((b) =>
      b.addEventListener("click", () => void preguntar(b.textContent ?? "", "sugerencia")),
    );
    raiz.querySelector(".chat-agendar")?.addEventListener("click", () => medir("chat_cta_click"));

    raiz.hidden = false;
  }
</script>

