---
/**
 * «Un cliente escribe de noche»: lo que hace un sistema montado, contado en
 * un video de 15 segundos.
 *
 * Hasta el 27/10/2026 la sección tenía, además del video, cuatro tarjetas con
 * maquetas (teléfono, agenda, automatización y embudo) que contaban lo mismo.
 * El titular pidió quitarlas para no repetir la información: la historia la
 * cuenta el video y, para quien no puede o no quiere verlo, el texto
 * desplegable de debajo (alternativa en texto de un video sin sonido).
 *
 * El video es ilustrativo y lo dice en pantalla: ni la conversación, ni la
 * agenda, ni las barras del embudo son datos de un cliente.
 */

// Lo mismo que se ve en el video, en texto.
const pasos = [
  {
    titulo: "El agente contesta y cierra la cita",
    texto:
      "Responde al instante por WhatsApp, con la información que tú apruebas. Ofrece un horario libre y deja la cita agendada, a cualquier hora.",
  },
  {
    titulo: "La cita aparece en tu agenda",
    texto: "Queda registrada al momento y se manda un recordatorio antes de la hora.",
  },
  {
    titulo: "El papeleo se hace solo",
    texto:
      "Se crea el contacto, se le pone una etiqueta, sale el correo de bienvenida y tu equipo recibe el aviso. Si algo falla, te enteras.",
  },
  {
    titulo: "Y queda todo medido",
    texto: "Se mide cada etapa, desde la visita hasta la venta, para ver qué paso falla y mejorarlo primero.",
  },
];
---

<section class="section showcase" aria-labelledby="showcase-titulo" data-acento="violeta">
  <div class="container-lf">
    <div class="showcase-cabecera">
      <div>
        <p class="eyebrow">Por dentro</p>
        <h2 id="showcase-titulo" class="subrayado mt-3">
          Un cliente escribe de noche. Mira qué pasa.
        </h2>
        <p class="lead mt-4">
          Son las 22:14 y entra un mensaje. Desde ese momento el sistema hace todo
          el trabajo, paso a paso, sin que tú ni nadie de tu equipo tenga que
          intervenir.
        </p>
      </div>
      <p class="aviso">Ejemplo ilustrativo, no capturas de clientes.</p>
    </div>

    {/*
      Video piloto (27/10/2026), hecho con código en video/ (Remotion).
      Dos versiones de la misma historia:
      - Escritorio y tableta: 16:9, 1440 × 810, 1,1 MB (piloto.mp4).
      - Celular (menos de 768 px): 9:16, 810 × 1440, 1,1 MB (piloto-vertical.mp4).
      El navegador elige la fuente por el atributo media; el script cambia la
      portada para que coincida con la versión.

      - preload="none": no se descarga nada hasta que llega a pantalla.
      - Arranca solo, sin sonido, cuando se ve al menos el 40 %, y se para al
        salir. Con movimiento reducido no arranca solo.
      - Botón de pausa siempre visible (WCAG 2.2.2: todo lo que se mueve más
        de 5 segundos se tiene que poder parar).
      - Sin JavaScript se ven los controles nativos del navegador.
    */}
    <figure class="video-piloto mt-10" data-video-piloto>
      <div class="video-marco">
        <video
          muted
          loop
          playsinline
          controls
          preload="none"
          poster="/video/piloto-portada.webp"
          width="1440"
          height="810"
          aria-label="Video de 15 segundos sin sonido: a las 22:14 entra un mensaje, el agente contesta, la cita entra en la agenda, el papeleo se hace solo y todo queda medido."
        >
          <source src="/video/piloto-vertical.mp4" type="video/mp4" media="(max-width: 767px)" />
          <source src="/video/piloto.mp4" type="video/mp4" />
          {/* El video no tiene sonido: la pista repite el texto de la pantalla. */}
          <track kind="captions" src="/video/piloto.vtt" srclang="es" label="Texto del video" />
        </video>
        <button class="video-control" type="button" data-control hidden>
          <span class="sr-only" data-etiqueta>Reproducir el video</span>
          <svg class="icono-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M7 5v14l12-7L7 5Z" /></svg
          >
          <svg class="icono-pausa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M8 5v14M16 5v14" /></svg
          >
        </button>
      </div>
      <figcaption class="video-pie">15 segundos, sin sonido</figcaption>
    </figure>

    <details class="video-texto mt-6">
      <summary>Lo que pasa en el video, en texto</summary>
      <ol>
        {
          pasos.map((p) => (
            <li>
              <b>{p.titulo}.</b> {p.texto}
            </li>
          ))
        }
      </ol>
    </details>
  </div>
</section>

<script>
  // Video piloto: se reproduce solo mientras está en pantalla, salvo que la
  // persona lo haya pausado o tenga activado el movimiento reducido.
  const figura = document.querySelector<HTMLElement>("[data-video-piloto]");
  const video = figura?.querySelector("video");
  const boton = figura?.querySelector<HTMLButtonElement>("[data-control]");
  const etiqueta = boton?.querySelector("[data-etiqueta]");

  if (figura && video && boton && etiqueta) {
    const reducir = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const celular = matchMedia("(max-width: 767px)");
    let pausadoAMano = false;
    let visible = false;

    // Con JavaScript, el botón propio sustituye a los controles nativos.
    video.controls = false;
    boton.hidden = false;

    // La portada tiene que coincidir con la versión del video: el atributo
    // media de <source> no cambia el poster.
    const elegirVersion = () => {
      video.poster = celular.matches ? "/video/piloto-vertical-portada.webp" : "/video/piloto-portada.webp";
    };
    elegirVersion();
    celular.addEventListener("change", () => {
      // Al girar el teléfono o cambiar el tamaño de la ventana, se vuelve a
      // elegir la fuente.
      const enMarcha = !video.paused;
      elegirVersion();
      video.load();
      if (enMarcha || (visible && !reducir && !pausadoAMano)) video.play().catch(() => {});
    });

    const pintar = () => {
      const enMarcha = !video.paused;
      boton.dataset.estado = enMarcha ? "reproduciendo" : "pausado";
      etiqueta.textContent = enMarcha ? "Pausar el video" : "Reproducir el video";
    };
    video.addEventListener("play", pintar);
    video.addEventListener("pause", pintar);
    pintar();

    boton.addEventListener("click", () => {
      if (video.paused) {
        pausadoAMano = false;
        video.play().catch(() => {});
      } else {
        pausadoAMano = true;
        video.pause();
      }
    });

    new IntersectionObserver(
      ([entrada]) => {
        visible = entrada.isIntersecting;
        if (visible) {
          if (!reducir && !pausadoAMano) video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.4 },
    ).observe(video);
  }
</script>

<style>
  .showcase-cabecera {
    display: grid;
    gap: 1rem;
  }
  .showcase-cabecera .lead {
    max-width: 60ch;
  }
  .aviso {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  @media (width >= 768px) {
    .showcase-cabecera {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .aviso {
      text-align: right;
      max-width: 14rem;
    }
  }

  /* ----------------------------------------------------------- Video */
  .video-piloto {
    margin-inline: 0;
  }
  .video-marco {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-navy);
    /* Profundidad con un reflejo violeta debajo. */
    box-shadow:
      0 2px 6px #0409164d,
      0 30px 60px -30px #020610cc,
      0 40px 80px -40px rgb(91 63 196 / 0.45);
  }
  /* En celular, la versión vertical: ocupa el ancho sin pasar de la altura
     de la pantalla. */
  @media (width < 768px) {
    .video-marco {
      aspect-ratio: 9 / 16;
      width: min(100%, calc(82svh * 9 / 16));
      margin-inline: auto;
    }
  }
  .video-marco video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 44 px: el tamaño mínimo de un objetivo táctil. */
  .video-control {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgb(7 9 13 / 0.72);
    color: var(--color-ink);
    cursor: pointer;
    transition: scale var(--dur-fast) var(--ease);
  }
  .video-control:active {
    scale: 0.94;
  }
  .video-control svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-linecap: round;
  }
  .video-control .icono-pausa {
    fill: none;
    stroke-width: 2.5;
  }
  .video-control[data-estado="reproduciendo"] .icono-play,
  .video-control:not([data-estado="reproduciendo"]) .icono-pausa {
    display: none;
  }
  .video-pie {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    text-align: center;
  }
  @media (width >= 768px) {
    .video-pie {
      text-align: right;
    }
  }

  /* ----------------------------------------------------------- Texto */
  .video-texto {
    max-width: 60ch;
    color: var(--color-soft);
    font-size: var(--step-0);
  }
  /* Se queda como list-item para conservar la flecha del desplegable. */
  .video-texto summary {
    padding-block: 0.625rem;
    color: var(--color-ink);
    font-weight: 600;
    cursor: pointer;
  }
  .video-texto ol {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }
  .video-texto b {
    color: var(--color-ink);
  }
</style>
