---
/**
 * Plantilla de las landings de anuncios: /diagnostico y los funnels de cada
 * servicio (/diagnostico/[servicio], ver FUNNELS.md).
 *
 * Desde el 29/10/2026 usan los colores, las fuentes y las piezas de la web
 * (navy, degradado azul → violeta, Manrope e Inter), a pedido del titular.
 * Antes tenían una identidad propia en lima. Cada funnel toma además el
 * color de su servicio como acento, igual que su página de servicio.
 *
 * - Un único objetivo: agendar la llamada. Sin el menú ni el pie de la web
 *   (Base con identidad «campana»): cabecera mínima, botón fijo en celular.
 * - Movimiento: el gráfico del hero (EscenaFunnel.astro) se reproduce una
 *   vez y queda quieto; la línea de los pasos se dibuja con el scroll. Todo
 *   respeta el movimiento reducido. Las cintas de fondo son las de la home.
 * - Indexación: «noindex, follow», fuera del sitemap y canónica hacia la
 *   página que ya posiciona (/contacto o la del servicio).
 *
 * Los textos salen de lo que ya dice la web: no hay cifras, casos ni
 * promesas nuevas.
 */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CintasLuz from "./CintasLuz.astro";
import Agenda from "./Agenda.astro";
import EscenaFunnel from "./EscenaFunnel.astro";
import Icono from "./Icono.astro";
import { SITIO } from "../data/servicios";
import { logos } from "../data/logos";
import type { Pregunta } from "../data/home";
import type { Bloque } from "../data/funnels";
import retratoImg from "../assets/luis-flores-sobre-mi-azul.jpg";

interface Props {
  title: string;
  description: string;
  schema: Record<string, unknown>[];
  /** Página que ya posiciona y a la que apunta la canónica. */
  canonicalDe: string;
  /** Identifica la agenda en la medición (generate_lead). */
  formId: string;
  /** Variable CSS del color del servicio, por ejemplo "--svc-agentes-ia". */
  acento?: string;
  /** Escena animada del hero: slug del servicio o «general». */
  escena: string;
  etiqueta: string;
  titulo: string;
  destacado: string;
  entrada: string;
  herramientas: string[];
  llevas: Bloque[];
  encaja: string[];
  todaviaNo: string[];
  preguntas: Pregunta[];
  /** Solo en los funnels de servicio. */
  dolores?: Bloque[];
  solucion?: { titulo: string; incluye: string[]; cambia: string[]; enlace: string };
}

const {
  title,
  description,
  schema,
  canonicalDe,
  formId,
  acento,
  escena,
  etiqueta,
  titulo,
  destacado,
  entrada,
  herramientas,
  llevas,
  encaja,
  todaviaNo,
  preguntas,
  dolores,
  solucion,
} = Astro.props;

const hayBannerCookies = /^GTM-[A-Z0-9]+$/.test(SITIO.gtm);
const anio = new Date().getFullYear();
// Color del servicio; sin él, el azul de marca.
const color = acento ? `var(${acento})` : "var(--acento-azul)";

const garantias = [
  { icono: "reloj", texto: "30 minutos por videollamada" },
  { icono: "escudo", texto: "Gratis y sin compromiso" },
  { icono: "globo", texto: "En tu horario, desde tu país" },
] as const;

const pasos = [
  { titulo: "Eliges día y hora", texto: "En la agenda de abajo ves los horarios libres en tu zona horaria. Te toma un minuto." },
  { titulo: "Hablamos 30 minutos", texto: "Por videollamada. Me cuentas cómo funciona tu negocio y dónde pierdes tiempo o clientes." },
  { titulo: "Decides con calma", texto: "Si tiene sentido trabajar juntos, te mando una propuesta por escrito con el precio cerrado." },
];
---

<Base
  title={title}
  description={description}
  schema={schema}
  identidad="campana"
  noindex
  canonicalDe={canonicalDe}
>
  <a class="lc-saltar" href="#lc-contenido">Saltar al contenido</a>

  {/* --------------------------------------------------------- Cabecera */}
  <header class="lc-cabecera" data-ubicacion="header">
    <div class="container-lf lc-cabecera-fila">
      <a class="lc-marca" href="/" aria-label="Luis Flores, ir a la web">
        <img src="/logo/monograma-80.webp" alt="" aria-hidden="true" width="40" height="43" class="lc-mono" />
        <img src="/logo/nombre-360.webp" alt="Luis Flores" width="360" height="32" class="lc-nombre" />
      </a>
      <a class="cta lc-cta-chico" href="#agenda" data-abrir-agenda>
        Agendar llamada <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <main id="lc-contenido" class="lc" style={`--ef-acento: ${color}; --svc: ${color}`}>
    <CintasLuz />

    {/* ------------------------------------------------------------ Hero */}
    <section class="lc-hero" aria-labelledby="lc-titulo" data-ubicacion="hero">
      <div class="container-lf lc-hero-rejilla">
        <div class="lc-hero-texto">
          <p class="lc-etiqueta">
            <span class="lc-punto" aria-hidden="true"></span>
            Diagnóstico gratis · {etiqueta}
          </p>
          <h1 id="lc-titulo" class="lc-h1">
            {titulo} <span class="gradient-text">{destacado}</span>
          </h1>
          <p class="lead lc-entrada">{entrada}</p>
          <div class="botones lc-botones">
            <a class="cta" href="#agenda" data-abrir-agenda>
              <Icono nombre="calendario" tamano={18} />
              Elegir día y hora <span aria-hidden="true">→</span>
            </a>
            <a class="boton-secundario" href={SITIO.whatsapp} rel="noopener">
              <Icono nombre="whatsapp" tamano={18} />
              Escríbeme por WhatsApp
            </a>
          </div>
          <ul class="lc-garantias" aria-label="Cómo es la llamada">
            {
              garantias.map((g) => (
                <li>
                  <Icono nombre={g.icono} tamano={16} grosor={1.8} />
                  {g.texto}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="lc-hero-visual">
          <EscenaFunnel tipo={escena} />
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------- Herramientas */}
    {
      herramientas.length > 0 && (
        <section class="lc-herramientas" aria-labelledby="lc-herramientas-titulo">
          <div class="container-lf lc-herramientas-fila">
            <p id="lc-herramientas-titulo" class="lc-herramientas-titulo">
              Trabajo con las herramientas que ya usas
            </p>
            <ul class="lc-logos">
              {herramientas.map((h) => (
                <li style={logos[h]?.color ? `--marca: ${logos[h].color}` : undefined}>
                  <span class="lc-logo" aria-hidden="true">
                    {logos[h]?.d ? (
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" focusable="false">
                        <path d={logos[h].d} />
                      </svg>
                    ) : (
                      <span class="lc-logo-inicial">{h[0]}</span>
                    )}
                  </span>
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* ------------------------------------------------------- Problemas */}
    {
      dolores && (
        <section class="section banda" aria-labelledby="lc-dolores" data-acento="coral">
          <div class="container-lf">
            <div class="cabecera-seccion">
              <div>
                <p class="eyebrow">¿Te suena?</p>
                <h2 id="lc-dolores" class="subrayado mt-4">Si te pasa algo de esto, esta llamada es para ti.</h2>
              </div>
              <p class="lead">Si te reconoces en alguna, en la llamada vemos cómo resolverla en tu caso.</p>
            </div>
            <ul class="lc-rejilla-3 mt-10">
              {dolores.map((d, n) => (
                <li class="card tarjeta lc-tarjeta">
                  <span class="num-indice" aria-hidden="true">0{n + 1}</span>
                  <h3 class="card-title mt-4">{d.titulo}</h3>
                  <p class="card-text mt-3">{d.texto}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* -------------------------------------------------------- Solución */}
    {
      solucion && (
        <section class="section lc-solucion" aria-labelledby="lc-solucion" style={`--acento: ${color}; --acento-texto: ${color}`}>
          <div class="container-lf">
            <div class="cabecera-seccion">
              <div>
                <p class="eyebrow">Lo que implemento</p>
                <h2 id="lc-solucion" class="subrayado mt-4">{solucion.titulo}</h2>
              </div>
              <a class="card-link" href={solucion.enlace}>
                Ver el servicio completo <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="lc-rejilla-2 mt-10">
              <div class="card tarjeta lc-tarjeta">
                <h3 class="card-title">Lo que dejo funcionando</h3>
                <ul class="lista-check mt-5">{solucion.incluye.map((e) => <li>{e}</li>)}</ul>
              </div>
              <div class="card tarjeta lc-tarjeta lc-tarjeta-acento">
                <h3 class="card-title">Lo que cambia en tu negocio</h3>
                <ul class="lista-check mt-5">{solucion.cambia.map((e) => <li>{e}</li>)}</ul>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------- Qué te llevas */}
    <section class={`section ${solucion ? "banda" : ""}`} aria-labelledby="lc-llevas" data-acento="violeta">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">En 30 minutos</p>
            <h2 id="lc-llevas" class="subrayado mt-4">Lo que te llevas de la llamada, trabajes conmigo o no.</h2>
          </div>
        </div>
        <ol class="lc-rejilla-3 mt-10">
          {
            llevas.map((l, n) => (
              <li class="card tarjeta lc-tarjeta">
                <span class="lc-numero" aria-hidden="true">0{n + 1}</span>
                <h3 class="card-title mt-5">{l.titulo}</h3>
                <p class="card-text mt-3">{l.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* -------------------------------------------------------- Cómo es */}
    <section class={`section ${solucion ? "" : "banda"}`} aria-labelledby="lc-como" data-acento="turquesa">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Cómo funciona</p>
            <h2 id="lc-como" class="subrayado mt-4">Eliges, hablamos y decides.</h2>
          </div>
        </div>
        <ol class="lc-pasos mt-10">
          {
            pasos.map((p, n) => (
              <li class="lc-paso">
                <span class="lc-paso-num" aria-hidden="true">{n + 1}</span>
                <h3 class="card-title mt-5">{p.titulo}</h3>
                <p class="card-text mt-3">{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---------------------------------------------------- Para quién es */}
    <section class="section banda" aria-labelledby="lc-encaje" data-acento="cian">
      <div class="container-lf">
        <div class="cabecera-seccion">
          <div>
            <p class="eyebrow">Antes de agendar</p>
            <h2 id="lc-encaje" class="subrayado mt-4">Para quién es esta llamada.</h2>
          </div>
        </div>
        <div class="lc-rejilla-2 mt-10">
          <div class="card tarjeta lc-tarjeta">
            <h3 class="card-title">Te va a servir si…</h3>
            <ul class="lista-check mt-5">{encaja.map((e) => <li>{e}</li>)}</ul>
          </div>
          <div class="card tarjeta lc-tarjeta">
            <h3 class="card-title">Tal vez todavía no, si…</h3>
            <ul class="lista-cruz mt-5">{todaviaNo.map((e) => <li>{e}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- Agenda */}
    <section class="section lc-agenda" id="agenda" aria-labelledby="lc-agenda" data-ubicacion="agenda">
      <div class="container-lf">
        <div class="lc-centrado">
          <p class="eyebrow lc-eyebrow-centro">Agenda</p>
          <h2 id="lc-agenda" class="subrayado lc-subrayado-centro mt-4">Elige el día y la hora que te queden bien.</h2>
          <p class="lead mt-5">
            Ves los horarios libres en tu zona horaria. Al confirmar te llega la
            invitación con el enlace de la videollamada.
          </p>
        </div>
        <div class="lc-agenda-caja mt-10">
          <Agenda formId={formId} />
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Quién */}
    <section class="section banda" aria-labelledby="lc-quien" data-acento="coral">
      <div class="container-lf">
        <div class="card lc-quien">
          <Image
            src={retratoImg}
            alt="Luis Carlos Flores"
            widths={[200, 400]}
            sizes="200px"
            loading="lazy"
            class="lc-quien-foto"
          />
          <div>
            <p class="eyebrow">Quién te atiende</p>
            <h2 id="lc-quien" class="lc-quien-titulo mt-4">La llamada la hago yo, en persona.</h2>
            <p class="card-text mt-4">
              Soy Luis Carlos Flores. Dirijo una agencia con base en Manresa, España,
              y diseño e implemento sistemas de IA, automatización y captación de
              clientes para negocios de Latinoamérica y España. Todo lo que propongo
              lo probé antes en mi propio negocio.
            </p>
            <a class="card-link mt-5 inline-block" href="/sobre-mi">
              Conoce mi historia <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------- Preguntas */}
    <section class="section" aria-labelledby="lc-faq">
      <div class="container-lf lc-faq">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2 id="lc-faq" class="subrayado mt-4">Lo que suelen preguntarme antes de agendar.</h2>
        </div>
        <div>
          {
            preguntas.map((p) => (
              <details class="card faq-item mt-3">
                <summary>{p.pregunta}</summary>
                <div class="faq-cuerpo">
                  <p class="card-text">{p.respuesta}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- Cierre */}
    <section class="section lc-cierre-seccion" aria-labelledby="lc-final" data-ubicacion="cierre">
      <div class="container-lf">
        <div class="lc-cierre">
          <h2 id="lc-final" class="lc-cierre-titulo">¿Hablamos 30 minutos de tu negocio?</h2>
          <p class="lc-cierre-texto">
            Es gratis, por videollamada y sin compromiso. Si no tiene sentido
            trabajar juntos, te lo digo.
          </p>
          <div class="botones botones-centro mt-8">
            <a class="lc-boton-blanco" href="#agenda" data-abrir-agenda>
              Elegir día y hora <span aria-hidden="true">→</span>
            </a>
            <a class="lc-boton-borde" href={SITIO.whatsapp} rel="noopener">
              <Icono nombre="whatsapp" tamano={18} />
              Escríbeme por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  {/* ------------------------------------------------------------- Pie */}
  <footer class="lc-pie" data-ubicacion="footer">
    <div class="container-lf lc-pie-fila">
      <p>© {anio} {SITIO.nombreCompleto} · {SITIO.localidad}, {SITIO.region}, España</p>
      <nav class="lc-pie-enlaces" aria-label="Web y legal">
        <a href="/">Ver la web</a>
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/politica-de-privacidad">Privacidad</a>
        <a href="/aviso-de-privacidad-latinoamerica">Privacidad Latinoamérica</a>
        <a href="/politica-de-cookies">Cookies</a>
        {
          hayBannerCookies && (
            <button type="button" class="lc-pie-boton" data-cookie-settings>
              Configurar cookies
            </button>
          )
        }
      </nav>
    </div>
  </footer>

  {/* Botón fijo en celular: aparece al pasar los botones del hero y se
      esconde al llegar a la agenda, para no repetirlos ni tapar el calendario. */}
  <div class="lc-barra" data-ubicacion="barra-movil" data-lc-barra>
    <a class="cta" href="#agenda" data-abrir-agenda>
      <Icono nombre="calendario" tamano={18} />
      Elegir día y hora <span aria-hidden="true">→</span>
    </a>
  </div>
</Base>

<script>
  const barra = document.querySelector<HTMLElement>("[data-lc-barra]");
  const botones = document.querySelector(".lc-botones");
  const agenda = document.querySelector("#agenda");
  if (barra && botones && agenda && "IntersectionObserver" in window) {
    const vistos = new Map<Element, boolean>([
      [botones, true],
      [agenda, false],
    ]);
    const pintar = () => barra.toggleAttribute("data-oculta", vistos.get(botones) || vistos.get(agenda));
    pintar();
    new IntersectionObserver((entradas) => {
      for (const e of entradas) vistos.set(e.target, e.isIntersecting);
      pintar();
    }).observe(botones);
    new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) vistos.set(e.target, e.isIntersecting);
        pintar();
      },
      { rootMargin: "0px 0px -30% 0px" },
    ).observe(agenda);
  }
</script>

<style>
  .lc-saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 0 0 8px 0;
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .lc-saltar:focus {
    left: 0;
  }

  /* ---------------------------------------------------------- Cabecera */
  .lc-cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-navy-glass-blur);
    backdrop-filter: blur(14px);
  }
  .lc-cabecera-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .lc-marca {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .lc-mono {
    width: 2rem;
    height: auto;
  }
  .lc-nombre {
    width: auto;
    height: 1.125rem;
  }
  .lc-cta-chico {
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 0.9375rem;
  }
  @media (width < 420px) {
    .lc-nombre {
      display: none;
    }
  }

  /* -------------------------------------------------------------- Hero */
  .lc {
    position: relative;
    isolation: isolate;
    /* Los brillos difusos (escena, agenda) salen por los lados: sin el
       recorte, en el celular la página se ensanchaba unos píxeles. */
    overflow-x: clip;
  }
  .lc-hero {
    position: relative;
    padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .lc-hero-rejilla {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (width >= 1024px) {
    .lc-hero-rejilla {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }
  .lc-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--svc) 40%, var(--color-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--svc) 10%, rgb(16 21 34 / 0.7));
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .lc-punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--svc);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--svc) 25%, transparent);
  }
  .lc-h1 {
    margin-top: 1.5rem;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 800;
    line-height: var(--leading-titular);
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .lc-entrada {
    margin-top: 1.5rem;
    max-width: 56ch;
  }
  .lc-botones {
    margin-top: 2rem;
  }
  .lc-garantias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-soft);
    font-size: var(--step--1);
  }
  .lc-garantias li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lc-garantias :global(svg) {
    color: var(--svc);
  }

  /* ------------------------------------------------------ Herramientas */
  .lc-herramientas {
    border-block: 1px solid var(--color-divider);
    background: rgb(10 14 26 / 0.7);
  }
  .lc-herramientas-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
  }
  .lc-herramientas-titulo {
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .lc-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lc-logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.875rem 0.4rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .lc-logo {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca, var(--color-electric)) 16%, transparent);
    color: var(--marca, var(--color-electric-soft));
