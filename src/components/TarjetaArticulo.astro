---
/**
 * Tarjeta de un artículo del blog: portada, etiqueta del servicio, fecha,
 * minutos de lectura, título, entradilla y «Leer el artículo».
 *
 * Portada: la imagen propia del artículo si la tiene; si no, la ilustración
 * o la foto del servicio con el que enlaza. Así cada tema tiene su color y
 * su imagen sin usar fotos que no correspondan.
 *
 * Toda la tarjeta es pulsable con un único enlace (el del título).
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import IlustracionServicio from "./IlustracionServicio.astro";
import { servicios } from "../data/servicios";
import { ilustraciones } from "../data/ilustraciones";
import { minutosLectura } from "../data/lectura";

interface Props {
  post: CollectionEntry<"blog">;
  destacado?: boolean;
  nivel?: "h2" | "h3";
}

const { post, destacado = false, nivel = "h2" } = Astro.props;
const Titulo = nivel;

const servicio = servicios.find((s) => s.slug === post.data.servicio);
const color = servicio?.color ?? "--color-electric";
const minutos = minutosLectura(post.body);

const imagenes = import.meta.glob<{ default: ImageMetadata }>("../assets/*.{jpg,webp}", { eager: true });
function imagenDe(nombre: string | undefined) {
  if (!nombre) return undefined;
  const clave = Object.keys(imagenes).find((k) => k.endsWith(`/${nombre}.jpg`) || k.endsWith(`/${nombre}.webp`));
  return clave ? imagenes[clave].default : undefined;
}

const fotoPropia = post.data.image;
const ilus = servicio && ilustraciones[servicio.slug] ? servicio.slug : undefined;
const fotoServicio = !fotoPropia && !ilus ? imagenDe(servicio?.imagen) : undefined;

const fecha = post.data.datePublished.toLocaleDateString("es", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article
  class={`card tarjeta-articulo tarjeta-blog${destacado ? " destacado" : ""}`}
  style={`--svc: var(${color})`}
>
  <div class="portada media duotono" aria-hidden="true">
    {
      fotoPropia ? (
        <Image
          src={fotoPropia}
          alt=""
          widths={destacado ? [640, 960, 1280] : [480, 720]}
          sizes={destacado ? "(min-width: 1024px) 55vw, 100vw" : "(min-width: 1024px) 30vw, 100vw"}
          loading="lazy"
        />
      ) : ilus ? (
        <IlustracionServicio slug={ilus} color={color} alt="" variante="portada" decorativa />
      ) : (
        fotoServicio && (
          <Image
            src={fotoServicio}
            alt=""
            widths={destacado ? [640, 960] : [480, 720]}
            sizes={destacado ? "(min-width: 1024px) 55vw, 100vw" : "(min-width: 1024px) 30vw, 100vw"}
            loading="lazy"
          />
        )
      )
    }
  </div>

  <div class="cuerpo">
    <p class="datos-articulo">
      {servicio && <span class="etiqueta-servicio">{servicio.nombre}</span>}
      <span class="fecha">
        <time datetime={post.data.datePublished.toISOString().slice(0, 10)}>{fecha}</time>
        {" · "}
        {minutos} min de lectura
      </span>
    </p>
    <Titulo class="titulo">
      <a href={`/blog/${post.id}`} class="enlace-tarjeta">{post.data.title}</a>
    </Titulo>
    <p class="card-text entradilla">{post.data.description}</p>
    <span class="card-link" aria-hidden="true">
      Leer el artículo <span aria-hidden="true">→</span>
    </span>
  </div>
</article>

<style>
  .tarjeta-blog {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .portada {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-line);
  }
  .portada :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portada :global(.ilustracion) {
    height: 100%;
  }
  .cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
  }
  .datos-articulo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }
  .fecha {
    width: 100%;
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .titulo {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .entradilla {
    margin-top: 0.75rem;
  }
  .card-link {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  /* Destacado: horizontal en escritorio, con el título más grande. */
  .destacado .titulo {
    font-size: var(--step-3);
    line-height: 1.15;
  }
  @media (width >= 1024px) {
    .destacado {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .destacado .portada {
      aspect-ratio: auto;
      min-height: 22rem;
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }
    .destacado .cuerpo {
      justify-content: center;
      padding: 2.75rem;
    }
  }
</style>
