const { nombre, tamano = 24, grosor = 1.75, degradado = false, class: clase } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={tamano}
  height={tamano}
  fill="none"
  stroke={degradado ? "url(#lf-grad-stroke)" : "currentColor"}
  stroke-width={grosor}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={clase}
  set:html={trazos[nombre]}
/>
