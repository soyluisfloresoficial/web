---
/**
 * Agenda de Calendly dentro de la página. Se usa en /contacto y en
 * /diagnostico.
 *
 * El iframe se crea cuando la persona lo pide (este botón o cualquier enlace
 * con data-abrir-agenda), así no se carga contenido de terceros antes de
 * tiempo. Calendly avisa por postMessage al elegir hora y al confirmar la
 * reserva: ahí salen form_start y generate_lead con el form_id indicado.
 *
 * variante «lima»: colores de la identidad de /diagnostico (Calendly solo los
 * aplica en sus planes de pago; si no, muestra los suyos).
 */
import Icono from "./Icono.astro";
import { SITIO } from "../data/servicios";

interface Props {
  formId: string;
  variante?: "marca" | "lima";
}

const { formId, variante = "marca" } = Astro.props;
const colores =
  variante === "lima" ? { fondo: "0d0d0d", texto: "f2f2f0", principal: "c6ff3d" } : null;
---

<div
  class={`card agenda agenda-${variante}`}
  data-agenda
  data-url={SITIO.calendly}
  data-form-id={formId}
  data-colores={colores ? JSON.stringify(colores) : undefined}
>
  <div class="agenda-aviso" data-agenda-aviso>
    {
      variante === "lima" ? (
        <span class="agenda-icono" aria-hidden="true">
          <Icono nombre="calendario" tamano={22} grosor={1.6} />
        </span>
      ) : (
        <span class="anillo-degradado anillo-grande" aria-hidden="true">
          <Icono nombre="calendario" tamano={24} grosor={1.6} degradado />
        </span>
      )
    }
    <p class="agenda-texto">
      La agenda la gestiona Calendly. Al abrirla se carga su servicio, que trata
      tus datos según la <a href="/politica-de-privacidad">política de privacidad</a>.
    </p>
    <button type="button" class="cta agenda-boton" data-agenda-cargar>
      Ver horarios disponibles <span aria-hidden="true">→</span>
    </button>
    <a class="agenda-externa" href={SITIO.calendly} rel="noopener" target="_blank">
      O ábrela en una pestaña nueva
    </a>
  </div>
  <p class="agenda-exito" data-agenda-exito role="status" hidden>
    Listo, tu llamada quedó agendada. Revisa tu correo: ahí tienes la
    confirmación y el enlace de la videollamada.
  </p>
</div>

<script>
  const caja = document.querySelector<HTMLElement>("[data-agenda]");
  const aviso = caja?.querySelector<HTMLElement>("[data-agenda-aviso]");
  const exito = caja?.querySelector<HTMLElement>("[data-agenda-exito]");
  const formId = caja?.dataset.formId ?? "calendly";
  let cargada = false;

  const cargar = () => {
    if (!caja || !aviso || cargada) return;
    cargada = true;
    const url = new URL(caja.dataset.url ?? "");
    url.searchParams.set("embed_domain", location.hostname);
    url.searchParams.set("embed_type", "Inline");
    url.searchParams.set("hide_gdpr_banner", "1");
    url.searchParams.set("locale", "es");
    if (caja.dataset.colores) {
      const c = JSON.parse(caja.dataset.colores) as { fondo: string; texto: string; principal: string };
      url.searchParams.set("background_color", c.fondo);
      url.searchParams.set("text_color", c.texto);
      url.searchParams.set("primary_color", c.principal);
    }
    const marco = document.createElement("iframe");
    marco.src = url.toString();
    marco.title = "Agenda de Calendly para la llamada de diagnóstico";
    marco.className = "agenda-marco";
    marco.loading = "lazy";
    aviso.replaceWith(marco);
  };

  caja?.querySelector("[data-agenda-cargar]")?.addEventListener("click", cargar);
  document.querySelectorAll("[data-abrir-agenda]").forEach((a) => a.addEventListener("click", cargar));
  if (location.hash === "#agenda") cargar();

  // Eventos de Calendly (solo los que vienen de calendly.com).
  const w = window as unknown as { dataLayer?: unknown[] };
  let empezado = false;
  window.addEventListener("message", (e) => {
    if (e.origin !== "https://calendly.com") return;
    const tipo = (e.data as { event?: string } | null)?.event;
    if (tipo === "calendly.date_and_time_selected" && !empezado) {
      empezado = true;
      w.dataLayer?.push({ event: "form_start", form_id: formId, page_path: location.pathname });
    }
    if (tipo === "calendly.event_scheduled") {
      w.dataLayer?.push({ event: "generate_lead", form_id: formId, method: "calendly", page_path: location.pathname });
      if (exito) exito.hidden = false;
    }
  });
</script>

<style>
  .agenda {
    overflow: hidden;
    padding: 0;
  }
  .agenda-aviso {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) 1.5rem;
    text-align: center;
  }
  .agenda-texto {
    max-width: 46ch;
    color: var(--color-soft);
  }
  .agenda-texto a,
  .agenda-externa {
    color: var(--color-electric-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .agenda-externa {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--step--1);
  }
  .agenda :global(.agenda-marco) {
    display: block;
    width: 100%;
    height: 720px;
    border: 0;
    background: #fff;
  }
  .agenda-exito {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ---------------------------------------------------- Variante lima */
  .agenda-lima {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .agenda-lima .agenda-texto {
    color: var(--muted);
  }
  .agenda-lima .agenda-texto a,
  .agenda-lima .agenda-externa {
    color: var(--text);
    text-decoration-color: var(--line-strong);
  }
  .agenda-lima .agenda-externa {
    font-size: 0.875rem;
  }
  .agenda-lima :global(.agenda-marco) {
    background: var(--surface);
  }
  .agenda-lima .agenda-exito {
    border-top-color: var(--line);
    color: var(--lime);
  }
  .agenda-icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
  }
</style>
