---
/**
 * Agenda propia de la llamada de diagnóstico (28/10/2026). Ver AGENDA.md.
 * Se usa en /contacto y en /diagnostico.
 *
 * Rediseñada el 04/11/2026: tres pasos con indicador (día y hora, tus datos,
 * listo), aviso claro de la zona horaria con la hora de Madrid junto a cada
 * hora, más datos útiles para preparar la llamada (teléfono, web, sector,
 * equipo, servicio) y el aviso de privacidad a la vista, con casilla de
 * aceptación, en lugar de un simple enlace.
 *
 * Pide las horas libres a /api/agenda (que las saca de Google Calendar) y
 * reserva ahí mismo, sin salir de la web ni cargar servicios de terceros.
 *
 * Si el servidor responde que Google no está conectado, o falla, se ofrece
 * agendar por WhatsApp o por correo. Sin JavaScript, igual. La web nunca se
 * queda sin forma de pedir la llamada. Calendly se quitó el 29/10/2026.
 *
 * Medición: form_start al elegir hora y generate_lead al confirmar, con el
 * form_id de cada página y method "agenda-propia".
 */
import Icono from "./Icono.astro";
import { SITIO } from "../data/servicios";
import { AGENDA } from "../data/agenda";

interface Props {
  formId: string;
}

const { formId } = Astro.props;

/** Debe coincidir con SERVICIOS de src/worker/agenda.ts: lo demás se descarta allí. */
const SERVICIOS = [
  "Agentes de IA",
  "Funnels y conversión",
  "Automatización de procesos",
  "CRM y seguimiento de leads",
  "Email marketing",
  "Paneles de métricas",
  "Webs con IA",
  "Tráfico de pago",
  "Consultoría de IA",
  "Aún no lo sé",
];
const EQUIPOS = ["Solo yo", "2 a 5 personas", "6 a 20 personas", "Más de 20 personas"];
---

<div
  class="agenda-propia"
  data-agenda-propia
  data-estado="comprobando"
  data-form-id={formId}
  data-duracion={AGENDA.duracion}
  data-zona-agenda={AGENDA.zona}
>
  <div class="ap-cargando card" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="card ap-caja" data-ap-caja>
    <ol class="ap-pasos" aria-label="Pasos para agendar la llamada">
      <li class="ap-paso-item" data-ap-paso-item="1" aria-current="step"><span aria-hidden="true">1</span>Día y hora</li>
      <li class="ap-paso-item" data-ap-paso-item="2"><span aria-hidden="true">2</span>Tus datos</li>
      <li class="ap-paso-item" data-ap-paso-item="3"><span aria-hidden="true">3</span>Listo</li>
    </ol>

    <div class="ap-eleccion" data-ap-eleccion>
      <p class="ap-intro">
        Videollamada de <strong><span data-ap-duracion>{AGENDA.duracion}</span> minutos</strong> por Google Meet para revisar tu
        caso. Elige el día y la hora que mejor te queden.
      </p>

      <div class="ap-zona-caja">
        <p class="ap-zona-titulo">
          <Icono nombre="reloj" tamano={18} grosor={1.8} />
          <span>Las horas que ves están en: <strong data-ap-zona-nombre></strong></span>
        </p>
        <p class="ap-zona-nota" data-ap-zona-nota></p>
        <label class="ap-zona">
          <span>¿Estás en otro lugar? Cambia tu zona horaria</span>
          <select data-ap-zona></select>
        </label>
      </div>

      <div class="ap-columnas">
        <div class="ap-columna">
          <p class="ap-paso">Elige el día</p>
          <div class="ap-dias" data-ap-dias role="group" aria-label="Días con horas libres"></div>
        </div>
        <div class="ap-columna">
          <p class="ap-paso">Elige la hora</p>
          <p class="ap-dia-elegido" data-ap-dia-elegido></p>
          <div class="ap-horas" data-ap-horas role="group" aria-label="Horas libres"></div>
          <p class="ap-vacio" data-ap-sin-horas hidden>
            No quedan horas libres en los próximos días. Escríbeme por
            <a href={SITIO.whatsapp} rel="noopener">WhatsApp</a> y buscamos un hueco.
          </p>
        </div>
      </div>
    </div>

    <form class="ap-form" data-ap-form hidden novalidate>
      <div class="ap-form-cabecera">
        <p class="ap-paso">Tu llamada y tus datos</p>
        <p class="ap-resumen">
          <Icono nombre="calendarioOk" tamano={18} grosor={1.8} />
          <span class="ap-resumen-textos">
            <span data-ap-resumen></span>
            <span class="ap-resumen-madrid" data-ap-resumen-madrid></span>
          </span>
          <button type="button" class="ap-cambiar" data-ap-cambiar>Cambiar día u hora</button>
        </p>
        <p class="ap-nota">Solo el nombre y el correo son obligatorios. Lo demás me ayuda a llegar preparado a la llamada.</p>
      </div>

      <fieldset class="ap-grupo">
        <legend>Sobre ti</legend>
        <div class="ap-campos">
          <label class="ap-campo">
            <span>Nombre</span>
            <input name="nombre" autocomplete="name" required minlength="2" maxlength="80" placeholder="Tu nombre y apellido" />
          </label>
          <label class="ap-campo">
            <span>Correo</span>
            <input name="correo" type="email" autocomplete="email" inputmode="email" required maxlength="120" placeholder="tucorreo@ejemplo.com" />
            <small>Ahí te llega la invitación con el enlace de la videollamada.</small>
          </label>
          <label class="ap-campo">
            <span>WhatsApp o teléfono <em>(opcional)</em></span>
            <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="+52 55 1234 5678" />
            <small>Solo para avisarte si surge algo antes de la llamada.</small>
          </label>
        </div>
      </fieldset>

      <fieldset class="ap-grupo">
        <legend>Sobre tu negocio</legend>
        <div class="ap-campos ap-campos-dos">
          <label class="ap-campo">
            <span>Nombre del negocio <em>(opcional)</em></span>
            <input name="empresa" autocomplete="organization" maxlength="120" />
          </label>
          <label class="ap-campo">
            <span>Tu página web <em>(opcional)</em></span>
            <input name="sitioWeb" type="text" inputmode="url" autocomplete="url" maxlength="200" placeholder="tuweb.com" />
            <small>Si ya tienes web, la reviso antes de la llamada.</small>
          </label>
          <label class="ap-campo">
            <span>¿A qué se dedica? <em>(opcional)</em></span>
            <input name="sector" maxlength="80" placeholder="Por ejemplo: clínica dental, tienda en línea" />
          </label>
          <label class="ap-campo">
            <span>¿Cuántas personas son en el equipo? <em>(opcional)</em></span>
            <select name="equipo">
              <option value="">Prefiero no decirlo</option>
              {EQUIPOS.map((e) => <option value={e}>{e}</option>)}
            </select>
          </label>
        </div>
      </fieldset>

      <fieldset class="ap-grupo">
        <legend>Qué necesitas</legend>
        <div class="ap-campos ap-campos-uno">
          <label class="ap-campo">
            <span>¿Qué te interesa más? <em>(opcional)</em></span>
            <select name="servicio">
              <option value="">Elige una opción</option>
              {SERVICIOS.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label class="ap-campo">
            <span>Cuéntame qué quieres resolver <em>(opcional)</em></span>
            <textarea name="mensaje" rows="4" maxlength="1000" placeholder="Por ejemplo: recibo muchas consultas por WhatsApp y no alcanzo a responder a todos."></textarea>
          </label>
        </div>
      </fieldset>

      {/* Campo trampa contra programas automáticos: las personas no lo ven. */}
      <div class="ap-trampa" aria-hidden="true">
        <label>Web <input name="web" tabindex="-1" autocomplete="off" /></label>
      </div>

      <aside class="ap-privacidad" aria-labelledby="ap-priv-titulo">
        <p class="ap-priv-titulo" id="ap-priv-titulo">
          <Icono nombre="escudo" tamano={20} grosor={1.8} />
          Tus datos están protegidos
        </p>
        <ul>
          <li><strong>Para qué:</strong> solo para agendar la llamada, enviarte la invitación y preparar la conversación.</li>
          <li>
            <strong>Quién los ve:</strong> yo y los servicios que uso para agendar y escribirte (Google y Resend). No se
            publican, no se venden y no se ceden a nadie más, salvo que la ley lo exija.
          </li>
          <li>
            <strong>Cuánto tiempo:</strong> hasta un año después de la llamada si no trabajamos juntos. Si cancelas la cita,
            se borra del calendario.
          </li>
          <li>
            <strong>Tus derechos:</strong> puedes pedir ver, corregir o borrar tus datos escribiendo a{" "}
            <a href="mailto:hola@soyluisflores.es">hola@soyluisflores.es</a>.
          </li>
        </ul>
      </aside>

      <label class="ap-consent">
        <input type="checkbox" name="acepto" required />
        <span>
          Acepto que se traten mis datos para agendar la llamada, como se explica arriba. Más detalle en la{" "}
          <a href="/politica-de-privacidad" target="_blank" rel="noopener">política de privacidad</a>{" "}
          (y, si estás en Latinoamérica, en el{" "}
          <a href="/aviso-de-privacidad-latinoamerica" target="_blank" rel="noopener">aviso de privacidad para Latinoamérica</a>).
        </span>
      </label>

      <div class="ap-siguiente">
        <p class="ap-siguiente-titulo">Qué pasa después de confirmar</p>
        <ol>
          <li>Te llega al correo la invitación de Google Calendar con el enlace de la videollamada.</li>
          <li>Te envío un recordatorio un día antes y otro una hora antes.</li>
          <li>Si no puedes, cancelas desde el enlace que trae cada correo.</li>
        </ol>
      </div>

      <p class="ap-error" data-ap-error role="alert" hidden></p>
      <button class="cta ap-enviar" type="submit" data-ap-enviar>
        <Icono nombre="check" tamano={18} grosor={2.2} />
        <span data-ap-enviar-texto>Confirmar la llamada</span>
      </button>
    </form>

    <div class="ap-exito" data-ap-exito hidden tabindex="-1">
      <span class="ap-exito-icono" aria-hidden="true">
        <Icono nombre="check" tamano={26} grosor={2.4} />
      </span>
      <h3 class="ap-exito-titulo">Listo, tu llamada quedó agendada</h3>
      <p class="ap-exito-cuando" data-ap-exito-cuando></p>
      <p class="ap-exito-madrid" data-ap-exito-madrid></p>
      <p class="ap-exito-texto" data-ap-exito-texto></p>
      <ol class="ap-exito-pasos">
        <li>Abre el correo de Google Calendar y toca «Sí» para guardar la cita en tu calendario.</li>
        <li>El día de la llamada entra con el enlace de Google Meet que viene en la invitación.</li>
        <li>Si no puedes, usa el enlace para cancelar que trae el correo de confirmación.</li>
      </ol>
    </div>
  </div>

  {/* Respaldo: Google sin conectar, sin JavaScript o el servidor falla. */}
  <div class="card agenda-respaldo" data-agenda-respaldo>
    <span class="anillo-degradado anillo-grande" aria-hidden="true">
      <Icono nombre="calendario" tamano={24} grosor={1.6} degradado />
    </span>
    <p class="respaldo-titulo">Agenda tu llamada por WhatsApp o por correo</p>
    <p class="respaldo-texto">
      La agenda en línea no está disponible en este momento. Escríbeme y te
      propongo horarios en tu zona horaria.
    </p>
    <div class="botones botones-centro respaldo-botones">
      <a class="cta" href={SITIO.whatsapp} rel="noopener">
        <Icono nombre="whatsapp" tamano={18} />
        Escribir por WhatsApp
      </a>
      <a class="boton-secundario" href={SITIO.correoEnlace}>
        <Icono nombre="email" tamano={18} />
        Escribir un correo
      </a>
    </div>
  </div>
</div>

<script>
  type Hueco = { iso: string; ms: number };

  const raiz = document.querySelector<HTMLElement>("[data-agenda-propia]");
  const $ = <T extends HTMLElement>(sel: string) => raiz?.querySelector<T>(sel) ?? null;
  const dias = $("[data-ap-dias]");
  const horas = $("[data-ap-horas]");
  const zonaSelect = $<HTMLSelectElement>("[data-ap-zona]");
  const zonaNombre = $("[data-ap-zona-nombre]");
  const zonaNota = $("[data-ap-zona-nota]");
  const diaElegido = $("[data-ap-dia-elegido]");
  const sinHoras = $("[data-ap-sin-horas]");
  const eleccion = $("[data-ap-eleccion]");
  const form = $<HTMLFormElement>("[data-ap-form]");
  const resumen = $("[data-ap-resumen]");
  const resumenMadrid = $("[data-ap-resumen-madrid]");
  const error = $("[data-ap-error]");
  const enviar = $<HTMLButtonElement>("[data-ap-enviar]");
  const enviarTexto = $("[data-ap-enviar-texto]");
  const exito = $("[data-ap-exito]");
  const formId = raiz?.dataset.formId ?? "agenda";
  // Zona en la que está escrito el horario (Madrid). Todo se convierte desde ella.
  const zonaMadrid = raiz?.dataset.zonaAgenda ?? "Europe/Madrid";
  // La duración real llega con las horas libres (el panel puede cambiarla).
  let duracion = Number(raiz?.dataset.duracion ?? 30);
  const w = window as unknown as { dataLayer?: unknown[] };

  // Zonas más habituales de quien reserva. La del navegador va primero.
  const ZONAS: [string, string][] = [
    ["Europe/Madrid", "España (península)"],
    ["Atlantic/Canary", "Canarias"],
    ["America/Mexico_City", "México (centro)"],
    ["America/Bogota", "Colombia"],
    ["America/Lima", "Perú"],
    ["America/Guayaquil", "Ecuador"],
    ["America/Caracas", "Venezuela"],
    ["America/Santiago", "Chile"],
    ["America/Argentina/Buenos_Aires", "Argentina"],
    ["America/Montevideo", "Uruguay"],
    ["America/Asuncion", "Paraguay"],
    ["America/La_Paz", "Bolivia"],
    ["America/Panama", "Panamá"],
    ["America/Costa_Rica", "Costa Rica"],
    ["America/Guatemala", "Guatemala"],
    ["America/El_Salvador", "El Salvador"],
    ["America/Tegucigalpa", "Honduras"],
    ["America/Managua", "Nicaragua"],
    ["America/Santo_Domingo", "República Dominicana"],
    ["America/Puerto_Rico", "Puerto Rico"],
    ["America/New_York", "Estados Unidos (este)"],
    ["America/Chicago", "Estados Unidos (centro)"],
    ["America/Denver", "Estados Unidos (montaña)"],
    ["America/Los_Angeles", "Estados Unidos (pacífico)"],
  ];

  let zona = zonaMadrid;
  try {
    zona = Intl.DateTimeFormat().resolvedOptions().timeZone || zona;
  } catch {
    /* navegador sin zona: se queda Madrid */
  }

  let huecos: Hueco[] = [];
  let diaActual = "";
  let elegido: Hueco | null = null;
  let empezado = false;

  const fmtEn = (z: string, opciones: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("es", { timeZone: z, ...opciones });
  const fmt = (opciones: Intl.DateTimeFormatOptions) => fmtEn(zona, opciones);
  const claveDiaEn = (z: string, ms: number) => new Intl.DateTimeFormat("en-CA", { timeZone: z }).format(ms);
  const claveDia = (ms: number) => claveDiaEn(zona, ms);
  const horaEn = (z: string, ms: number) => fmtEn(z, { hour: "2-digit", minute: "2-digit" }).format(ms);
  const hora = (ms: number) => horaEn(zona, ms);
  const mayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const diaLargo = (ms: number) => mayuscula(fmt({ weekday: "long", day: "numeric", month: "long" }).format(ms));

  /** True si en tu zona la hora o el día no son los de Madrid. */
  const difiereDeMadrid = (ms: number) => horaEn(zonaMadrid, ms) !== hora(ms) || claveDiaEn(zonaMadrid, ms) !== claveDia(ms);

  /** «15:30», o «mar 00:30» si en Madrid ya es otro día que en tu zona. */
  function horaMadrid(ms: number): string {
    const mismoDia = claveDiaEn(zonaMadrid, ms) === claveDia(ms);
    const dia = mismoDia ? "" : `${fmtEn(zonaMadrid, { weekday: "short" }).format(ms).replace(".", "")} `;
    return `${dia}${horaEn(zonaMadrid, ms)}`;
  }

  function nombreZona(z: string): string {
    return ZONAS.find(([id]) => id === z)?.[1] ?? z.split("/").pop()!.replace(/_/g, " ");
  }

  /** «GMT-6», para que se entienda de qué hora se habla. */
  function desfaseZona(z: string): string {
    try {
      const partes = new Intl.DateTimeFormat("es", { timeZone: z, timeZoneName: "shortOffset" }).formatToParts(Date.now());
      return partes.find((p) => p.type === "timeZoneName")?.value ?? "";
    } catch {
      return "";
    }
  }

  function pintarZonas() {
    if (!zonaSelect) return;
    const lista = ZONAS.some(([id]) => id === zona) ? ZONAS : [[zona, nombreZona(zona)] as [string, string], ...ZONAS];
    const ahora = Date.now();
    zonaSelect.replaceChildren(
      ...lista.map(([id, nombre]) => {
        const o = document.createElement("option");
        o.value = id;
        let reloj = "";
        try {
          reloj = new Intl.DateTimeFormat("es", { timeZone: id, hour: "2-digit", minute: "2-digit" }).format(ahora);
        } catch {
          /* zona desconocida para este navegador */
        }
        o.textContent = reloj ? `${nombre} · ahora ${reloj}` : nombre;
        o.selected = id === zona;
        return o;
      }),
    );
  }

  function pintarAvisoZona() {
    const desfase = desfaseZona(zona);
    if (zonaNombre) zonaNombre.textContent = desfase ? `${nombreZona(zona)} · ${desfase}` : nombreZona(zona);
    if (!zonaNota) return;
    const hayDistintas = huecos.some((h) => difiereDeMadrid(h.ms));
    zonaNota.textContent = hayDistintas
      ? "Atiendo en horario de Madrid, España. Cada hora ya está convertida a la tuya y debajo ves la de Madrid."
      : "Tu hora es la misma que la de Madrid, España, donde atiendo.";
  }

  function pasoActual(n: 1 | 2 | 3) {
    raiz?.querySelectorAll<HTMLElement>("[data-ap-paso-item]").forEach((li) => {
      const mio = Number(li.dataset.apPasoItem);
      if (mio === n) li.setAttribute("aria-current", "step");
      else li.removeAttribute("aria-current");
      li.classList.toggle("ap-hecho", mio < n);
    });
  }

  function porDia(): Map<string, Hueco[]> {
    const m = new Map<string, Hueco[]>();
    for (const h of huecos) {
      const k = claveDia(h.ms);
      if (!m.has(k)) m.set(k, []);
      m.get(k)!.push(h);
    }
    return m;
  }

  function boton(clase: string, pulsado: boolean): HTMLButtonElement {
    const b = document.createElement("button");
    b.type = "button";
    b.className = clase;
    b.setAttribute("aria-pressed", String(pulsado));
    return b;
  }

  function pintarDias() {
    if (!dias) return;
    const grupos = porDia();
    if (!grupos.has(diaActual)) diaActual = grupos.keys().next().value ?? "";
    if (sinHoras) sinHoras.hidden = grupos.size > 0;
    dias.replaceChildren(
      ...[...grupos].map(([k, lista]) => {
        const ms = lista[0].ms;
        const b = boton("ap-dia", k === diaActual);
        const semana = document.createElement("span");
        semana.className = "ap-dia-semana";
        semana.textContent = fmt({ weekday: "short" }).format(ms).replace(".", "");
        const numero = document.createElement("span");
        numero.className = "ap-dia-numero";
        numero.textContent = fmt({ day: "numeric" }).format(ms);
        const mes = document.createElement("span");
        mes.className = "ap-dia-mes";
        mes.textContent = fmt({ month: "short" }).format(ms).replace(".", "");
        b.append(semana, numero, mes);
        b.setAttribute("aria-label", `${diaLargo(ms)}, ${lista.length} horas libres`);
        b.addEventListener("click", () => {
          diaActual = k;
          pintarDias();
          pintarHoras();
        });
        return b;
      }),
    );
    dias.querySelector<HTMLElement>('[aria-pressed="true"]')?.scrollIntoView({ block: "nearest", inline: "nearest" });
  }

  function pintarHoras() {
    if (!horas) return;
    const lista = porDia().get(diaActual) ?? [];
    if (diaElegido) {
      diaElegido.textContent = lista.length ? `${diaLargo(lista[0].ms)}. Toca la hora que prefieras.` : "";
    }
    horas.replaceChildren(
      ...lista.map((h) => {
        const b = boton("ap-hora", elegido?.iso === h.iso);
        const principal = document.createElement("span");
        principal.className = "ap-hora-local";
        principal.textContent = hora(h.ms);
        b.append(principal);
        if (difiereDeMadrid(h.ms)) {
          const madrid = document.createElement("span");
          madrid.className = "ap-hora-madrid";
          madrid.textContent = `${horaMadrid(h.ms)} Madrid`;
          b.append(madrid);
          b.setAttribute("aria-label", `${hora(h.ms)} en tu zona, ${horaMadrid(h.ms)} en Madrid`);
        }
        b.addEventListener("click", () => elegir(h));
        return b;
      }),
    );
  }

  function textoCita(ms: number): string {
    const fin = ms + duracion * 60_000;
    return `${diaLargo(ms)}, de ${hora(ms)} a ${hora(fin)} · ${nombreZona(zona)}`;
  }

  /** Solo si tu hora no es la de Madrid: la misma cita, vista desde Madrid. */
  function textoMadrid(ms: number): string {
    if (!difiereDeMadrid(ms) && !difiereDeMadrid(ms + duracion * 60_000)) return "";
    const fin = ms + duracion * 60_000;
    const dia = mayuscula(fmtEn(zonaMadrid, { weekday: "long", day: "numeric", month: "long" }).format(ms));
    return `En Madrid, España: ${dia}, de ${horaEn(zonaMadrid, ms)} a ${horaEn(zonaMadrid, fin)}`;
  }

  function elegir(h: Hueco) {
    elegido = h;
    pintarHoras();
    if (!empezado) {
      empezado = true;
      w.dataLayer?.push({ event: "form_start", form_id: formId, page_path: location.pathname });
    }
    if (resumen) resumen.textContent = textoCita(h.ms);
    if (resumenMadrid) {
      const m = textoMadrid(h.ms);
      resumenMadrid.textContent = m;
      resumenMadrid.hidden = !m;
    }
    if (eleccion) eleccion.hidden = true;
    pasoActual(2);
    if (form) {
      form.hidden = false;
      form.querySelector<HTMLInputElement>('[name="nombre"]')?.focus({ preventScroll: true });
      form.scrollIntoView({ block: "nearest" });
    }
  }

  function volver() {
    if (form) form.hidden = true;
    if (eleccion) eleccion.hidden = false;
    pasoActual(1);
    mostrarError("");
    pintarAvisoZona();
    pintarDias();
    pintarHoras();
    horas?.querySelector<HTMLElement>('[aria-pressed="true"]')?.focus();
  }

  function mostrarError(texto: string) {
    if (!error) return;
    error.textContent = texto;
    error.hidden = !texto;
  }

  function aRespaldo() {
    if (!raiz) return;
    raiz.dataset.estado = "respaldo";
  }

  // De dónde llega la visita (funnel y campaña), para anotarlo en la cita.
  // Se lee de la dirección al reservar y no se guarda en el navegador: así no
  // hace falta pedir permiso de cookies para esto.
  function origenVisita(): string {
    const p = new URLSearchParams(location.search);
    const partes = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"]
      .filter((k) => p.get(k))
      .map((k) => `${k.replace("utm_", "")}=${p.get(k)!.slice(0, 60)}`);
    if (p.has("gclid")) partes.push("clic de Google Ads");
    if (p.has("fbclid")) partes.push("clic de Meta");
    return [formId, ...partes].join(" · ").slice(0, 300);
  }

  // ----------------------------------------------------- Conexión con /api

  async function simulacion(): Promise<{ huecos: string[] }> {
    // Solo en la vista previa (npm run dev), donde no corre el servidor de
    // Cloudflare: huecos de ejemplo con el horario real de src/data/agenda.ts.
    const [{ calcularHuecos }, { AGENDA }] = await Promise.all([
      import("../worker/agenda-huecos"),
      import("../data/agenda"),
    ]);
    const ahora = Date.now();
    const ocupado = { inicio: ahora + 26 * 3_600_000, fin: ahora + 28 * 3_600_000 };
    return { huecos: calcularHuecos(AGENDA, ahora, [ocupado]).map((t) => new Date(t).toISOString()) };
  }

  async function pedirHuecos(): Promise<boolean> {
    try {
      const r = await fetch("/api/agenda", { headers: { Accept: "application/json" } });
      if (r.ok) {
        const d = (await r.json()) as { huecos?: string[]; duracion?: number };
        if (d.duracion) duracion = d.duracion;
        cargarHuecos(d.huecos ?? []);
        return true;
      }
      if (import.meta.env.DEV && r.status === 404) {
        cargarHuecos((await simulacion()).huecos);
        return true;
      }
    } catch {
      /* sin red o servidor caído: WhatsApp y correo */
    }
    return false;
  }

  function cargarHuecos(lista: string[]) {
    huecos = lista.map((iso) => ({ iso, ms: Date.parse(iso) })).filter((h) => Number.isFinite(h.ms));
    raiz?.querySelectorAll("[data-ap-duracion]").forEach((e) => (e.textContent = String(duracion)));
  }

  async function reservar(datos: Record<string, unknown>): Promise<{ estado: number; meet?: string | null }> {
    if (import.meta.env.DEV) {
      const r = await fetch("/api/agenda", { method: "POST", body: "{}" }).catch(() => null);
      if (!r || r.status === 404) {
        await new Promise((ok) => setTimeout(ok, 700));
        return { estado: 200, meet: null };
      }
    }
    const r = await fetch("/api/agenda", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(datos),
    });
    const d = (await r.json().catch(() => ({}))) as { meet?: string | null };
    return { estado: r.status, meet: d.meet };
  }

  const valor = (campos: FormData, nombre: string) => String(campos.get(nombre) ?? "").trim();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!elegido || !enviar) return;
    const campos = new FormData(form);
    const nombre = valor(campos, "nombre");
    const correo = valor(campos, "correo");
    const acepto = form.querySelector<HTMLInputElement>('[name="acepto"]');
    form.querySelectorAll("[aria-invalid]").forEach((i) => i.removeAttribute("aria-invalid"));
    if (!form.checkValidity() || nombre.length < 2) {
      const malo = form.querySelector<HTMLInputElement>("input:invalid") ?? form.querySelector<HTMLInputElement>('[name="nombre"]');
      malo?.setAttribute("aria-invalid", "true");
      malo?.focus();
      mostrarError(
        malo?.name === "correo"
          ? "Revisa tu correo: ahí te llega la invitación."
          : malo?.name === "acepto"
            ? "Marca la casilla de privacidad para que pueda guardar tus datos y agendar la llamada."
            : "Escribe tu nombre para agendar la llamada.",
      );
      return;
    }

    mostrarError("");
    enviar.disabled = true;
    if (enviarTexto) enviarTexto.textContent = "Agendando…";
    try {
      const r = await reservar({
        inicio: elegido.iso,
        nombre,
        correo,
        telefono: valor(campos, "telefono"),
        empresa: valor(campos, "empresa"),
        sitioWeb: valor(campos, "sitioWeb"),
        sector: valor(campos, "sector"),
        equipo: valor(campos, "equipo"),
        servicio: valor(campos, "servicio"),
        mensaje: valor(campos, "mensaje"),
        acepto: Boolean(acepto?.checked),
        web: valor(campos, "web"),
        zona,
        origen: origenVisita(),
      });
      if (r.estado === 200) {
        w.dataLayer?.push({ event: "generate_lead", form_id: formId, method: "agenda-propia", page_path: location.pathname });
        const cuando = $("[data-ap-exito-cuando]");
        const madrid = $("[data-ap-exito-madrid]");
        const texto = $("[data-ap-exito-texto]");
        if (cuando) cuando.textContent = textoCita(elegido.ms);
        if (madrid) {
          const m = textoMadrid(elegido.ms);
          madrid.textContent = m;
          madrid.hidden = !m;
        }
        if (texto) {
          texto.textContent = `Te envié la invitación de Google Calendar a ${correo}, con el enlace de Google Meet. Si no la ves en unos minutos, revisa la carpeta de spam o de promociones.`;
        }
        form.hidden = true;
        pasoActual(3);
        if (exito) {
          exito.hidden = false;
          exito.focus({ preventScroll: true });
          exito.scrollIntoView({ block: "nearest" });
        }
        return;
      }
      if (r.estado === 409) {
        await pedirHuecos();
        elegido = null;
        volver();
        mostrarError("");
        if (sinHoras && !sinHoras.hidden) return;
        if (diaElegido) diaElegido.textContent = `Esa hora se acaba de ocupar. Elige otra. ${diaElegido.textContent}`;
        return;
      }
      if (r.estado === 429) {
        mostrarError("Hubo demasiados intentos seguidos. Espera un minuto y vuelve a confirmar.");
        return;
      }
      if (r.estado === 400) {
        mostrarError("Revisa tus datos: alguno no se pudo leer bien.");
        return;
      }
      mostrarError("No pude confirmar la llamada. Inténtalo de nuevo en un momento o escríbeme por WhatsApp.");
    } catch {
      mostrarError("No hay conexión. Revisa tu internet y vuelve a confirmar.");
    } finally {
      enviar.disabled = false;
      if (enviarTexto) enviarTexto.textContent = "Confirmar la llamada";
    }
  });

  $("[data-ap-cambiar]")?.addEventListener("click", volver);
  zonaSelect?.addEventListener("change", () => {
    zona = zonaSelect.value;
    diaActual = "";
    pintarAvisoZona();
    pintarDias();
    pintarHoras();
  });

  // Los botones «Elegir día y hora» de la página llevan a la agenda.
  document.querySelectorAll("[data-abrir-agenda]").forEach((a) =>
    a.addEventListener("click", () => {
      if (raiz?.dataset.estado === "activa") dias?.querySelector<HTMLElement>('[aria-pressed="true"]')?.focus({ preventScroll: true });
    }),
  );

  (async () => {
    if (!raiz) return;
    if (!(await pedirHuecos())) return aRespaldo();
    pintarZonas();
    pintarAvisoZona();
    pintarDias();
    pintarHoras();
    raiz.dataset.estado = "activa";
  })();
</script>

