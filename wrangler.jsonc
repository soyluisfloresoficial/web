{
  // Configuración del Worker que sirve la web (Cloudflare Workers Builds).
  // El nombre TIENE que coincidir con el del Worker en Cloudflare: «web».
  "name": "web",
  "compatibility_date": "2026-10-20",
  // Código del Worker (27/10/2026): solo atiende /api/* (el asistente de IA).
  // El resto de la web son archivos estáticos que Cloudflare sirve sin pasar
  // por aquí. Ver AGENTE.md.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Para que el Worker pueda leer /agente/conocimiento.txt y devolver
    // los archivos de la web en cualquier otra ruta.
    "binding": "ASSETS",
    // Solo /api/* ejecuta el Worker antes de buscar un archivo.
    "run_worker_first": ["/api/*"],
    // La web usa URL sin barra final (/servicios), igual que el canonical y
    // el sitemap. Por defecto, Cloudflare redirigía /servicios a /servicios/.
    "html_handling": "drop-trailing-slash",
    // Las URL que no existen devuelven la página 404 de la web, con código 404.
    "not_found_handling": "404-page"
  },
  // Límite del chat: 8 mensajes por minuto por IP en cada ubicación de
  // Cloudflare. Es aproximado; el tope de gasto real se pone en la consola de
  // Anthropic (AGENTE.md).
  "ratelimits": [
    {
      "name": "LIMITE_CHAT",
      "namespace_id": "2710",
      "simple": { "limit": 8, "period": 60 }
    },
    // Agenda propia (AGENDA.md): consultas de horas y reservas, 10 por
    // minuto por IP. Cada tipo cuenta por separado.
    {
      "name": "LIMITE_AGENDA",
      "namespace_id": "2711",
      "simple": { "limit": 10, "period": 60 }
    },
    // Voz de Flora (src/worker/voz.ts): 40 peticiones por minuto por IP. Desde el
    // 06/11/2026 cada respuesta se pide por frases (2 a 4 peticiones) y el chat
    // ya limita a 8 mensajes por minuto.
    {
      "name": "LIMITE_VOZ",
      "namespace_id": "2712",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  // Workers AI: la voz de Flora (Deepgram Aura-2 en español). Se cobra en la
  // cuenta de Cloudflare, sin claves aparte.
  "ai": { "binding": "AI" },
  // Horario de la agenda que se edita desde el panel (AGENDA.md). Manda
  // sobre los valores de src/data/agenda.ts.
  "kv_namespaces": [
    { "binding": "AGENDA_CONFIG", "id": "3daee978984e4ad4a73d76d1e4e8d4fb" },
    // Lista de correo de la guía gratis (EMAIL-MARKETING.md).
    { "binding": "SUSCRIPTORES", "id": "d8b54a898c4d4986920bf82df71ecb08" }
  ],
  // Modelo del asistente. Va aquí y no en el panel porque cada publicación
  // reescribe las variables normales del panel con las de este archivo.
  // Haiku 5.5 (2/11/2026, plan de ahorro): 0,10 $ / 0,50 $ por millón de
  // tokens, veinte veces menos que Sonnet 5.5. Si algún día hace falta más
  // calidad: "claude-sonnet-5-5" (ver AGENTE.md).
  "vars": {
    "MODELO_CHAT": "claude-haiku-5-5",
    // Tope de mensajes con IA al día en toda la web. Al llegar, el chat sigue
    // con las preguntas frecuentes, sin IA, hasta el día siguiente (UTC).
    "LIMITE_DIARIO_CHAT": "300",
    // Voz de Flora: celeste (latina), elegida el 08/11/2026 tras escuchar las cinco
    // femeninas. Antes, selena.
    // Otras: selena (latina), estrella (mexicana, madura), diana y
    // carina (de España). Se cambia con esta variable.
    "VOZ_FLORA": "celeste"
  },
  // Cada 10 minutos el Worker revisa las citas y manda los recordatorios de
  // la agenda por correo (AGENDA.md) y los correos de la secuencia de la guía
  // (EMAIL-MARKETING.md).
  "triggers": { "crons": ["*/10 * * * *"] },
  // Registros del Worker (solo tokens y errores, nunca las conversaciones).
  "observability": { "enabled": true }
  // La clave ANTHROPIC_API_KEY NO va aquí: es un secreto del Worker en el
  // panel de Cloudflare (Configuración → Variables y secretos). Lo mismo las
  // tres claves de Google de la agenda (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // y GOOGLE_REFRESH_TOKEN, ver AGENDA.md), y la de los correos, RESEND_API_KEY.
}
