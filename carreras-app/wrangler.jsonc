{
  "name": "carreras",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "carreras", "database_id": "COMPLETAR-con-wrangler-d1-create", "migrations_dir": "migrations" }
  ],
  "vars": { "EMAIL_FROM": "Carreras <avisos@COMPLETAR-tu-dominio.es>", "WHATSAPP_TEMPLATE": "aviso_carreras" }
}
